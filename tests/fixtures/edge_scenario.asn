(:edgeScenarios :v 1 :src ADR-0081
  :scenarios [
    (:scenario :id "uncoveredStep"
      :condition "No plan step in ledger matches current reality"
      :containment "Preserve optionality and do not execute speculative mutation"
      :action ":escalate")
    (:scenario :id "unauthorizedMutation"
      :condition "Target file or buffer is outside owned paths"
      :containment "Abort write operation immediately and revert uncommitted buffers"
      :action ":escalate")
    (:scenario :id "cheapRefutation"
      :condition "Cheapest check available to prove hypothesis wrong"
      :probe "Run minimal syntax check or symbol query before generating code"
      :action ":refute")
    (:scenario :id "escalationReceipt"
      :seen "Uncovered dependency or invariant collision"
      :tried "Cheapest refutation probe"
      :fork "Branch A: update plan; Branch B: revert change"
      :resolves "Principal decision recorded in session ledger"
      :marksCompleted false)
  ]
)
