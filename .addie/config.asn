(:addieConfig
  :model "gemma-4-31b-it"
  :pipeline "full"
  :environment "modal"
  :entropyThreshold :auto
  :airgap true
  :aslFirst true
  :scoutPolyglot true
  :stages [
    (:stage :name :scout :timeoutSec 30)
    (:stage :name :planAndGapAudit :timeoutSec 45)
    (:stage :name :implement :timeoutSec 90)
    (:stage :name :testAndVerify :timeoutSec 60)
  ]
  :telemetrySink "harness/results/terminal-bench-4")
