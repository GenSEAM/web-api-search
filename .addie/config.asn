;; .addie/config.asn: Hierarchical Declarative Configuration for Addie Cognitive Harness
(:addie-config
  :model "gemma-4-31b-it"
  :pipeline "full"                     ;; "full" | "adaptive" | "standard" | "fast"
  :environment "modal"                 ;; "modal" | "local" | "docker"
  :entropy-threshold :auto             ;; Automatically route tasks by complexity
  :airgap true                         ;; Block all outbound web search and external internet egress
  :asl-first true                      ;; Use compact ASN tool calls and telemetry
  :scout-polyglot true                 ;; Inspect full polyglot toolchain (python, node, gcc, rust)
  :stages [
    (:stage :name :scout :timeout-sec 30)
    (:stage :name :plan-and-gap-audit :timeout-sec 45)
    (:stage :name :implement :timeout-sec 90)
    (:stage :name :test-and-verify :timeout-sec 60)
  ]
  :telemetry-sink "harness/results/terminal-bench-4")
