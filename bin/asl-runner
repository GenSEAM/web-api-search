#!/usr/bin/env bash
# bin/asl-runner: In-Container Sovereign Agent & Cognitive Gateway Orchestrator
# Automatically ensures L7 Cognitive Gateway is healthy and routes all LLM inference through http://127.0.0.1:8765/v1
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

PORT="${ASL_GATEWAY_PORT:-8765}"
GATEWAY_URL="http://127.0.0.1:${PORT}"

# Export environment variables for the agent and external benchmark harnesses
export OPENAI_BASE_URL="${GATEWAY_URL}/v1"
export NO_PROXY="127.0.0.1,localhost,${NO_PROXY:-}"
export no_proxy="127.0.0.1,localhost,${no_proxy:-}"

# Ensure gateway daemon is active
if ! "${SCRIPT_DIR}/asl-gateway" status >/dev/null 2>&1; then
  echo "--> Starting in-container ASL Cognitive Gateway daemon..."
  "${SCRIPT_DIR}/asl-gateway" start --port "$PORT"
fi

# Wait up to 5 seconds for health endpoint
READY=0
for _ in {1..50}; do
  if curl --noproxy "*" -s "${GATEWAY_URL}/health" >/dev/null 2>&1; then
    READY=1
    break
  fi
  sleep 0.1
done

if [ "$READY" -ne 1 ]; then
  echo "✗ Error: ASL Cognitive Gateway failed to respond on ${GATEWAY_URL}/health" >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  echo "================================================================================"
  echo "  ASL In-Container Cognitive Gateway & Agent Environment Online"
  echo "================================================================================"
  echo "  Gateway Endpoint: ${GATEWAY_URL}/v1"
  echo "  Health Status:    $(curl --noproxy "*" -s "${GATEWAY_URL}/health")"
  echo ""
  echo "  Usage:"
  echo "    bin/asl-runner bin/agent -p \"Your instruction\""
  echo "    bin/asl-runner bin/gsa -m gemma-4-31b-it"
  echo "    bin/asl-runner harbor run -d terminal-bench/terminal-bench@4.0.0 --environment modal"
  echo "================================================================================"
  exit 0
fi

# Execute passed directive under gateway routing
exec "$@"
