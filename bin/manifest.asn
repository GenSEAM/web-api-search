(:manifest
  :name "bin"
  :version "0.1.0"
  :d "Declarative registry of approved host projection executables."
  (:executables
    ((:name "asl" :role "Sovereign Single-Binary Toolchain, Evaluator & Evolver" :target "asl/bin/asl" :runtime "native")
     (:name "asl-engine" :role "Sovereign Single-Binary Resident Engine Alias" :target "asl/bin/asl-engine" :runtime "native")
     (:name "agent" :role "Autonomous Terminal Coding Agent CLI" :target "agent/src/tui.asl" :runtime "bash-proxy")
     (:name "gsa" :role "Autonomous Agent CLI (Alias)" :target "agent/src/cli.asl" :runtime "bash-proxy")
     (:name "lens" :role "External Agent Steering Accelerator" :target "tools/lens/src/lens.asl" :runtime "bash-proxy")
     (:name "asl-gateway" :role "Universal L7 Cognitive Gateway & Hallucination Interception Proxy" :target "bin/asl-gateway" :runtime "bash-proxy")
     (:name "asl-runner" :role "In-Container Sovereign Agent & Gateway Orchestrator" :target "bin/asl-runner" :runtime "bash-proxy"))))
