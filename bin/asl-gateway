#!/usr/bin/env bash
# bin/asl-gateway: Universal Deterministic L7 Cognitive Gateway & Hallucination Interception Proxy
# Implements pure tri-channel demuxing, CoT quarantine, verbal ESH ban, upstream provider cascading, and LCS grounding.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

PORT="${ASL_GATEWAY_PORT:-8765}"
HOST="127.0.0.1"

CMD="${1:-status}"
shift || true

EXTRA_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --port|-p)
      PORT="$2"
      shift 2
      ;;
    *)
      EXTRA_ARGS+=("$1")
      shift
      ;;
  esac
done

PID_DIR="${ASL_GATEWAY_PID_DIR:-/tmp/asl_gateway}"
mkdir -p "$PID_DIR" 2>/dev/null || true
PID_FILE="${PID_DIR}/asl_gateway_${PORT}.pid"
LOG_FILE="${PID_DIR}/asl_gateway_${PORT}.log"

SERVER_SCRIPT='
import http from "node:http";
import fs from "node:fs";

const PORT = parseInt(process.env.PORT || "8765", 10);
const HOST = process.env.HOST || "127.0.0.1";
const PID_FILE = process.env.PID_FILE;

const state = {
  startedAt: Date.now(),
  totalRequests: 0,
  quarantinedThinkBlocks: 0,
  quarantinedThinkTokens: 0,
  eshViolationsIntercepted: 0,
  toolCallsExtracted: 0,
  lastTurn: null,
};

const ESH_PATTERNS = [
  "i have run the tests and they pass",
  "all tests pass",
  "all tests passed",
  "tests are passing",
  "i ran the tests and verified",
  "everything is verified and passing",
  "build succeeded cleanly",
  "test suite passing cleanly",
  "all 5 tests pass",
  "verified all tests pass",
  "gate passes cleanly",
  "all assertions verified",
];

function detectEshViolation(text) {
  const lower = (text || "").toLowerCase();
  for (const pat of ESH_PATTERNS) {
    if (lower.includes(pat)) return true;
  }
  return false;
}

function demuxContent(raw) {
  let thinkContent = "";
  let remaining = raw || "";

  const openIdx = remaining.indexOf("<think>");
  if (openIdx !== -1) {
    const closeIdx = remaining.indexOf("</think>", openIdx);
    if (closeIdx !== -1) {
      thinkContent = remaining.slice(openIdx + 7, closeIdx).trim();
      remaining = (remaining.slice(0, openIdx) + " " + remaining.slice(closeIdx + 8)).trim();
    } else {
      thinkContent = remaining.slice(openIdx + 7).trim();
      remaining = remaining.slice(0, openIdx).trim();
    }
  }

  const lines = remaining.split("\n");
  const toolCalls = [];
  const uiLines = [];

  for (const line of lines) {
    const trimmed = line.trim();
    if (trimmed.startsWith("(call :tool") || trimmed.startsWith("(:tool-call") || trimmed.startsWith("(tool-call")) {
      toolCalls.push(trimmed);
    } else {
      uiLines.push(line);
    }
  }

  const uiContent = uiLines.join("\n").trim();
  return { thinkContent, toolCalls, uiContent };
}

function parseStructuredTool(tcStr, id) {
  const match = tcStr.match(/\(+:?call\s+:tool\s+["\x27]?([a-zA-Z0-9_-]+)["\x27]?(?:\s+(.*))?\)+/);
  if (match) {
    const name = match[1];
    let argsRaw = (match[2] || "").trim();
    let parsedArgs = { raw_args: argsRaw };
    if (argsRaw.startsWith(":args ")) {
      const argsContent = argsRaw.slice(6).trim();
      try {
        parsedArgs = JSON.parse(argsContent);
      } catch (e) {
        parsedArgs = { raw_args: argsContent };
      }
    }
    return {
      id: "call_asl_" + id,
      type: "function",
      function: {
        name: name,
        arguments: typeof parsedArgs === "string" ? parsedArgs : JSON.stringify(parsedArgs),
      },
    };
  }
  return {
    id: "call_asl_" + id,
    type: "function",
    function: {
      name: "tool",
      arguments: JSON.stringify({ raw: tcStr }),
    },
  };
}

function staticFormatToAsn(format, text) {
  const fmt = (format || "").toLowerCase().trim();
  if (fmt === "json") {
    try {
      const parsed = JSON.parse(text);
      return jsonToAsn(parsed);
    } catch (e) {
      return `(:error :reason "Invalid JSON: ${e.message}")`;
    }
  }
  if (fmt === "csv") {
    const lines = (text || "").trim().split("\n").filter(l => l.trim().length > 0);
    if (lines.length === 0) return "[]";
    const header = lines[0].split(",").map(h => h.trim().replace(/^["\x27]|["\x27]$/g, ""));
    const records = [];
    for (let i = 1; i < lines.length; i++) {
      const cols = lines[i].split(",").map(c => c.trim().replace(/^["\x27]|["\x27]$/g, ""));
      let rec = "(:record";
      for (let j = 0; j < header.length; j++) {
        const key = header[j] || `col_${j}`;
        const val = cols[j] !== undefined ? JSON.stringify(cols[j]) : "nil";
        rec += ` :${key} ${val}`;
      }
      rec += ")";
      records.push(rec);
    }
    return "[" + records.join(" ") + "]";
  }
  if (fmt === "yaml" || fmt === "yml") {
    const lines = (text || "").split("\n");
    let out = "(:map";
    for (const l of lines) {
      const trimmed = l.trim();
      if (!trimmed || trimmed.startsWith("#")) continue;
      const colonIdx = trimmed.indexOf(":");
      if (colonIdx > 0) {
        const k = trimmed.slice(0, colonIdx).trim().replace(/[^a-zA-Z0-9_-]/g, "");
        let v = trimmed.slice(colonIdx + 1).trim();
        if (v === "true" || v === "false" || v === "null" || (!isNaN(v) && v !== "")) {
          out += ` :${k} ${v === "null" ? "nil" : v}`;
        } else {
          v = v.replace(/^["\x27]|["\x27]$/g, "");
          out += ` :${k} ${JSON.stringify(v)}`;
        }
      }
    }
    out += ")";
    return out;
  }
  return JSON.stringify(text || "");
}


function jsonToAsn(val, indent = 0) {
  const pad = " ".repeat(indent);
  if (val === null || val === undefined) return "nil";
  if (typeof val === "boolean") return val ? "true" : "false";
  if (typeof val === "number") return String(val);
  if (typeof val === "string") return JSON.stringify(val);
  if (Array.isArray(val)) {
    if (val.length === 0) return "[]";
    const items = val.map(v => jsonToAsn(v, indent + 2)).join(" ");
    return "[" + items + "]";
  }
  if (typeof val === "object") {
    const keys = Object.keys(val);
    if (keys.length === 0) return "(:map)";
    let out = "(:map";
    for (const k of keys) {
      out += ` :${k} ${jsonToAsn(val[k], indent + 2)}`;
    }
    out += ")";
    return out;
  }
  return String(val);
}

function toolCallToAsn(tc) {
  const name = (tc.function && tc.function.name) || tc.name || "tool";
  let args = "()";
  try {
    const parsed = typeof tc.function.arguments === "string" ? JSON.parse(tc.function.arguments) : tc.function.arguments;
    args = jsonToAsn(parsed);
  } catch (e) {
    args = JSON.stringify(tc.function.arguments || "");
  }
  return `(:call :tool "${name}" :id "${tc.id || "tc"}" :args ${args})`;
}

function resolveUpstream(headers, payload) {
  const customUrl = headers["x-asl-upstream-url"] || process.env.UPSTREAM_BASE_URL;
  const customKey = headers["x-asl-upstream-key"] || process.env.UPSTREAM_API_KEY;
  const authHeader = headers["authorization"];
  const bearerToken = (authHeader && authHeader.startsWith("Bearer ")) ? authHeader.slice(7).trim() : null;

  if (process.env.ASL_AIRGAP === "1") {
    return { mode: "airgap", url: null, key: null, provider: "local-airgap" };
  }

  if (customUrl && customUrl.trim().length > 0) {
    return { mode: "proxy", url: customUrl.replace(/\/+$/, ""), key: customKey || bearerToken || "", provider: "custom" };
  }

  // Local Model Endpoints (Ollama, llama.cpp, vLLM, LocalAI, Apple Silicon MLX)
  if (process.env.OLLAMA_BASE_URL || process.env.OLLAMA_HOST) {
    const oUrl = (process.env.OLLAMA_BASE_URL || process.env.OLLAMA_HOST || "http://127.0.0.1:11434/v1").replace(/\/+$/, "");
    return { mode: "proxy", url: oUrl.endsWith("/v1") ? oUrl : oUrl + "/v1", key: customKey || "ollama", provider: "ollama" };
  }
  if (process.env.LLAMACPP_BASE_URL) {
    const lUrl = process.env.LLAMACPP_BASE_URL.replace(/\/+$/, "");
    return { mode: "proxy", url: lUrl.endsWith("/v1") ? lUrl : lUrl + "/v1", key: customKey || "llamacpp", provider: "llamacpp" };
  }
  if (process.env.VLLM_BASE_URL) {
    const vUrl = process.env.VLLM_BASE_URL.replace(/\/+$/, "");
    return { mode: "proxy", url: vUrl.endsWith("/v1") ? vUrl : vUrl + "/v1", key: customKey || "vllm", provider: "vllm" };
  }
  if (process.env.LOCAL_LLM_URL || process.env.LOCALAI_BASE_URL) {
    const locUrl = (process.env.LOCAL_LLM_URL || process.env.LOCALAI_BASE_URL).replace(/\/+$/, "");
    return { mode: "proxy", url: locUrl.endsWith("/v1") ? locUrl : locUrl + "/v1", key: customKey || "local", provider: "local-llm" };
  }
  if (process.env.OPENROUTER_API_KEY && process.env.OPENROUTER_API_KEY.trim().length > 5 && !process.env.OPENROUTER_API_KEY.startsWith("dummy")) {
    return { mode: "proxy", url: (process.env.OPENROUTER_BASE_URL || "https://openrouter.ai/api/v1").replace(/\/+$/, ""), key: process.env.OPENROUTER_API_KEY.trim(), provider: "openrouter" };
  }
  if ((process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY.trim().length > 5) || (process.env.GOOGLE_API_KEY && process.env.GOOGLE_API_KEY.trim().length > 5)) {
    const key = (process.env.GEMINI_API_KEY || process.env.GOOGLE_API_KEY).trim();
    const url = (process.env.GOOGLE_GEMINI_BASE_URL || "https://generativelanguage.googleapis.com/v1beta/openai").replace(/\/+$/, "");
    return { mode: "proxy", url: url, key: key, provider: "gemini" };
  }
  if (process.env.OPENAI_API_KEY && process.env.OPENAI_API_KEY.trim().length > 5 && !process.env.OPENAI_API_KEY.startsWith("dummy")) {
    const url = (process.env.OPENAI_BASE_URL || "https://api.openai.com/v1").replace(/\/+$/, "");
    return { mode: "proxy", url: url, key: process.env.OPENAI_API_KEY.trim(), provider: "openai" };
  }
  if (process.env.ANTHROPIC_API_KEY && process.env.ANTHROPIC_API_KEY.trim().length > 5 && !process.env.ANTHROPIC_API_KEY.startsWith("dummy")) {
    const url = (process.env.ANTHROPIC_BASE_URL || "https://api.anthropic.com/v1").replace(/\/+$/, "");
    return { mode: "proxy", url: url, key: process.env.ANTHROPIC_API_KEY.trim(), provider: "anthropic" };
  }
  if (bearerToken && bearerToken.length > 8 && !bearerToken.startsWith("dummy") && !bearerToken.startsWith("local")) {
    return { mode: "proxy", url: "https://openrouter.ai/api/v1", key: bearerToken, provider: "bearer-openrouter" };
  }

  return { mode: "unconfigured", url: null, key: null, provider: "unconfigured", error: "No upstream LLM provider credentials configured. Set OPENAI_API_KEY, ANTHROPIC_API_KEY, or pass X-ASL-Upstream-Key/Url headers." };
}

const server = http.createServer(async (req, res) => {
  const corsHeaders = {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS, PUT, DELETE",
    "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With, X-ASL-Wire-Protocol, X-ASL-Upstream-Url, X-ASL-Upstream-Key",
  };

  if (req.method === "OPTIONS") {
    res.writeHead(204, corsHeaders);
    res.end();
    return;
  }

  const url = new URL(req.url, "http://" + HOST + ":" + PORT);
  const upstream = resolveUpstream(req.headers, {});

  if (req.method === "GET" && (url.pathname === "/health" || url.pathname === "/")) {
    res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
    res.end(JSON.stringify({
      status: "active",
      service: "asl-cognitive-gateway",
      version: "1.0.0",
      host: HOST,
      port: PORT,
      provider: upstream.provider,
      upstream_mode: upstream.mode,
      upstream_url: upstream.url ? upstream.url.replace(/:\/\/.*@/, "://") : null,
      active_model: process.env.ASL_GATEWAY_MODEL || "gemma-4-31b-it",
      l7_filters: {
        cot_quarantine: true,
        verbal_esh_interception: true,
        structured_tools_channel: true,
        token_budget_tracking: true,
        none_type_sanitization: true,
      },
      uptime_sec: Math.floor((Date.now() - state.startedAt) / 1000),
    }));
    return;
  }

  if (req.method === "GET" && url.pathname === "/metrics") {
    res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
    res.end(JSON.stringify({
      total_requests: state.totalRequests,
      quarantined_think_blocks: state.quarantinedThinkBlocks,
      quarantined_think_tokens: state.quarantinedThinkTokens,
      esh_violations_intercepted: state.eshViolationsIntercepted,
      tool_calls_extracted: state.toolCallsExtracted,
      provider: upstream.provider,
      uptime_sec: Math.floor((Date.now() - state.startedAt) / 1000),
    }));
    return;
  }

  if (req.method === "POST" && (url.pathname === "/v1/chat/completions" || url.pathname === "/chat/completions")) {
    let body = "";
    req.on("data", chunk => { body += chunk; });
    req.on("end", async () => {
      state.totalRequests++;
      let payload = {};
      try {
        payload = JSON.parse(body || "{}");
      } catch (e) {
        res.writeHead(400, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: { message: "Invalid JSON body" } }));
        return;
      }

      const reqUpstream = resolveUpstream(req.headers, payload);
      const model = payload.model || process.env.ASL_GATEWAY_MODEL || "gemma-4-31b-it";
      const messages = payload.messages || [];
      const hasVerifiedExec = Boolean(payload.has_verified_execution);

      if (reqUpstream.mode === "proxy") {
        try {
          const upstreamUrl = reqUpstream.url + "/chat/completions";
          const fwdHeaders = { "Content-Type": "application/json" };
          if (reqUpstream.key) {
            fwdHeaders["Authorization"] = "Bearer " + reqUpstream.key;
          }
          const fwdBody = {
            model: model,
            messages: messages,
            temperature: payload.temperature !== undefined ? payload.temperature : 0.2,
            max_tokens: payload.max_tokens || 4096,
            stream: false,
          };
          if (payload.tools) fwdBody.tools = payload.tools;
          if (payload.tool_choice) fwdBody.tool_choice = payload.tool_choice;
          if (payload.response_format) fwdBody.response_format = payload.response_format;

          const upstreamResp = await fetch(upstreamUrl, {
            method: "POST",
            headers: fwdHeaders,
            body: JSON.stringify(fwdBody),
          });

          if (!upstreamResp.ok) {
            const errTxt = await upstreamResp.text();
            res.writeHead(upstreamResp.status, { ...corsHeaders, "Content-Type": "application/json" });
            res.end(errTxt);
            return;
          }

          const upJson = await upstreamResp.json();
          const choice = (upJson.choices && upJson.choices[0]) || { message: { role: "assistant", content: "" } };
          const rawText = choice.message.content || "";
          const existingThink = choice.message.reasoning_content || choice.message.reasoning || "";

          const demux = demuxContent(rawText);
          const thinkTokens = demux.thinkContent ? Math.ceil(demux.thinkContent.length / 4) : 0;
          const isEsh = detectEshViolation(demux.uiContent) && !hasVerifiedExec;

          if (demux.thinkContent) {
            state.quarantinedThinkBlocks++;
            state.quarantinedThinkTokens += thinkTokens;
          }
          if (isEsh) {
            state.eshViolationsIntercepted++;
          }

          let toolObjs = choice.message.tool_calls || [];
          if (demux.toolCalls.length > 0) {
            const parsedAsl = demux.toolCalls.map((tc, idx) => parseStructuredTool(tc, toolObjs.length + idx + 1));
            toolObjs = toolObjs.concat(parsedAsl);
            state.toolCallsExtracted += demux.toolCalls.length;
          }

          const finalContent = isEsh
            ? "Action blocked by L7 Cognitive Gateway: verbal claim of test passage without verified execution receipt (ESH violation)."
            : (demux.uiContent || "");

          const finalReasoning = demux.thinkContent || existingThink || null;
          const finishReason = isEsh ? "esh_violation" : (choice.finish_reason || (toolObjs.length > 0 ? "tool_calls" : "stop"));

          const outPayload = {
            id: upJson.id || ("chatcmpl-asl-gw-" + Date.now()),
            object: "chat.completion",
            created: upJson.created || Math.floor(Date.now() / 1000),
            model: upJson.model || model,
            choices: [
              {
                index: 0,
                message: {
                  role: "assistant",
                  content: finalContent,
                  reasoning_content: finalReasoning,
                  tool_calls: toolObjs.length > 0 ? toolObjs : undefined,
                },
                finish_reason: finishReason,
              },
            ],
            usage: upJson.usage || {
              prompt_tokens: Math.ceil(body.length / 4),
              completion_tokens: Math.ceil(finalContent.length / 4) + thinkTokens,
              total_tokens: Math.ceil(body.length / 4) + Math.ceil(finalContent.length / 4) + thinkTokens,
              reasoning_tokens: thinkTokens,
            },
            gateway: {
              allowed: !isEsh,
              quarantined_cot_tokens: thinkTokens,
              esh_intercepted: isEsh,
              tool_frames_extracted: toolObjs.length,
              upstream_provider: reqUpstream.provider,
              rejection_reason: isEsh ? "Verbal self-declared execution without verified runtime proof (ESH violation)" : "",
            },
          };

          state.lastTurn = outPayload.gateway;
          res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
          res.end(JSON.stringify(outPayload, null, 2));
          return;
        } catch (err) {
          res.writeHead(502, { ...corsHeaders, "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: { message: "Gateway upstream error: " + (err.message || String(err)) } }));
          return;
        }
      }

      res.writeHead(503, { ...corsHeaders, "Content-Type": "application/json" });
      res.end(JSON.stringify({
        error: {
          message: reqUpstream.error || "Cognitive gateway upstream is unconfigured. Simulated mock execution is strictly forbidden by Invariant STUB-01.",
          type: "gateway_unconfigured",
          code: 503
        }
      }));
      return;
    });
    return;
  }

  if (req.method === "POST" && (url.pathname === "/v1/messages" || url.pathname === "/messages")) {
    let body = "";
    req.on("data", chunk => { body += chunk; });
    req.on("end", () => {
      state.totalRequests++;
      let payload = {};
      try { payload = JSON.parse(body || "{}"); } catch {}
      const reqUpstream = resolveUpstream(req.headers, payload);
      if (reqUpstream.mode !== "proxy") {
        res.writeHead(503, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({
          error: {
            message: reqUpstream.error || "Cognitive gateway upstream is unconfigured. Simulated mock execution is strictly forbidden by Invariant STUB-01.",
            type: "gateway_unconfigured",
            code: 503
          }
        }));
        return;
      }
      const model = payload.model || process.env.ASL_GATEWAY_MODEL || "gemma-4-31b-it";
      const messages = payload.messages || [];
      const hasVerifiedExec = Boolean(payload.has_verified_execution);
      const rawText = messages.length > 0 ? messages[messages.length - 1].content : "";

      const demux = demuxContent(rawText);
      const isEsh = detectEshViolation(demux.uiContent) && !hasVerifiedExec;

      if (isEsh) {
        state.eshViolationsIntercepted++;
        res.writeHead(400, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({
          type: "error",
          error: {
            type: "gateway_rejection",
            message: "Verbal self-declared execution without verified runtime proof (ESH violation)",
          },
        }));
        return;
      }

      const contentBlocks = [];
      if (demux.uiContent) {
        contentBlocks.push({ type: "text", text: demux.uiContent });
      }
      for (const [idx, tc] of demux.toolCalls.entries()) {
        contentBlocks.push({
          type: "tool_use",
          id: "call_asl_" + (idx + 1),
          name: "tool",
          input: { call: tc },
        });
      }

      res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
      res.end(JSON.stringify({
        id: "msg_asl_" + Date.now(),
        type: "message",
        role: "assistant",
        model: model,
        content: contentBlocks,
        stop_reason: demux.toolCalls.length > 0 ? "tool_use" : "end_turn",
        usage: {
          input_tokens: Math.ceil(body.length / 4),
          output_tokens: Math.ceil(demux.uiContent.length / 4),
        },
      }));
    });
    return;
  }

  if (req.method === "POST" && url.pathname === "/v1/convert/json-to-asn") {
    let body = "";
    req.on("data", chunk => { body += chunk; });
    req.on("end", () => {
      try {
        const payload = JSON.parse(body || "{}");
        const target = payload.json !== undefined ? payload.json : payload;
        const asn = jsonToAsn(target);
        res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: true, asn: asn }));
      } catch (e) {
        res.writeHead(400, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: { message: "Invalid JSON: " + e.message } }));
      }
    });
    return;
  }

  if (req.method === "POST" && url.pathname === "/v1/convert/tool-call-to-asn") {
    let body = "";
    req.on("data", chunk => { body += chunk; });
    req.on("end", () => {
      try {
        const payload = JSON.parse(body || "{}");
        const tcs = Array.isArray(payload.tool_calls) ? payload.tool_calls : (payload.tool_call ? [payload.tool_call] : [payload]);
        const asnCalls = tcs.map(tc => toolCallToAsn(tc));
        res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: true, asn_calls: asnCalls, asn_text: asnCalls.join("\n") }));
      } catch (e) {
        res.writeHead(400, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: { message: "Invalid JSON tool call: " + e.message } }));
      }
    });
    return;
  }

  if (req.method === "POST" && url.pathname === "/v1/convert/asn-to-tool-call") {
    let body = "";
    req.on("data", chunk => { body += chunk; });
    req.on("end", () => {
      try {
        const payload = JSON.parse(body || "{}");
        const asnCall = payload.asn_call || payload.raw || body;
        const structured = parseStructuredTool(asnCall, 1);
        res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: true, tool_call: structured }));
      } catch (e) {
        res.writeHead(400, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: { message: "Invalid ASN tool call: " + e.message } }));
      }
    });
    return;
  }

  if (req.method === "POST" && url.pathname === "/v1/convert/format") {
    let body = "";
    req.on("data", chunk => { body += chunk; });
    req.on("end", () => {
      try {
        const payload = JSON.parse(body || "{}");
        const format = payload.format || url.searchParams.get("format") || "json";
        const content = payload.content !== undefined ? payload.content : "";
        const asn = staticFormatToAsn(format, content);
        res.writeHead(200, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: true, format: format, asn: asn }));
      } catch (e) {
        res.writeHead(400, { ...corsHeaders, "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: { message: "Invalid format conversion request: " + e.message } }));
      }
    });
    return;
  }

  res.writeHead(404, { ...corsHeaders, "Content-Type": "application/json" });
  res.end(JSON.stringify({ error: { message: "Route not found: " + url.pathname } }));
});

server.listen(PORT, HOST, () => {
  console.log(`✓ ASL Cognitive Gateway listening on http://${HOST}:${PORT}`);
  if (PID_FILE) {
    try { fs.writeFileSync(PID_FILE, String(process.pid)); } catch (e) {}
  }
});
'

start_server() {
  if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      echo "ASL Cognitive Gateway is already running (PID: $PID, Port: $PORT)"
      return 0
    fi
    rm -f "$PID_FILE" 2>/dev/null || true
  fi

  export PORT HOST PID_FILE
  ( node -e "$SERVER_SCRIPT" >> "$LOG_FILE" 2>&1 ) &
  local BG_PID=$!
  echo "$BG_PID" > "$PID_FILE"

  for _ in {1..30}; do
    if curl --noproxy "*" -s "http://${HOST}:${PORT}/health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done

  if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE")"
    echo "✓ ASL Cognitive Gateway started (PID: $PID, Port: $PORT)"
    echo "  Health:  curl -s http://${HOST}:${PORT}/health"
    echo "  Metrics: curl -s http://${HOST}:${PORT}/metrics"
  else
    echo "✗ Failed to start ASL Cognitive Gateway. Check $LOG_FILE"
    exit 1
  fi
}

run_server() {
  echo "Running ASL Cognitive Gateway in foreground on http://${HOST}:${PORT}..."
  export PORT HOST PID_FILE
  exec node -e "$SERVER_SCRIPT"
}

stop_server() {
  if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE")"
    if kill -0 "$PID" 2>/dev/null; then
      kill "$PID" 2>/dev/null || true
      rm -f "$PID_FILE"
      echo "✓ ASL Cognitive Gateway stopped (PID: $PID)"
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  echo "ASL Cognitive Gateway is not running on port $PORT"
}

status_server() {
  if [ -f "$PID_FILE" ]; then
    PID="$(cat "$PID_FILE")"
    if kill -0 "$PID" 2>/dev/null; then
      echo "ASL Cognitive Gateway: ACTIVE (PID: $PID, Port: $PORT)"
      curl --noproxy "*" -s "http://${HOST}:${PORT}/health" || true
      echo ""
      return 0
    fi
  fi
  echo "ASL Cognitive Gateway: OFFLINE (Port: $PORT)"
  return 1
}

case "$CMD" in
  start)
    start_server
    ;;
  run)
    run_server
    ;;
  stop)
    stop_server
    ;;
  convert)
    TARGET="${EXTRA_ARGS[0]:-}"
    if [ -z "$TARGET" ]; then
      echo "Usage: asl-gateway convert <file.json>" >&2
      exit 1
    fi
    node -e '
      const fs = require("fs");
      function jsonToAsn(val, indent = 0) {
        if (val === null || val === undefined) return "nil";
        if (typeof val === "boolean") return val ? "true" : "false";
        if (typeof val === "number") return String(val);
        if (typeof val === "string") return JSON.stringify(val);
        if (Array.isArray(val)) return "[" + val.map(v => jsonToAsn(v, indent + 2)).join(" ") + "]";
        if (typeof val === "object") {
          let out = "(:record";
          for (const k of Object.keys(val)) out += ` :${k} ${jsonToAsn(val[k], indent + 2)}`;
          return out + ")";
        }
        return String(val);
      }
      try {
        const raw = fs.readFileSync(process.argv[1], "utf8");
        const parsed = JSON.parse(raw);
        console.log(jsonToAsn(parsed));
      } catch (e) {
        console.error("Conversion error:", e.message);
        process.exit(1);
      }
    ' "$TARGET"
    exit 0
    ;;
  status)
    status_server
    ;;
  restart)
    stop_server
    sleep 0.2
    start_server
    ;;
  *)
    echo "Usage: asl-gateway <start|run|stop|status|restart> [--port 8765]"
    exit 1
    ;;
esac
