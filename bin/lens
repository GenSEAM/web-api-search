#!/usr/bin/env bash
# bin/lens: External Agent Steering & Codebase Intelligence Accelerator
# Pure AgentScript distribution for Claude Code, Cursor, Windsurf
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
export PATH="${ROOT_DIR}/asl:${PATH}"

show_help() {
  cat << 'EOF'
asl-lens: External Agent Steering Accelerator (Pure AgentScript)
Usage: lens [options] [command]

Options:
  --setup, --rules     Output negative constraints and steering rules (CLAUDE.md / .cursorrules)
  --test               Execute native ASL test suite
  -v, --version        Print version information
  -h, --help           Show this help message

Documentation: https://aslang.dev
EOF
}

check_asl() {
  if ! command -v asl >/dev/null 2>&1; then
    echo "[genseam/lens] ERROR: AgentScript (asl) runtime is required but not found on PATH."
    echo "To install AgentScript instantly, run:"
    echo ""
    echo "  curl -fsSL https://aslang.dev/install.sh | bash"
    echo ""
    echo "For documentation, visit https://aslang.dev"
    exit 1
  fi
}

if [[ $# -eq 0 ]]; then
  show_help
  exit 0
fi

case "$1" in
  -h|--help)
    show_help
    exit 0
    ;;
  -v|--version)
    echo "asl-lens v1.0.0 (Pure AgentScript)"
    exit 0
    ;;
  --test)
    check_asl
    echo "--> Running asl-lens pure ASL test suite..."
    asl test "${ROOT_DIR}/tools/lens/tests/lens-test.asl"
    echo "✓ [Lens Test] All tests passed cleanly (100% pure AgentScript)."
    exit 0
    ;;
  --setup|--rules)
    cat << 'EOF'
# Negative Constraints & Lens Steering Directives
- FORBIDDEN: Never call whole-file View/cat on files exceeding 50 lines (prevents context blowout).
- FORBIDDEN: Never mutate files without checking dependency impact.
- MANDATORY: Use 'asl intel outline <file>' to inspect module structure and signatures.
- MANDATORY: Use 'asl intel impact <symbol>' before modifying shared functions.
- MANDATORY: Use compact ASN format (:call :tool "..." :params [...]) for dense tool execution.
EOF
    exit 0
    ;;
  *)
    check_asl
    echo "Unknown command: $1. Run 'lens --help' for options."
    exit 1
    ;;
esac
