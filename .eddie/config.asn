(:eddie-config
  :model "gemma-4-31b-it"
  :pipeline "full"
  :environment "modal"
  :entropy-threshold :auto
  :airgap true
  :asl-first true
  :scout-polyglot true
  :stages [
    (:stage :name :scout :timeout-sec 30)
    (:stage :name :plan-and-gap-audit :timeout-sec 45)
    (:stage :name :implement :timeout-sec 90)
    (:stage :name :test-and-verify :timeout-sec 60)
  ]
  :telemetry-sink "harness/results/terminal-bench-4")
