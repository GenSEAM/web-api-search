(:asl-config
  :workspace "genseam"
  :version "1.0.0"
  :pure-asl true
  :asl-first true
  :conventions (
    :taskNaming :camelCase
    :taskPrefix "T"
    :subtaskNaming :camelCase
  )
  :projections [
    (:proj :from "asl/web/styles.asn" :to "asl/web/src/index.css" :format "css" :doc "Web showcase CSS stylesheet")
    (:proj :from "asl/package.asn" :to "asl/package.json" :format "json" :doc "Root ASL NPM manifest")
    (:proj :from "asl/web/package.asn" :to "asl/web/package.json" :format "json" :doc "Web showcase package manifest")
    (:proj :from "asl/wrangler.asn" :to "asl/wrangler.toml" :format "toml" :doc "Cloudflare Workers configuration")
  ]
  :ignore [
    "scratch/**"
    "dist/**"
    "tmp/**"
    ".asl/cache/**"
    ".asl/log/**"
    "**/.system_generated/**"
    "**/*.tmp"
    "**/*.log"
    "**/fixtures/unbalanced/**"
    "asl/bench/*.lock"
    "asl/grammar/*.lock"
    "asl/prelude/*.lock"
    "asl/.pre-commit-config.yaml"
    "editorial-matrix/.github/**"
    "editorial-matrix/scripts/**"
    "**/pnpm-lock.yaml"
    "**/package-lock.json"
    "**/pnpm-workspace.yaml"
    "asl/web/dist/**"
    "jobs/**"
    "harness/results/**"
    ".asl/metrics/**"
    "**/.asl/metrics/**"
  ]
  :gates [1 2 3 4 5 6 7]
  :binary-whitelist [
    (:bin :name "asl" :purpose "Sovereign single-binary engine, evaluator, compiler, evolver, and memory substrate" :path "asl/bin/asl")
    (:bin :name "asl-engine" :purpose "Sovereign resident engine alias" :path "asl/bin/asl-engine")
    (:bin :name "git" :purpose "Git-native textual state management and CAS diff generation" :path "git")
    (:bin :name "bash" :purpose "POSIX launch bootstrapping and minimal CLI dispatch" :path "bash")
  ]
  :token-baseline 2
  :telemetry (:target-turn-ms 100 :max-token-ceiling 150)
  :daemon (:resident true :memory-index true :max-files 2000)
  :processPlane (
    :defaultTimeoutMs 300000
    :idleTimeoutMs 30000
    :warningThreshold 0.80
    :tombstoneTtlSec 1800
    :maxDeadProcs 50
    :profiles [
      (:profile :name "light" :timeoutMs 60000 :idleTimeoutMs 15000)
      (:profile :name "default" :timeoutMs 300000 :idleTimeoutMs 30000)
      (:profile :name "heavy" :timeoutMs 900000 :idleTimeoutMs 60000)
    ]
  )
  :coverage (
    :desired 80.0
    :min-assertions 2
    :strict-polarity false
    :discount-zero-asserts true
    :core-desired 100.0
    :core-packages ["agent-core" "asl/asl-compiler" "asl/asl-parser" "crawler" "browser-plugin" "web-api-search"]
    :exclude ["asl/examples/**" "asl-arduino/**" "asl-quantum/**"]
  )
  :tasks [
    (:task :name "project" :cmd "asl project" :doc "Transpile all declared ASN projections to host targets")
    (:task :name "gate" :cmd "asl gate" :doc "Run full 7-gate pure ASL verification")
    (:task :name "test" :cmd "asl test" :doc "Run native ASL test suites")
    (:task :name "coverage" :cmd "asl coverage" :doc "Audit native function test coverage")
    (:task :name "telemetry" :cmd "asl telemetry" :doc "Collect performance telemetry and token metrics")
    (:task :name "sync" :cmd "asl tools/sync-workspace.asl" :doc "Sync workspace submodules")
    (:task :name "web:transpile" :cmd "asl transpile-pkg asl/web/package.asn asl/web/package.json" :doc "Transpile web package.asn to package.json")
    (:task :name "web:build" :cmd "asl task web:transpile && npm --prefix asl/web run build" :doc "Build production web showcase")
    (:task :name "web:dev" :cmd "asl task web:transpile && npm --prefix asl/web run dev" :doc "Start Vite development server")
    (:task :name "gateway" :cmd "bin/asl-gateway" :doc "Start sovereign L7 cognitive gateway daemon")
    (:task :name "harness:dist" :cmd "bin/package-harness" :doc "Package canonical in-container ASL harness distribution")
    (:task :name "runner" :cmd "bin/asl-runner" :doc "Run commands under sovereign in-container gateway routing")
    (:task :name "tbench:smoke" :cmd "bin/modal-tbench --smoke" :doc "Run single-task smoke test in Modal")
    (:task :name "tbench:full" :cmd "bin/modal-tbench --full --concurrency 4" :doc "Run full Terminal-Bench 4 on Modal microVMs")
    (:task :name "tbench:package" :cmd "python3 scratch/harbor/package_submission.py" :doc "Package latest Harbor job to official submission tarball")
  ]
  :gateway (:endpoint "http://127.0.0.1:8765/v1" :port 8765 :quarantine-cot true :intercept-esh true)
  :tool-plane (:version "2.0"
    :dynamic-mounting true
    :registry ".asl/tools/registry.asn"
    :base-meta-tools ["eval" "batch" "tool-load" "tool-unload"]
    :token-budget 200
    :domains [":git" ":intel" ":crawler" ":fs" ":compiler" ":mesh" ":bench"]
    :scopes ["asl" "crawler" "agent-bus" "editorial-matrix" "*"]
    :tools [
      (:tool :id "agent-browser"
        :name "Agent Browser Automation CLI"
        :scope ["*"]
        :agents ["implementer" "reviewer" "explorer"]
        :safety :safe
        :doc "Fast in-browser automation, layout inspection, and snapshot interaction"
        :guidance "Use for web tasks, form filling, in-browser evaluation, and taking screenshots"
        :cmd "agent-browser"
        :args []
        :env [(:bind "AGENT_BROWSER_COLOR_SCHEME" "dark")]
        :secrets [(:secret :key "AI_GATEWAY_API_KEY" :source "env" :ref "AI_GATEWAY_API_KEY" :default "")])
      (:tool :id "asl-cli"
        :name "AgentScript CLI Toolchain"
        :scope ["*"]
        :agents ["*"]
        :safety :safe
        :doc "Pure ASL compilation, checking, running, and verification gates"
        :guidance "Use for checking syntax, running test suites, executing Wasm MicroVM, and gate checks"
        :cmd "asl"
        :args []
        :env []
        :secrets [])
      (:tool :id "asl-gateway"
        :name "L7 Cognitive Gateway Service"
        :scope ["*"]
        :agents ["*"]
        :safety :safe
        :doc "Universal L7 Cognitive Gateway: CoT reasoning quarantine, verbal ESH interception, and structured tool translation"
        :guidance "Mandatory LLM inference nexus listening on http://127.0.0.1:8765/v1"
        :cmd "bin/asl-gateway"
        :args []
        :env [(:bind "PORT" "8765")]
        :secrets [])
    ])
  :reflection-stages [
    (:stage :id "s1-ingest" :enabled true :ablation-group "core")
    (:stage :id "s2-reformulate" :enabled true :ablation-group "reformulation")
    (:stage :id "s3-intent-gate" :enabled true :ablation-group "reformulation")
    (:stage :id "s4-plan" :enabled true :ablation-group "planning")
    (:stage :id "s5-plan-gate" :enabled true :ablation-group "planning")
    (:stage :id "s6-implement" :enabled true :ablation-group "execution")
    (:stage :id "s7-verify" :enabled true :ablation-group "verification")
  ]
  :pipeline-profiles [
    (:pipeline-profile
      :name "balanced-coding"
      :active-stages ["s1-ingest" "s2-reformulate" "s3-intent-gate" "s4-plan" "s6-implement" "s7-verify"]
      :skip-stages ["s5-plan-gate"])
    (:pipeline-profile
      :name "fast-path"
      :active-stages ["s1-ingest" "s6-implement"]
      :skip-stages ["s2-reformulate" "s3-intent-gate" "s4-plan" "s5-plan-gate" "s7-verify"])
    (:pipeline-profile
      :name "deep-reflex"
      :active-stages ["s1-ingest" "s2-reformulate" "s3-intent-gate" "s4-plan" "s5-plan-gate" "s6-implement" "s7-verify"]
      :skip-stages [])
  ]
)
