(:id "SystemArchitecture" :version "0.1.0" :status :proposed :kind :review
 :purpose "Consolidate the ASL/ASN, conceptual orientation, context, agent coordination, knowledge-base and code-navigation designs into a small testable architecture and a discoverable knowledge lifecycle."
 :authority "This is a review proposal. It does not silently amend adopted ADRs, active tasks or runtime contracts. Accepted changes must update their existing authoritative source."
 :plan ".asl/mem/tasks/SystemArchitectureReview.asn"
 :review ".asl/mem/reviews/SystemArchitectureReview.asn"
 :scope "Source-linked conceptual and repository review, not an exhaustive dynamic audit of every module. Prior design documents are inputs; their implementation and model-effectiveness claims require independent evidence."
 :architecture [
  (:id "Language" :purpose "A small reliable ASL execution profile and ASN data profile, with explicit precedence between syntax, data, wire and host behavior." :owner "asl/grammar and existing normative specifications" :acceptance "Known-invalid values and unknown operations fail; accepted examples preserve meaning across parse and serialization.")
  (:id "Concepts" :purpose "Reusable orientation: Purpose, Evidence, Boundaries, Inquiry, Attention, Feedback and Engagement, with independent depth, specialization and force." :owner ".asl/mem/principles.asn and harness consumers" :acceptance "Each concept has scope, counterexamples and observable application criteria; essential status remains a candidate until ablation or explicit normative adoption.")
  (:id "Context" :purpose "Versioned evidence and recoverable history, dependency-aware selection, exact budget accounting and immutable prompt snapshots." :owner "mem storage, intel retrieval and harness assembly" :acceptance "Required context survives selection; summaries never replace the source of truth; stale references and missing evidence are explicit outcomes.")
  (:id "Coordination" :purpose "Deterministic task and event transitions, durable delivery, script execution and bounded model escalation." :owner "agent-core state, agent-bus transport and harness invocation" :acceptance "Scripts execute without a model roundtrip; duplicate or stale events cannot commit a second effect; ambiguous external effects require reconciliation.")
  (:id "Knowledge" :purpose "A curated library of concepts, claims and procedures, with source lineage and model-specific views." :owner "Existing memory and retrieval contracts; no second independent store" :acceptance "Generated statements remain candidates; provenance, applicability and external verification are separate; retrieval or expansion makes marker bindings available.")
  (:id "Evaluation" :purpose "Independent evidence for correctness, reliability, model benefit and total cost." :owner "Existing test hosts, harness evaluation and .asl/mem/reviews" :acceptance "Run settings, source revisions, negative results and actual assertions accompany every claim; format correctness never certifies reasoning quality.")]
 :composition (:shared ["identity" "scope" "revision" "provenance" "dependencies" "outcome status"]
  :rule "Share an identical boundary contract after concrete reuse is established. Keep storage records, model projections and wire envelopes distinct. Do not create one universal record containing every layer's fields."
  :minimal "One task, one evidence source, one context snapshot, one bounded action and one externally checked outcome form the first vertical slice. A complete compiler, distributed mesh or large KB is not a prerequisite for that slice.")
 :dispositions [
  (:item "Essential orientations" :action :keep :source "docs/ParadigmSystem/Essential.asn:1" :why "Preserve the seven-concept candidate while testing necessity; Evidence, Inquiry and Feedback answer different questions.")
  (:item "Tier system" :action :clarify :source "docs/ParadigmSystem/Catalog.asn:7" :why "Depth, specialization and normative force are independent. A small context does not weaken authority or omit required task constraints.")
  (:item "Teleology and motivation vocabulary" :action :merge :source "docs/ParadigmSystem/Migration.asn:32" :why "Map task purpose to Purpose and persistence to Engagement; preserve provenance for historical names. Avoid emotional personas and an extra motivation engine without evidence.")
  (:item "Concept, Claim, Observation and Receipt definitions" :action :consolidate :source "docs/ParadigmSystem/Design.asn:37" :related "docs/ParadigmSystem/ConceptBase.asn:31" :why "Choose one owner for each semantic definition and render small views; duplicated definitions are a maintenance defect.")
  (:item "Marker dictionary" :action :merge :source "docs/ParadigmSystem/MarkerForms.asn:5" :why "Treat marker spelling as a versioned model view of stable concept IDs. No universal :use wrapper or one-to-two-token guarantee. Bare-symbol examples in the older proposal are not normative ASN.")
  (:item "Context mechanisms" :action :compose :source "docs/ParadigmSystem/ContextEngine.asn:81" :why "Storage, masking, summarization, retrieval, selection and prefix caching address different costs. Centralize admission and accounting, retain separate algorithms and evidence.")
  (:item "Roles and reflection" :action :simplify :source "docs/ParadigmSystem/AgentProtocol.asn:23" :why "Use a role when independent responsibility is needed. Route routine actions through static transitions; repeated discussion without new evidence consumes a bounded budget and leaves unresolved work explicit.")
  (:item "Automatic success text and fabricated recall" :action :retire :source "docs/ParadigmSystem/ContextEngine.asn:14" :why "Remove from the trusted execution path after replacement tests are ready. A string saying verified, a constant confidence or a fabricated snippet cannot serve as an observation.")
  (:item "Large KB, wide prefetch and distributed mesh" :action :defer :source "docs/ParadigmSystem/ConceptBase.asn:38" :why "Begin with a small curated corpus, demand retrieval and one durable coordinator. Scale only a measured bottleneck or proven benefit.")
  (:item "Package flattening and apparent orphans" :action :defer :source ".gitmodules:1" :why "The repository has real submodule and package boundaries. Import absence alone cannot prove a module unused; inspect exports, CLI dispatch, registration, examples and external consumers before deletion.")]
 :additions [
  (:item "Assumptions and criteria" :placement "Existing Claim, Decision and Task contracts" :meaning "Record assumptions, their supporting evidence and invalidation dependencies. A changed acceptance criterion creates a new authorized task revision and invalidates prior acceptance; it cannot silently turn a failure into a pass.")
  (:item "Comparable observations" :placement "Shared boundary fields only where needed" :meaning "Preserve units, time and scope alongside identity and revision. Same wording does not establish that two observations can be reconciled.")
  (:item "Explicit outcomes" :placement "Existing result contracts" :meaning "Distinguish Unsupported, Unavailable, NotFound, Inconclusive, BudgetExhausted and verified failure. None implies task success or impossibility by itself.")
  (:item "Effects" :placement "Action admission contract" :meaning "An executable action declares its effects; absence means an explicit pure action or rejection, never unknown unrestricted effects.")
  (:item "Model profile lifecycle" :placement "Existing ModelView" :meaning "Bind model/version, tokenizer, task family, framing and evaluation evidence; model or task-distribution changes trigger re-evaluation.")]
 :findings [
  (:id "GrammarDrift" :priority :critical :evidence ["asl/grammar/asn.lark:40" "asl/grammar/asn.lark:65" "docs/ParadigmSystem/MarkerFormsReview.asn:4"] :finding "The proposed bare-symbol marker vector is excluded by the declared ASN data grammar. The referenced validate_asn.py is absent and full grammar execution was not available in the marker review." :action "Restore a reproducible normative conformance path and migrate examples only after the data profile is explicit.")
  (:id "GateReadiness" :priority :critical :evidence ["tests/acceptance/d81/SuperviseGate.sh:45" ".asl/mem/tasks/Phase464InstructionTruthAndExampleCoverage.asn:8"] :finding "A missing acceptance fixture produces infrastructure failure. It is not the required baseline failure of implemented semantics." :action "Inventory fixtures and fresh behavioral baselines before admitting existing tasks to execution; retain unavailable and not-run states.")
  (:id "RegistryDrift" :priority :high :evidence [".asl/mem/decisions.asn:1" ".asl/mem/decisions/decisions.asn:1"] :finding "Two decision registries differ and coexist with individual ADR records." :action "Resolve ownership, generate a single index from adopted record owners and preserve existing consumer references during migration.")
  (:id "BrokenReferences" :priority :high :evidence ["harness/paradigm.asn:46" "harness/paradigm.asn:77"] :finding "The scout found all 30 literal decision :ref paths absent after renaming, plus the old in_flight.asn spelling." :action "Stable IDs, explicit ID-to-path resolution, compatibility aliases and reference checks must precede relocation or retirement.")
  (:id "SurfaceTruth" :priority :high :evidence ["README.md:8" "ROADMAP.md:3" "asl/llms.txt:18" "scripts/install.sh:63"] :finding "Entry surfaces contain unconditional historical claims, absent targets or instructions inconsistent with current capability policy." :action "Render current availability from version-bound evidence, label planned behavior and keep human explanation separate from performance claims.")
  (:id "UnobservedCognition" :priority :high :evidence ["docs/ParadigmSystem/ConceptBase.asn:10" ".asl/mem/tasks/Phase462LlmFirstLexicon.asn:23"] :finding "Token measurements do not establish improved judgment, model-independent semantics or internal reasoning in ASN." :action "Revise the cost-only objective to semantic fidelity, task success and full cost; evaluate external behavior without claiming access to internal reasoning.")
  (:id "KnowledgeLifecycle" :priority :high :evidence [".asl/mem/tasks/Phase468IntentGoalPracticeLifecycle.asn:8" ".asl/mem/components.asn:1" ".asl/mem/trace.asn:5"] :finding "Knowledge has richer storage than routing and retirement. A new catalog without consumers would repeat this defect." :action "Attach applicability, ownership, status, provenance, supersession and retrieval routes to existing records; project only the task-relevant active slice.")]
 :documentation (:principle "Location alone does not make a document useful. Every durable item needs an owner, a consumer, an applicability route and a lifecycle. New work is recorded in the existing task/decision/review stores, not as another parallel docs programme."
  :locations [
   (:path "README.md" :role "Human entrypoint: current architecture, available commands with checks and the next work. A short navigation link is added now; claim cleanup is planned separately.")
   (:path "asl/grammar" :role "Executable syntax and boundary registries. Existing normative prose such as asl/docs/ASN_SPEC.md remains authoritative in its declared scope; do not move it merely because its directory is named docs.")
   (:path ".asl/mem/principles.asn" :role "Adopted conceptual principles and source distinctions; specialized consumers receive generated or selected views.")
   (:path ".asl/mem/practices.asn" :role "Practices with applicability and retirement conditions; executable enforcement stays in deterministic tools.")
   (:path ".asl/mem/decisions" :role "Owned decision records and dated review proposals, with one derived lookup index. Proposed and adopted material must remain distinguishable.")
   (:path ".asl/mem/components.asn" :role "Existing component map extended with concept, contract, decision, evidence and task references; no second unrelated knowledge index.")
   (:path ".asl/mem/tasks" :role "Backlog, active work and session lifecycle. This review coordinates amendments to existing phases; phase task files remain the implementation authority.")
   (:path ".asl/mem/reviews" :role "Independent review and research receipts with exact scope, source revision, commands, raw-result references and limitations.")
   (:path "Package manifests and local specifications" :role "Domain ownership, interfaces, dependencies and examples close to their implementation; project-level indexes reference these sources.")
   (:path "docs/ParadigmSystem" :role "Frozen proposal and evidence history. Promote adopted definitions to their owners, leave redirects and retain original evidence rather than appending another active specification here.")]
  :routing "Task situation -> component/contract/concept IDs -> authoritative record and current status -> dependency-closed slice -> prompt budget -> source-bound receipt. Deterministic lookup and lexical search come first; semantic ranking is optional and cannot establish authority."
  :metadata ["stable ID" "kind" "owner" "status" "applicability" "source/revision" "related IDs" "supersedes" "verification scope"]
  :lifecycle "Candidate -> reviewed -> adopted or rejected; adopted -> superseded or retired. Evidence records remain immutable references. Historical material is excluded from active guidance by default but stays retrievable."
  :admission "Persist a reusable definition, a decision with consequences, an actionable task or reproducible evidence. Keep transient observations in session history; merge repeated rationale by reference. No new permanent document without a named consumer."
  :migration ["Inventory source owners and incoming references." "Classify current, proposed, historical and generated material." "Reconcile phase ownership and stable IDs." "Add aliases and reference/projection checks." "Connect lookup to agent task context and README navigation." "Promote only adopted material to existing owners." "Retire duplicate active copies after consumer checks; preserve history and rollback."]
  :now "No mass relocation, registry rewrite or deletion was performed. Existing generated blocks and dirty ledgers are preserved.")
 :navigation (:principle "Resolve the next code question with the cheapest sufficient evidence representation. Offset reading is a materialization operation, not the default discovery strategy. A known exact target can be read directly; no mandatory tree, graph or vector detour."
  :force :orientation :status :proposed
  :routes [
   (:question "Known path, symbol, literal, error or configuration key" :first "Exact path/identifier or scoped lexical lookup" :then "Return the relevant declaration or span; read imports, types and surrounding conditions when the conclusion depends on them.")
   (:question "Unknown implementation location or responsibility" :first "Package map or short abstracts, lexical candidates and optionally semantic ranking" :then "Resolve candidate ownership and symbols, then inspect enough exact source to establish behavior.")
   (:question "Callers, dependency, reuse or change impact" :first "Typed graph edges around a resolved symbol, when the adapter actually supplies them" :then "Expand only material unresolved dependencies; distinguish containment, binding, invocation, data flow and similarity. Read relevant call sites and contracts before concluding.")
   (:question "Condition, exception, state, effects, binding or proposed edit" :first "Current source, including the defining context" :then "Read the applicable tests/contracts and use runtime evidence where static analysis cannot establish the claim.")
   (:question "Path, owner, signature, count or already verified diagnostic" :first "An authoritative version-bound lookup or analysis receipt" :then "A full body read is unnecessary if the receipt directly establishes the requested fact and exposes its coverage.")
   (:question "What changed since the last observation?" :first "Scoped change receipt plus source revisions" :then "Invalidate dependent graph edges, abstracts, embeddings and accepted context; refresh only the affected material or reconcile the scope after missed events.")]
  :trees "A filesystem/package containment tree, a retrieval tree of summaries and a semantic dependency graph encode different relations. Do not infer calls from containment or proof from a summary parent. Permit direct retrieval at any useful level instead of requiring traversal from the root."
  :read "Use stable symbol/span references bound to a source revision where available; offsets are the fallback for materializing a known range. A small relevant complete file can be cheaper and clearer than several disconnected slices. Before editing, recover exact current text and the affected semantic context."
  :abstract (:purpose "Route attention by responsibility, public entrypoints, dependencies, effects and limitations."
   :content "Keep extracted signatures and structural facts separate from model-generated descriptions or inferred purpose. Each statement links to its source spans; a summary is derived data, never an authoritative replacement for source."
   :identity "Bind source digest, relevant dependency digests, producer/version, extraction method, omissions and scope. Same-revision generated prose can still be wrong."
   :policy "Build on demand for repeatedly useful scopes, cache by dependency revision and measure construction/update cost. Start with deterministic outlines; generate semantic abstracts only when they earn their cost."
   :stale "Invalidate on relevant changes. A stale abstract may be exposed as a historical routing hint only with explicit status; it cannot authorize a current-code claim or edit.")
  :surface "Extend existing RPC and adapters with selection by question/method, bounded relation expansion, exact materialization, changes-since and capability status. These are proposed responsibilities, not new commands asserted to exist. Keep tool definitions stable during a session."
  :receipt ["query and scope" "method: lexical, parsed, bound, inferred or observed" "source references and digests" "index epoch and parser/binder version" "relation kind and uncertainty" "coverage and exclusions" "truncation cursor" "pending or stale state" "serialized token cost"]
  :monitoring (:snapshot "Identify the repository/worktree, root and submodule revisions, dirty disk contents and editor overlay. A root HEAD alone does not describe the current code."
   :events ["FileChanged" "Renamed" "Deleted" "ManifestChanged" "BranchChanged" "SubmoduleChanged" "BufferChanged"]
   :invalidation "Apply changes to parse results, bindings and incoming edges, then derived abstracts/embeddings and dependent context. Unaffected revisions remain reusable. Failed parsing retains an explicit unavailable/new-revision result instead of silently returning the old graph as current."
   :recovery "Coalesce bursts; reconcile after watcher overflow, reconnect or an unknown cursor. A watcher is an invalidation hint, so recheck the expected source revision before editing or reusing a verification receipt."
   :attention "Expose only changes affecting the current task, validity, pending retrieval or remaining budget. Avoid flooding the model with filesystem events or periodic full-repository summaries.")
  :current [
   (:kind :source :status :available :evidence "asl/tools/asl.c:920" :meaning "Disk line slices are available; snapshot binding is not supplied by this path.")
   (:kind :outline :status :heuristic :evidence "asl/tools/asl.c:347" :meaning "Post-line string parsing, not a fully bound AST result.")
   (:kind :symbol :status :candidate :evidence "asl/tools/asl.c:800" :meaning "ASL definition-line substring candidates; not exact scope-aware symbol resolution.")
   (:kind :callers :status :lexical :evidence "asl/tools/asl.c:832" :meaning "Substring mentions can include declarations and strings; they do not prove a call edge.")
   (:kind :impact :status :lexical :evidence "asl/tools/asl.c:864" :meaning "ASL/ASN substring matches, not transitive semantic impact.")
   (:kind :search :status :partial :evidence "asl/tools/asl.c:1319" :meaning "RPC grep routes to filename find; scoped host rg is the current content-search fallback.")
   (:kind :graph :status :incomplete :evidence "intel/src/extractor.asl:71" :meaning "The inspected extractor returns empty symbols and references; graph data types alone do not establish an indexed source path.")
   (:kind :semantic :status :unestablished :evidence "mem/src/driver.asl:11" :meaning "Vector operations over supplied embeddings exist; a versioned encoder and public retrieval path were not established in this audit.")
   (:kind :summaries :status :lexical :evidence "mem/src/summary_search.asl:29" :meaning "Search over provided summary text; no demonstrated faithful-summary generator or freshness check.")
   (:kind :watch :status :unestablished :evidence "asl/tools/asl.c:4355" :meaning "No watch/invalidation route was established in the inspected public dispatcher. Existing VFS drift functions are reusable components, not proof of connected monitoring.")]
  :fallback "Today, use scoped lexical/filename candidates, manually confirm bindings from current source and inspect git changes plus source digests. Declare the absence of reliable graph/semantic/freshness data rather than returning an empty success."
  :avoid ["Sequential offset paging with an already known exact target" "Semantic similarity treated as invocation or causality" "Fixed-depth graph expansion independent of the question" "A body read without imports, types or configuration that change its meaning" "Edits based only on summaries" "Stale or incomplete indexes presented as authoritative" "Repeated identical unsuccessful queries" "Unconditional summarization of every file" "Token savings achieved by silently omitting decisive dependencies"]
  :stop "Stop when evidence covers the next decision and material dependencies. If a bounded search leaves uncertainty, name the missing evidence and choose a different route or return unresolved; do not invent connectivity."
  :ownership "asl owns parser/binder and RPC contracts; intel owns symbol relations and navigation views; mem owns versioned storage and derived-index lifecycle; harness owns question routing, evidence needs and prompt budget. Reuse these boundaries without another search daemon."
  :evidence "The policy is a design inference from the source audit and the research below; neither source-code inspection nor published results establish a universal optimal route.")
 :literature [
  (:id "RepoGraph" :url "https://arxiv.org/html/2410.14684v2" :scope "Repository graph assistance for SWE-bench workflows, predominantly Python and GPT-4-family evaluation." :finding "Graph assistance can help, but more hops and summarization did not uniformly improve the reported variants." :limit "No universal graph-first result or transfer proof for ASL and small models.")
  (:id "RepoCoder" :url "https://aclanthology.org/2023.emnlp-main.151/" :scope "Repository-level completion with iterative retrieval and generation." :finding "Supports evaluating iterative retrieval when the relevant code is outside the current file." :limit "Completion evidence is not autonomous issue-fixing or proof that summaries are always useful.")
  (:id "RAPTOR" :url "https://arxiv.org/html/2401.18059v1" :scope "Hierarchical summary retrieval for document question answering." :finding "A useful precedent for retrieving at several abstraction levels." :limit "Not a source-code binding or incremental code-summary validation study.")
  (:id "CodeSearchNet" :url "https://arxiv.org/abs/1909.09436" :scope "Natural-language-to-code relevance evaluation." :finding "Separates relevance assessment from merely finding matching words." :limit "Relevant code is not necessarily a complete change-impact set or a correct patch.")]
 :tools (:reuse ["Phase474 content/shape/destination projection" "Phase465 working-memory surface" "Phase457 binding graph" "Existing component/dependency maps" "Existing RPC slices and lexical search" "Existing test hosts and evidence ledgers"]
  :required ["Normative grammar and schema conformance corpus" "Stable ID/reference resolver and drift check" "Framed token measurement per model profile" "Source-bound result and event replay fixtures" "Paired model evaluation with independent oracle"]
  :boundary "Add these capabilities behind existing package boundaries after confirming their current status. A new daemon, vector database, ontology service or universal abstraction is not assumed necessary."
  :usefulness "A tool is admitted by an end-to-end consumer test, including failure behavior and its declared fallback, not by the existence of a command name.")
 :research (:status :planned :runs 0 :budget :not-allocated
  :protocol "Freeze model/version/tokenizer, task distribution, variants, grading, spend/turn limits and adoption criteria before a pilot. Keep all non-target variables fixed. Store raw outcomes and negative results. Reaching the budget without enough evidence yields Inconclusive; it does not authorize a larger run."
  :thresholds "For task-quality pilots, a candidate noninferiority margin is 2 percentage points with a 95 percent paired uncertainty interval; this is a proposed design tolerance, not a scientific constant, and stricter task families may require zero tolerance. Cost benefit must include setup, retrieval, output and repairs. The risk owner selects the applicable tolerance before execution."
  :experiments [
   (:id "R1" :priority :critical :question "Can the measurement path distinguish real success from forged or unreached success?" :variants ["Current behavior" "Reliable minimal profile"] :metrics ["Invalid parse rejection" "Reached assertions" "Mutation detection" "Stale or forged receipt acceptance"] :decision "Any false acceptance in the mandatory deterministic corpus blocks efficacy claims." :limit "Offline fixtures and replay only; no model calls." :depends [])
   (:id "R2" :priority :high :question "Does conceptual orientation improve task performance or cost?" :variants ["No kernel" "Equivalent imperatives" "Conceptual orientation"] :metrics ["Blind task correctness" "Constraint omission" "Transfer errors" "Total cost"] :decision "Adopt only under the preregistered quality criterion and a demonstrated quality or cost advantage." :limit "One bounded pilot before replication on another model profile." :depends ["R1"])
   (:id "R3" :priority :high :question "Which concepts belong in essential?" :variants ["Full candidate kernel" "Leave one concept out"] :metrics ["Unsupported claims" "Scope mistakes" "Repeated unproductive actions" "Cost by task family"] :decision "Keep independently useful concepts or explicitly adopted norms in essential; move others to brief or specialty instead of deleting their definitions." :limit "Screen on one profile; replicate only candidate changes." :depends ["R2"])
   (:id "R4" :priority :high :question "Do markers help after binding and expansion costs?" :variants ["Expanded definitions" "Semantic labels" "Keyword vector" "String vector" "Opaque aliases"] :metrics ["Correct concept application" "Missed exceptions" "Unknown-marker handling" "Binding and repair cost"] :decision "Prefer a profile only if semantic fidelity meets the quality criterion and total cost improves. A shorter individual marker alone cannot win." :limit "Fixed candidate set; test changed bindings, spelling errors and task shifts before broad adoption." :depends ["R1"])
   (:id "R5" :priority :high :question "Which context combination preserves useful evidence efficiently?" :variants ["Raw history" "Recoverable masking" "Summary plus source recovery" "Scoped hybrid retrieval"] :metrics ["Requirement retention" "Stale evidence use" "Recovery correctness" "Task outcome" "Latency and total cost"] :decision "Required constraints and authority must survive deterministic assembly. Choose optional compression/retrieval using paired task outcomes." :limit "Bounded long-history tasks and narrow tasks with a 1000-token whole-window budget; no claim for arbitrary tasks at that size." :depends ["R1"])
   (:id "R6" :priority :high :question "When does reflection or a second agent repay its cost?" :variants ["No review" "Self-review" "Fresh external evidence" "Independent review"] :metrics ["Wrong-to-correct outcomes" "Correct-to-wrong outcomes" "Unsupported completion" "Review turns and cost"] :decision "Route review where measured error reduction justifies it. Exhaustion with unresolved evidence remains unresolved." :limit "Equal total budgets and capped review turns; include repeated identical findings." :depends ["R1"])
   (:id "R7" :priority :medium :question "Does a small curated conceptual KB outperform its sources under the same budget?" :variants ["Original sources" "Extracted definitions" "Definitions plus counterexamples" "Bound markers"] :metrics ["Source faithfulness" "Applicability" "Exception failures" "Update fan-out" "Task outcome and maintenance cost"] :decision "Do not scale toward the user's 200000-2000000-token target until benefit survives held-out scope and sense variants." :limit "One representative domain corpus first; related outputs from a shared origin do not count as independent sources." :depends ["R4" "R5"])
   (:id "R8" :priority :medium :question "When do static coordination and prefetch help?" :variants ["Sequential workflow" "Deterministic event routing" "Demand retrieval" "Bounded prefetch"] :metrics ["Model calls" "Duplicate effects" "Stale commits" "Crash recovery" "Unused fetch cost" "Decision latency"] :decision "Crash/duplicate/stale replay must pass before model trials. Enable prefetch only for a measured latency benefit within the predeclared full-cost ceiling." :limit "Evaluate routing and prefetch separately; one coordinator before distributed operation." :depends ["R1" "R5" "R6"])
   (:id "R9" :priority :high :question "Does question-based source navigation outperform competent exact search and bounded reads?" :variants ["Exact/lexical lookup plus source baseline" "Question-based tree/graph/semantic routing without generated abstracts" "Same routing with fresh or intentionally stale abstracts" "Same routing with capability/freshness status enabled or disabled"] :metrics ["Correct localization" "Essential dependency coverage" "Source-supported explanation or patch outcome" "Stale authoritative use" "Queries, read bytes, tokens and latency" "Index/abstract construction and update cost"] :decision "Evaluate routing, abstracts and monitoring sequentially, changing one factor at a time. No stale-authoritative edits or fabricated success in deterministic fixtures; model benefit must meet the preregistered quality and full-cost criteria." :limit "One fixed snapshot and bounded task set including known symbols, unknown responsibility, cross-file calls, configuration, dynamic/generated cases, stale abstracts and a small standalone file. Gold evidence defines sufficiency, not a required browsing order." :depends ["R1"])])
 :limits ["No universal optimum, cognitive completeness or internal ASN reasoning is established." "Repository counts and command outcomes are snapshots; old task baselines must be remeasured." "Implementation acceptance and research efficacy are different gates." "This review plans research; it does not allocate API spend or run models."])
