(:decision
  :id "D48"
  :shortcode "D48"
  :title "Universal Sigil Eradication, Native Bare Symbol Architecture, and Zero-Sigil Invariant"
  :status "active"
  :date "2026-09-09"
  :cluster "architecture/governance"
  :deciders ["architect" "planner" "implementer" "auditor"]
  :problemStatement "The @ sigil was historically retained for scoped package identifiers (@genseam/...) and reference annotations (@ref:, @adr:), causing token fragmentation in BPE tokenizers and conceptual ambiguity with language primitives. Autonomous coding agents require a 100% clean, sigil-free cognitive domain where package identities and symbols are bare atomic symbols."
  :decisionDrivers [
    "Zero-Sigil Invariant (c5): complete eradication of @ and # sigils from package names, task labels, and identifiers"
    "Native Bare Symbol Packages: converting all @genseam/asl-* packages to native bare symbols (asl-codec, asl-parser, asl-mem)"
    "Keyword-Based Frame Serialization: replacing @wal:{, @v:{, @n:{, @e:{, @snap:{ with native frames wal:{, v:{, n:{, e:{, snap:{"
    "Agent Identity Normalization: replacing @scout, @coder, @reviewer with native keywords (:scout, :coder, :reviewer)"
    "BPE Token Compression: eliminating the multi-token fragmentation penalty of sigil prefixes across all models"
  ]
  :decision "Permanently eradicate the @ sigil across all package manifests, grammar registries, memory serialization engines, agent identity references, and task ledgers; enforce native bare symbols for all 35 package manifests; update manifest gate to strictly reject @ sigil package names; and establish the Zero-Sigil Invariant (c5)."
  :invariants [
    "c1"
    "c2"
    "c3"
    "c4"
    "c5"
    "d34"
    "d46"
    "d47"
  ]
  :consequences [
    (:consequence :type :positive :details "Guarantees 100% pure native bare symbol packaging across all 35 monorepo packages")
    (:consequence :type :positive :details "Eliminates sigil splitting penalty across BPE tokenizers, saving tokens on every package and symbol reference")
    (:consequence :type :positive :details "Harmonizes memory WAL and snapshot frame formats with pure S-expression conventions")
    (:consequence :type :positive :details "Gate 1 and manifest-gate reject any reintroduction of @ sigils automatically")
    (:consequence :type :negative :details "Requires updating legacy documentation and external references that previously cited @genseam scoped names")
  ]
)
