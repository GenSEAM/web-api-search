(:adr
  :id "ADR-0049"
  :shortcode "d49"
  :title "Ambient Voice and Prompt Transliterator, Context-Primed Homophone Disambiguation, and Canonical ASN Intent Generation"
  :status :active
  :date "2026-09-09"
  :cluster "voice-intelligence"
  :deciders ["architect" "planner" "implementer" "auditor"]
  :problem "Voice STT transcripts contain phonetic distortions and homophone slips ('string start swiss' for 'string-starts-with?', 'asl man' for 'asl-mem'), while raw user prompts lack structured topological boundaries. Agents require deterministic, token-efficient translation of unstructured input into canonical ASN intent expressions without human syntax intervention."
  :drivers [
    "Deterministic Fast-Path: Zero token overhead for already valid ASN, JSON, or YAML"
    "Context-Primed Homophone Disambiguation: Grounded in monorepo symbol registries, shortcodes, and typestates"
    "SLM/LLM Micro-Normalizer: Lightweight prompt-to-intent compiler"
    "Zero-Comment and High SNR: Output pure, executable S-expressions"
  ]
  :decision "Implement a multi-tier transliterator plugin/module (voice/src/transliterator.asl and CLI asl transpile prompt / asl voice transliterate) combining deterministic syntactic parsing, AST-symbol phoneme matching, and SLM contextual intent synthesis into canonical (:intent :goal ... :actionDag ...) frames."
  :invariants ["c1" "c2" "c3" "c4" "c5" "d34" "d44" "d46"]
  :consequences [
    (:pos "Transforms voice dictation and unstructured prompts directly into executable, falsifiable action DAGs")
    (:pos "Eliminates syntax errors and homophone hallucinations from voice inputs")
    (:pos "Supports offline local inference via asl-slm on Apple Silicon M1")
    (:neg "Requires maintaining a compact symbol lexicon for homophone matching")
  ])
