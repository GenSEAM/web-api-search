(:adr
  :id "ADR-0037"
  :shortcode "d37"
  :title "Sovereign ASL Gateway, LMK Key Nexus, and ASN Wire Protocol"
  :status :active
  :date "2026-09-09"
  :cluster "gateway"
  :deciders ["Autonomous Agents and System Architects"]
  :problem "Direct ad-hoc HTTP communication between agents and raw LLM endpoints leads to context pollution, ESH, and credential leakage."
  :drivers ["Decoupled Architecture" "Hierarchical LMK Management" "Sovereign Client Integration" "ASN Wire Protocol" "Strict Disambiguation"]
  :decision "Deploy standalone asl-gateway with hierarchical key resolution and compact ASN tool call negotiation."
  :invariants ["c1" "c3"]
  :consequences [(:pos "Universal token compaction of 50-72% via ASN tool serialization.") (:pos "Total credential airgapping: agents and tasks never touch raw API keys.") (:neg "Requires adhering to strict verification gates")])
