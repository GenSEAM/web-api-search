            "harness/src/stream_demuxer.asl:56"
            "harness/src/context_assembler.asl:53"
            "harness/src/tool-transpiler.asl:16"
          ]
          :evidence "estimate-tokens is copy-pasted across 14 source files and calc-savings across 8 files."
          :remediation "Centralize estimate-tokens and calc-savings in asl-text/src/text.asl or asl-text/tokens.asl.")

        (:finding
          :id "BU-05"
          :severity :moderate
          :name "Duplicate Delimited Substring Extraction"
          :citations [
            "asl/packages/asl-help/src/help_node.asl:62"
            "asl/packages/asl-codec/src/compact_notations.asl:250"
            "mem/src/checkpoint.asl:20"
            "mem/src/pointer_orchestrator.asl:62"
            "mem/src/telemetry.asl:29"
          ]
          :evidence "extract-between is duplicated across 5 files in asl-help, asl-codec, and mem."
          :remediation "Place extract-between into asl-text/src/text.asl as txt/extract-between.")

        (:finding
          :id "BU-06"
          :severity :moderate
          :name "Ad-Hoc String Slicing of S-Expressions in Protocol Translators"
          :citations [
            "harness/src/asn_protocol_agent.asl:90-120"
            "harness/src/prompt_translator.asl:89-126"
            "harness/src/llm_protocol.asl:52-120"
          ]
          :evidence "Protocol translation modules parse S-expressions with manual string search and substring loops instead of using asl-parser or asl-codec AST structures."
          :remediation "Replace fragile manual string search loops with standard S-expression node traversal.")

        (:finding
          :id "BU-07"
          :severity :minor
          :name "Conflicting Implementations of clean-diff-path"
          :citations [
            "asl/packages/asl-sh/src/git_diff.asl:36"
            "asl/packages/asl-sh/src/github.asl:511"
          ]
          :evidence "Two functions share the name clean-diff-path in asl-sh with incompatible prefix and suffix stripping semantics."
          :remediation "Unify into a single robust clean-diff-path function in asl-sh/src/git_diff.asl.")

        (:finding
          :id "BU-08"
          :severity :minor
          :name "Duplicated Vector Math in mem and voice"
          :citations [
            "mem/src/math.asl:42-47"
            "mem/src/store.asl:41-45"
            "mem/src/driver.asl:27"
            "voice/src/speaker_match.asl:53"
          ]
          :evidence "mem/store.asl, mem/driver.asl, and voice/speaker_match duplicate vector dot product, norm, and cosine similarity calculations."
          :remediation "Standardize vector operations inside mem/src/math.asl and export to consumers.")
      ]
    )

    (:section
      :id "anti-overengineering"
      :title "Anti-Overengineering and Adequacy Audit"
      :findings [
        (:finding
          :id "AO-01"
          :severity :critical
          :name "Pure Hardcoded Mock in vdom/src/asn_svg.asl"
          :citations [
            "vdom/src/asn_svg.asl:126"
            "vdom/tests/asn-svg-test.asl:4"
          ]
          :evidence "asn-to-svg in vdom does not parse input ASN; if the string starts with (:svg, it returns a hardcoded 320x320 rectangle XML, tested only by its own test."
          :remediation "Delete vdom/src/asn_svg.asl and test; route all ASN-to-SVG transpilation through production compiler in asl-codec/src/svg-transpile.asl.")

        (:finding
          :id "AO-02"
          :severity :critical
          :name "Simulated Mocks in harness/src/engine_gateway.asl"
          :citations [
            "harness/src/engine_gateway.asl:42-60"
            "harness/src/context_assembler.asl:228"
          ]
          :evidence "dispatch-tier-0-ast, dispatch-tier-1-mem, and dispatch-tier-2-web have zero module imports and return synthetic mock strings during context assembly."
          :remediation "Wire engine_gateway to invoke real queries against asl-intel, mem/vfs, and web-api-search, or eliminate gateway indirection.")

        (:finding
          :id "AO-03"
          :severity :critical
          :name "Foreign TikTok Filter Subsystem in pack/src/targets/lashes.asl"
          :citations [
            "pack/src/targets/lashes.asl:1"
            "pack/src/targets/lashes.asl:595"
          ]
          :evidence "pack/src/targets/lashes.asl is a 595-line camera shader and landmark generator for TikTok Effect House inside core compiler packaging toolchain."
          :remediation "Evict lashes.asl from core package; relocate to scratch or external application repository.")

        (:finding
          :id "AO-04"
          :severity :moderate
          :name "Redundant Facade Indirection in mem/src/tasks.asl"
          :citations [
            "mem/src/tasks.asl:1-230"
            "mem/src/tasks_store.asl:1"
            "mem/src/tasks_dag.asl:1"
            "mem/src/tasks_lease.asl:1"
          ]
          :evidence "mem/src/tasks.asl is a 230-line pure facade containing 45 one-line forwarding functions delegating to tasks_store, tasks_dag, and tasks_lease."
          :remediation "Inline callers to consume tasks_store, tasks_dag, or tasks_lease directly; deprecate pass-through facade.")

        (:finding
          :id "AO-05"
          :severity :moderate
          :name "Premature Polymorphic Wrapper in asl-codec/transpile.asl"
          :citations ["asl/packages/asl-codec/src/transpile.asl:391-470"]
          :evidence "transpile.asl wraps format-specific transpilers solely to repackage distinct result structs into a generic TranspileResult record."
          :remediation "Allow consumers to invoke yt/yaml-to-asn, ct/csv-to-asn, and tt/toml-to-asn directly; eliminate wrapper.")

        (:finding
          :id "AO-06"
          :severity :moderate
          :name "Stale Duplicate File pack/src/ffi-linker.asl"
          :citations [
            "pack/src/ffi-linker.asl:1"
            "pack/src/ffi_linker.asl:1"
          ]
          :evidence "pack/src contains both ffi-linker.asl (2342 bytes) and ffi_linker.asl (2828 bytes) declaring the same module."
          :remediation "Delete pack/src/ffi-linker.asl; retain pack/src/ffi_linker.asl.")

        (:finding
          :id "AO-07"
          :severity :moderate
          :name "Decoupled Speculative Packages with Zero Monorepo Consumers"
          :citations [
            "asl-quantum/src/quantum.asl:1"
            "asl-arduino/src/gpio.asl:1"
            "asl-contracts/src/spec.asl:1"
            "asl-gateway/src/server.asl:1"
            "crawler/src/crawler.asl:1"
            "editorial-matrix/src/article-projector.asl:1"
          ]
          :evidence "Six packages have zero production callers across agent, harness, mem, or asl. editorial-matrix contains launchd plists with hardcoded local paths."
          :remediation "Decouple non-core experimental packages or mark explicitly as speculative research plugins.")
      ]
    )

    (:section
      :id "proactive-hardening"
      :title "Proactive Hardening Opportunities"
      :findings [
        (:finding
          :id "PH-01"
          :severity :critical
          :name "O(N*M) Character Encoding and Excessive Allocations in vfs-cas-hash"
          :citations [
            "mem/src/vfs.asl:67-115"
            "mem/src/simhash.asl:10"
            "mem/src/structural_editor.asl:19"
            "mem/src/subtree_cache.asl:19"
          ]
          :evidence "char-to-code performs string-index-of across a 95-character string literal for every character. For a 50KB file, vfs-cas-hash runs string-chars (allocating 50,000 strings), 50,000 linear searches, and 50,000 intermediate 8-element lists in the fold accumulator."
          :remediation "Add native string-char-code-at primitive to asl/tools/asl.c and prelude.asn. Update vfs-cas-hash and simhash to use integer character codes directly.")

        (:finding
          :id "PH-02"
          :severity :moderate
          :name "Linear Cascades of string-replace in Text Cleaning"
          :citations [
            "mem/src/simhash.asl:73-95"
            "harness/src/normalizer.asl:50-60"
          ]
          :evidence "strip-punct executes 20 sequential full-string copies via nested string-replace calls for every text snippet. normalize-asl-fragment executes 7 full-string replacements."
          :remediation "Implement single-pass character filter in asl-text using string-chars and a set or predicate.")

        (:finding
          :id "PH-03"
          :severity :moderate
          :name "Redundant Memory Chunk Constructors"
          :citations [
            "mem/src/hydration.asl:26"
            "mem/src/amnesia.asl:44"
            "mem/src/view_layer.asl:18"
            "mem/src/summary_search.asl:20"
          ]
          :evidence "make-memory-chunk is identically defined across 4 separate files in mem/src/."
          :remediation "Define make-memory-chunk once in mem/src/records.asl or mem/src/store.asl and export.")

        (:finding
          :id "PH-04"
          :severity :minor
          :name "Single-Line Integer-to-String Wrappers"
          :citations [
            "pack/src/targets/preview_server.asl:9"
            "pack/src/targets/lashes.asl:31"
            "pack/src/targets/preview.asl:8"
          ]
          :evidence "int-to-string is re-declared in 3 target files solely to call string-from-int64 n."
          :remediation "Call string-from-int64 or str directly, eliminating local wrapper functions.")
      ]
    )
  ]

