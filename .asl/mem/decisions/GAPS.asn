            "asl/packages/asl-codec/src/yaml-transpile.asl:43"
            "asl/packages/asl-codec/src/transpile.asl:42"
            "asl/packages/asl-codec/src/transpile.asl:49"
            "asl/packages/asl-codec/src/csv-transpile.asl:37"
            "asl/packages/asl-codec/src/csv-transpile.asl:44"
            "asl/packages/asl-codec/src/svg-transpile.asl:39"
            "asl/packages/asl-codec/src/core/asn.asl:70"
            "asl/packages/asl-codec/src/toml-transpile.asl:35"
            "asl/packages/asl-codec/src/toml-transpile.asl:43"
            "asl/packages/asl-cli/src/asn_cmd.asl:19"
            "harness/src/config.asl:334"
            "harness/src/deps.asl:77"
          ]
          :evidence "strip-quotes is independently implemented 9 times and strip-colon 5 times across 4 packages."
          :remediation "Centralize strip-quotes and strip-colon in asl-text/src/string.asl and delete all 14 duplicate functions.")

        (:finding
          :id "BU-04"
          :severity :moderate
          :name "Duplicate BPE Token Estimation and Compaction Math"
          :citations [
            "asl/packages/asl-codec/src/yaml-transpile.asl:18"
            "asl/packages/asl-codec/src/yaml-transpile.asl:26"
            "asl/packages/asl-codec/src/toml-transpile.asl:18"
            "asl/packages/asl-codec/src/toml-transpile.asl:26"
            "asl/packages/asl-codec/src/csv-transpile.asl:20"
            "asl/packages/asl-codec/src/csv-transpile.asl:28"
            "asl/packages/asl-codec/src/svg-transpile.asl:22"
            "asl/packages/asl-codec/src/svg-transpile.asl:30"
            "asl/packages/asl-codec/src/asnl.asl:33"
            "asl/packages/asl-codec/src/asnl.asl:41"
            "asl/packages/asl-codec/src/sh-transpile.asl:21"
            "asl/packages/asl-codec/src/sh-transpile.asl:29"
            "asl/packages/asl-codec/src/transpile.asl:25"
            "asl/packages/asl-codec/src/transpile.asl:33"
            "agent-core/src/prompt_tree.asl:31"
            "asl/packages/asl-plugin/src/dynamic_tool.asl:182"
            "asl/packages/asl-sh/src/core/process.asl:145"
