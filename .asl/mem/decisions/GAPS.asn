        (:finding
          :id "INV-01"
          :severity :critical
          :invariant :C1
          :name "Semicolon Line Comments in Pure ASL session_test.asl Blocking Gate 2"
          :citations [
            "asl/packages/asl-sh/tests/session_test.asl:87"
            "asl/packages/asl-sh/tests/session_test.asl:90"
            "asl/packages/asl-sh/tests/session_test.asl:93"
            "asl/packages/asl-sh/tests/session_test.asl:96"
            "asl/packages/asl-sh/tests/session_test.asl:100"
            "asl/packages/asl-sh/tests/session_test.asl:106"
            "asl/packages/asl-sh/tests/session_test.asl:111"
          ]
          :evidence "Lines 87-111 contain seven semicolon line comments (;; Step 1: 5s idle -> active, NONE, etc.) violating pure ASL zero-comment invariant C1 and causing asl audit gates Gate 2 to abort immediately across the entire monorepo."
          :remediation "Strip all semicolon comments from session_test.asl and replace with self-documenting assertion failure messages.")

        (:finding
          :id "INV-02"
