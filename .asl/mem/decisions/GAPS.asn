          :citations [
            "agent-core/src/tasktypes.asl:6"
            "agent-core/src/clarify.asl:15"
            "agent-core/src/dag.asl:15"
          ]
          :evidence "TaskState defined in 3 different files with diverging, incompatible variants."
          :remediation "Retain single TaskState enum in tasktypes.asl, import into clarify.asl, and rename dag.asl variant to DagNodeState.")

        (:finding
          :id "BND-03"
          :severity :critical
          :invariant :C3
          :name "Divergent Conflicting TaskRecord Definitions across 3 Modules"
          :citations [
            "agent-core/src/tasktypes.asl:37"
            "agent-core/src/clarify.asl:26"
            "agent-core/src/threads.asl:31"
          ]
          :evidence "TaskRecord defined 3 times with divergent field types (TaskPriority vs Str, state vs state enum)."
          :remediation "Delete duplicate declarations in clarify.asl and threads.asl; import canonical TaskRecord from tasktypes.asl.")

        (:finding
          :id "BND-04"
          :severity :critical
          :invariant :C3
          :name "56 Duplicate Helper Function Implementations in mem Package"
          :citations [
            "mem/src/subtree_cache.asl:19"
            "mem/src/vfs.asl:67"
            "mem/src/structural_editor.asl:19"
            "mem/src/simhash.asl:10"
            "mem/src/driver.asl:27"
            "mem/src/store.asl:45"
            "mem/src/math.asl:42"
            "mem/src/telemetry.asl:29"
            "mem/src/pointer_orchestrator.asl:62"
            "mem/src/checkpoint.asl:20"
            "mem/src/context_scoring.asl:21"
            "mem/src/bm25.asl:31"
            "mem/src/summary_search.asl:50"
            "mem/src/token_regex.asl:34"
            "mem/src/egraph.asl:319"
          ]
          :evidence "char-to-code duplicated in 4 files; cosine-similarity in 2; vector-norm in 2; extract-between in 3; fast-ln in 2; make-memory-chunk in 4; strip-punct in 2; tokenize-pattern in 2."
          :remediation "Consolidate text helpers in asl-text and math utilities in mem/src/math.asl.")

        (:finding
          :id "BND-05"
          :severity :moderate
          :invariant :C3
          :name "Private String Escaping and Naive Tokenizers on Wire/AST Boundaries"
          :citations [
            "agent-bus/src/nd_asn.asl:38-46"
            "agent-core/src/protocol.asl:71-108"
            "agent-core/src/clarify.asl:82-112"
            "intel/src/extractor.asl:67"
            "intel/src/xref.asl:25-34"
          ]
          :evidence "Private duplicate string escaping and tokenization functions duplicate canonical foundational packages."
          :remediation "Import canonical string escaping from asl-text and tokenizer from asl-parser.")

        (:finding
          :id "BND-06"
          :severity :moderate
          :invariant :C3
          :name "Duplicate Helper Functions across pack, vdom, and voice"
          :citations [
            "pack/src/targets/preview.asl:8"
            "pack/src/targets/preview_server.asl:9"
            "pack/src/targets/kotlin.asl:130"
            "vdom/src/html.asl:229"
            "vdom/src/vdom.asl:51"
            "voice/src/speaker_match.asl:88"
            "voice/src/audio_stream.asl:17"
          ]
          :evidence "int-to-string duplicated across 3 files; vdom duplicates element helpers; voice duplicates drop-samples."
          :remediation "Remove redundant private definitions and import canonical implementations.")

        (:finding
          :id "BND-07"
          :severity :moderate
          :invariant :C3
          :name "Vacuous (assert true) Assertions in browser-bridge-test"
          :citations ["agent-bus/tests/browser-bridge-test.asl:61-63"]
          :evidence "Three consecutive (assert true) statements violate Ground Truth mandate forbidding vacuous assertions."
          :remediation "Replace with concrete assertions validating CORS response headers.")

        (:finding
          :id "BND-08"
          :severity :minor
          :invariant :C3
          :name "Orphan Duplicate Standalone Test File in pack"
          :citations ["pack/tests/standalone.test.asl:1"]
          :evidence "Un-migrated duplicate of standalone_test.asl with illegal dot in filename and duplicate string-equals? helper."
          :remediation "Delete pack/tests/standalone.test.asl.")
      ]
    )

    (:section
      :id "manifests"
      :title "Package Manifests, Grammar Registries & Architectural Drift"
      :findings [
        (:finding
          :id "MAN-01"
          :severity :critical
          :invariant :gates
          :name "Missing manifest.asn and Non-Standard Package Headers in asl/web"
          :citations [
            "asl/web/src/App.asl:1"
            "asl/web/src/components/InBrowserCompanion.asl:1"
            "asl/web/package.asn:19"
          ]
          :evidence "asl/web lacks manifest.asn entirely and uses invalid (package :name ...) headers instead of canonical (module ...) forms."
          :remediation "Create asl/web/manifest.asn and standardize source files to canonical (module ...) syntax.")

        (:finding
          :id "MAN-02"
          :severity :critical
          :invariant :gates
          :name "Non-Standard :exports Keyword in Module Headers"
          :citations [
            "agent-core/src/dag_merge.asl:3"
            "agent-core/src/prompt_tree.asl:3"
            "agent-bus/src/mvcc_bus.asl:3"
            "mem/src/speculative_fork.asl:3"
          ]
          :evidence "Modules use :exports [...] instead of canonical :x [...], causing all functions to be treated as private/unexported."
          :remediation "Replace :exports with canonical :x.")

        (:finding
          :id "MAN-03"
          :severity :critical
          :invariant :gates
          :name "Harness Manifest Module Registry Case Mismatch and Missing Entries"
          :citations [
            "harness/manifest.asn:8"
            "harness/src/amnesia_gate.asl"
          ]
          :evidence "33 modules declared in kebab-case while on-disk files use snake_case; 8 on-disk modules completely omitted."
          :remediation "Synchronize harness/manifest.asn with actual on-disk module file names.")

        (:finding
          :id "MAN-04"
          :severity :moderate
          :invariant :gates
          :name "Severely Incomplete :modules Manifest Declarations across agent, agent-bus, and mem"
          :citations [
            "agent/manifest.asn:1-6"
            "agent-bus/manifest.asn:6"
            "mem/manifest.asn:7"
          ]
          :evidence "agent/manifest.asn omits :modules array; agent-bus declares only 2 of 14; mem declares only 10 of 39."
          :remediation "Catalog all active production modules under :modules in package manifests.")

        (:finding
          :id "MAN-05"
          :severity :moderate
          :invariant :gates
          :name "Submodule Function Exports Omitted from Package Manifests"
          :citations [
            "asl/packages/asl-codec/manifest.asn:8"
            "asl/packages/asl-sh/manifest.asn:8"
            "asl/packages/asl-gates/manifest.asn:8"
            "asl/packages/asl-codegen/manifest.asn:8"
          ]
          :evidence "Manifests only list entrypoint exports, leaving hundreds of public submodule functions unindexed in the manifest."
          :remediation "Update :exports in package manifests to index all exported public submodule functions.")

        (:finding
          :id "MAN-06"
          :severity :critical
          :invariant :gates
          :name "Desynchronized Phantom Symbols in grammar.asn Registries"
          :citations [
            "agent-core/grammar.asn:27-162"
            "intel/grammar.asn:110-285"
            "voice/grammar.asn:1"
            "vdom/grammar.asn:1"
            "browser-plugin/grammar.asn:1"
          ]
          :evidence "Over 150 phantom symbols in grammar.asn that are never defined in src/, and dozens of defined src/ symbols missing from grammar.asn."
          :remediation "Regenerate grammar.asn files to establish exact 1:1 synchronization with actual source exports.")

        (:finding
          :id "MAN-07"
          :severity :critical
          :invariant :gates
          :name "Ghost Alien Re-Exports and Export Symbol Mismatches"
          :citations [
            "intel/src/intel.asl:14-17"
            "mem/src/tasks.asl:3-30"
            "mem/src/vfs_fork.asl:9"
          ]
          :evidence "intel.asl exports 9 alien symbols imported from other modules; tasks.asl and vfs_fork.asl have export identifier name mismatches."
          :remediation "Define pass-through functions in intel.asl and align export names with defined identifiers in tasks.asl and vfs_fork.asl.")
      ]
    )

    (:section
      :id "stubs"
      :title "Dead Code, Stubs, Mocks & Simulation Debt"
      :findings [
        (:finding
          :id "STUB-01"
          :severity :critical
          :invariant :gates
          :name "Mock Fallback Mode in Host Projection bin/asl-gateway"
          :citations ["bin/asl-gateway:163-345"]
          :evidence "bin/asl-gateway implements an active mock provider: return { mode: mock, url: null, provider: mock-local }, violating ground-truth invariant."
          :remediation "Remove mock fallback mode from bin/asl-gateway; fail fast with clear diagnostic error when credentials are not configured.")

        (:finding
          :id "STUB-02"
          :severity :critical
          :invariant :gates
          :name "Deterministic Simulation Stubs in Agent Subsystem"
          :citations [
            "agent/src/ffi.asl:73-78"
            "agent/src/computer_use.asl:124-138"
            "agent/src/eddie.asl:64-79"
            "intel/src/health.asl:517"
            "intel/src/preload.asl:227"
          ]
          :evidence "host-call in ffi.asl returns synthetic echo string; execute-computer-action explicitly returns simulated receipts; intel-health and intel-preload construct empty graphs."
          :remediation "Wire intel-health and intel-preload to ingest real workspace graphs. Replace mock execution with real substrate operations.")

        (:finding
          :id "STUB-03"
          :severity :moderate
          :invariant :gates
          :name "Pseudo-Mock Single-Child Parser in vdom/src/asn_svg.asl"
          :citations ["vdom/src/asn_svg.asl:160"]
          :evidence "parse-all-children dynamically extracts at most one child element per tag type, dropping subsequent instances via ad-hoc string splitting."
          :remediation "Transpile ASN SVG forms using canonical S-expression AST parser from asl-codec/asl-parser.")

        (:finding
          :id "STUB-04"
          :severity :minor
          :invariant :gates
          :name "Unreferenced Dead Private Helper Functions in Core Modules"
          :citations [
            "asl/packages/asl-lint/src/incongruity.asl:88"
            "asl/packages/asl-sh/src/github.asl:224-490"
            "asl/packages/asl-parser/src/ast.asl:138"
            "asl/packages/asl-checker/src/unify.asl:72"
          ]
          :evidence "Internal helper functions unexported and never called within the package."
          :remediation "Remove dead helper functions or export them with unit test coverage.")
      ]
    )
  ]

