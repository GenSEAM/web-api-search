      :dependencyClasses [
    (:class :seed :policy "Record owned C stage0 source, build tools and digests; seed is allowed only to create the first native ASL compiler/evaluator.")
    (:class :build :policy "Stage1 and stage2 ASL native tool compile compiler/evaluator to native artifacts and WASM; stage2 rebuild does not invoke seed or a third-party compiler/runtime.")
    (:class :deployed :policy "Native check/test/RPC and optional local pooling require no wasmtime, JSC, Node or system compiler; an own statically linked OS/ABI adapter is allowed and declared.")
    (:class :validation :policy "An independent conforming WASM runtime may validate artifacts but is never required by the deployed CLI.")
    (:class :substrate :policy "Machine, OS/ABI and declared WASM imports are explicit boundaries; independence does not mean no execution substrate.")
  ]
      :settledChoices [
    (:choice :id compatibility :value "Breaking changes permitted; canonical semantic contracts determine correctness.")
    (:choice :id nativeArtifact :value "ASL compiler emits native executable images (ELF/Mach-O/PE), ABI/linking support and WASM; the autonomous chain regenerates owned OS adapters from source, never a carried precompiled blob. Owned C is a valid declared source boundary only where the self-hosted chain can rebuild it; otherwise use ASL-owned low-level adapter source.")
    (:choice :id pooling :value "Keep optional local serve using the identical one-shot CAS/session contract; never required for correctness.")
    (:choice :id dormantPackages :value "Retain as experimental/no acceptance weight; asl-lint remains required; no unrequested broad package/artifact deletion.")
    (:choice :id ruleSource :value "All eighteen rule dispositions and eleven revisions flow through canonical rules/document sources and generated projections in Task43707/Task43806.")
  ]
      :consequences [
    (:pos "Honest semantic failure and independently bound evidence replace output labels and assertion-count parity.")
    (:pos "Owned native tooling closes its rebuild chain while retaining a portable WASM backend and explicit Windows contract.")
    (:pos "Payload, session and tier budgets are measured engineering targets with semantic preservation, not universal efficacy claims.")
    (:neg "ASL native code generation and explicit OS adapters are substantial work; architecture is settled but their behavioral acceptance remains unestablished.")
    (:neg "Read-only conceptual findings do not imply current runtime completion; each verifier must first establish its intended baseline failure.")
  ])
