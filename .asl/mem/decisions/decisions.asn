        (:pos "Improves agent reasoning accuracy by embedding self-documenting semantics into task IDs")
        (:pos "Guarantees zero path collisions in git branches, URLs, and filesystem task stores")
        (:neg "Requires planners to select standard morphemes from the canonical 30-word registry")
