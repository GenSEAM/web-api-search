    (:adr
      :id "D43"
      :shortcode "D43"
      :title "Harness Epistemic Paradigm, Action Ontology, Judicious Autonomy, and Task Variance Leeway"
      :status :active
      :date "2026-09-09"
      :cluster "architecture/harness"
      :deciders ["Architect" "Planner" "Implementer" "Auditor"]
      :problem "Autonomous coding agents frequently suffer from ceremonial paralysis on minor bugfixes or unbounded scope creep on complex tasks."
      :drivers ["Mental Compass (4 Axioms)" "Dual-Process Fast-Path vs Full-Rigor" "Task Variance Leeway" "Resident Token Profiler"]
