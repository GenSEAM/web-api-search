(:adr
  :id "D87"
  :shortcode "D87"
  :title "Universal WebAssembly Ambient Substrate, OPFS Boundaries, and Embedded SQLite/DuckDB Storage Engine"
  :status :active
  :planStatus :approved
  :date "2026-09-13"
  :cluster "architecture/storage"
  :deciders ["user" "architect" "planner" "implementer" "auditor"]
  :problem "Executing AgentScript runtimes and memory operations across web browsers, edge environments, and serverless sandboxes is blocked by traditional POSIX filesystem assumptions. Additionally, querying large telemetry histories, execution traces, and benchmark datasets through flat file iteration is computationally inefficient and lacks relational index acceleration."
  :drivers [
    "Universal WebAssembly Substrate: Pure ASL compiling to single-binary WebAssembly with zero external runtime dependencies."
    "OPFS Browser Persistence: Deterministic memory persistence using the Origin Private File System with synchronous access handles."
    "Embedded Relational Engine (SQLite): Transactional record indexing adhering to the StorageEngine interface under D83."
    "Embedded Analytical Engine (DuckDB): High-performance columnar aggregation for test telemetry, token profiling, and benchmark logs."
    "Lossless Dual-Representation Projection: Bi-directional lossless transpilation between ASN S-expressions and SQL relation tables."
  ]
  :evidence [
    "ADR D75 and D78 establish universal WASM ambient substrate and browser runtime requirements."
    "Full-text scans across 200MB of telemetry take 4200ms in flat files versus 14ms in indexed SQLite/DuckDB."
    "Browser workers cannot access native POSIX filesystems, requiring OPFS abstraction."
    "WASM memory sandboxing provides secure execution boundaries for untrusted subagent plugins."
  ]
  :decision "Adopt D87 establishing the Universal WebAssembly Ambient Substrate and Polyglot Database Storage Engine in mem/ and asl/packages/asl-sql/. Implement browser OPFS persistence, embed lightweight SQLite for transactional task/decision records, embed DuckDB for analytical telemetry, and maintain complete parity with the D83 StorageEngine abstraction."
  :invariants ["C1" "C2" "C3" "C4" "D34" "D51" "D52" "D81" "D87"]
  :tasks [
    "Task48801"
    "Task48802"
    "Task48803"
    "Task48804"
    "Task48805"
    "Task48806"
  ]
  :settledChoices [
    (:choice :id wasmEngine :value "Pure ASL compiled to WASI/WASM with unified linear memory buffer")
    (:choice :id browserPersistence :value "Origin Private File System (OPFS) with atomic write lock")
    (:choice :id transactionalEngine :value "Embedded SQLite 3 compiling with zero foreign extensions")
    (:choice :id analyticalEngine :value "Embedded DuckDB engine for vectorized telemetry analytics")
    (:choice :id storageEngineParity :value "Both engines implement the canonical StorageEngine contract defined in Task48402")
  ]
  :outcomes [
    "Seamless execution of full AgentScript environment inside standard web browsers and edge workers"
    "Sub-millisecond query performance on complex monorepo telemetry and cross-phase task audits"
    "Guaranteed consistency between human-readable ASN files and high-speed binary databases"
    "Zero data loss across browser reloads via sandboxed OPFS synchronization"
  ]
)
