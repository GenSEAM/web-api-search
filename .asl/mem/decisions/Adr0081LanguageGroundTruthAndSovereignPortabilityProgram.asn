(:adr
  :id "ADR-0081"
  :shortcode "D81"
  :title "Owned ASL Semantics, Portable Native/WASM Tooling and Autonomous Self-Hosting"
  :status :active
  :planStatus :approved
  :date "2026-09-11"
  :cluster "architecture/language-runtime-governance"
  :deciders ["user" "planner" "independentVerifier"]
  :review ".asl/mem/reviews/D81ConceptReview.asn"
  :settlement ".asl/mem/reviews/D81PlanSettlement.asn"
  :problem "The original conceptual audit found unsupported efficacy claims, weak gate contracts and an incomplete foreign-binary independence definition. Historical numerical diagnostics remain in the review; they are not newly measured facts or current completion receipts."
  :drivers ["Semantics first: independently specified values, errors and effects precede portable/self-hosted replacement; compatibility may be broken to simplify the owned language." "Optimize observed cost per correct task; stable reusable base, relevant retrieval and measured compression are complementary, provider-scoped choices." "Use bounded progressive retrieval with global batch budgets and versioned continuation; preserve semantic evidence through recoverable references." "Separate format reversibility from lossy output omission; no universal token-compression accuracy penalty or zero-escaping claim." "Portability includes explicit Darwin/Linux/Windows native adapters and WASM host capabilities; POSIX or a WASM file alone does not prove it." "Keep the chosen CLI product boundary and optional local pooling host; no required MCP or third-party runtime for the deployed native tool." "Generate truthful supported-client/tier projections from canonical rules; preserve host permission authority and separate payload/session budgets." "Separate implementation author and final verifier mechanically; public development tests remain useful while held-out acceptance and runner configuration are protected." "Autonomous ASL compiler/evaluator rebuild closure and owned native deployed artifacts are the self-hosting end state; stage0 seed, own OS adapter and independent WASM validation host are explicitly separate dependencies."]
  :paradigmRevisions [
    (:paradigm :n 1 :verdict :amend :by "Optimize measured cost per correct task; cache stability and precision complement density rather than making it universally third-order." :tasks ["Task43902" "Task44106"])
    (:paradigm :n 2 :verdict :amend :by "Choose ASL on engineering grounds; validate syntax and semantic round trips; no guaranteed parse validity or invented measured ASL penalty." :tasks ["Task43801" "Task43806" "Task44001"])
    (:paradigm :n 3 :verdict :amend :by "Retire universal one-to-two-token primitive claims; use conventional meaningful names and contextual tokenizer evidence." :tasks ["Task43806" "Task43807"])
    (:paradigm :n 4 :verdict :amend :by "Withdraw universal 72-percent/64.7-percent ceiling/zero-escaping claims; regenerate scoped codec metrics with typed round-trip evidence." :tasks ["Task43806" "Task43903"])
    (:paradigm :n 5 :verdict :amend :by "Remove unconditional zero-comment performance/reliability invariant; concise useful rationale is allowed; generated documentation has one source and consistency checks." :tasks ["Task43707" "Task43806"])
    (:paradigm :n 6 :verdict :amend :by "Mechanical writer/verifier boundaries and justified profiles; no universal persona-zero or exact-role-count optimum." :tasks ["Task44105" "Task44110"])
    (:paradigm :n 7 :verdict :confirm :by "Remove unsupported numerical SNR invariant; retain qualitative relevance; token counts alone do not define semantic signal." :tasks ["Task43707" "Task43806"])
    (:paradigm :n 8 :verdict :amend :by "Keep chosen CLI integration boundary and supported-client contracts; MCP removal is a product choice, not experimentally compelled." :tasks ["Task43701" "Task43703"])
    (:paradigm :n 9 :verdict :amend :by "Separate payload/session/tier budgets, measure pinned tokenizer and preserve mandatory semantics; budgets are engineering targets." :tasks ["Task43702" "Task43704" "Task44109"])
    (:paradigm :n 10 :verdict :confirm :by "Keep progressive retrieval and batches with truthful capabilities, bounds and recoverable evidence; no blanket superiority claim." :tasks ["Task43804" "Task43808" "Task43809" "Task44201" "Task44202" "Task44203" "Task44204" "Task44205" "Task44206" "Task44207" "Task44208" "Task44209" "Task44210" "Task44401" "Task44402" "Task44403" "Task44404" "Task44405" "Task44406" "Task44501" "Task44502" "Task44503" "Task44504" "Task44601" "Task44602" "Task44603" "Task44604" "Task44605" "Task44606" "Task44701" "Task44702" "Task44703" "Task44704" "Task45401" "Task45402" "Task45403" "Task45404" "Task45405" "Task45406" "Task45501" "Task45502" "Task45503" "Task45504" "Task45505" "Task45506" "Task45601" "Task45602" "Task45603" "Task45604" "Task45701" "Task45702" "Task45703" "Task45704" "Task45705" "Task45801" "Task45802" "Task45803" "Task45804" "Task45901" "Task45902" "Task45903" "Task45904" "Task45905" "Task45906" "Task46001" "Task46002" "Task46003" "Task46004" "Task46005" "Task46006" "Task46101" "Task46102" "Task46103" "Task46104" "Task46105" "Task46106" "Task46201" "Task46202" "Task46203" "Task46204" "Task46205" "Task46206" "Task46301" "Task46302" "Task46303" "Task46304" "Task46305" "Task46401" "Task46402" "Task46403" "Task46404" "Task46405" "Task46406" "Task46501" "Task46502" "Task46503" "Task46504" "Task46505" "Task46506" "Task46601" "Task46602" "Task46603" "Task46604" "Task46605" "Task46701" "Task46702" "Task46703" "Task46704" "Task46705" "Task46706" "Task46801" "Task46802" "Task46803" "Task46804" "Task46805" "Task46901" "Task46902" "Task46903" "Task46904" "Task46905" "Task46906" "Task46907" "Task47001" "Task47002" "Task47003" "Task47004" "Task47005" "Task47006" "Task47007" "Task47101" "Task47102" "Task47103" "Task47201" "Task47202" "Task47203" "Task47204" "Task47205" "Task47206" "Task47207" "Task47301" "Task47302" "Task47303" "Task47304" "Task47401" "Task47402" "Task47403" "Task47404" "Task47501" "Task47502" "Task47503" "Task47504" "Task