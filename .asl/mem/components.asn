        "render_skill_asn"
        "check_skill_asn"
        "inject_directive"
        "write_skill_md"]
      :invocationContexts [
        (:context :trigger "Rule edit" :caller "maintainer" :slaMs 500 :fallback ":drift-detected-exit-1")
        (:context :trigger "Install on a new machine" :caller "scripts/install.sh" :slaMs 500 :fallback ":render-from-source")]
      :dependencies []
