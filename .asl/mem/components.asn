(:components
  :version "1.0.0"
  :description "Canonical System Component Registry for ASN Translator, Resident Runtime, Calibration Stand, and Client Adapters"
  :registry [
    (:component
      :id "comp-prompt-translator-core"
      :name "Prompt Translator Core Engine"
      :category :coreEngine
      :purpose "Transforms unstructured and code-switching natural language prompts into high-density structured ASN with reasoning frames and graceful fallback"
      :files ["harness/src/prompt_translator.asl"]
      :targetSymbols [
        "PromptTranslationConfig"
        "AsnPromptPayload"
        "PromptTranslationResult"
        "AsnReasoningFrame"
        "translate-prompt"
        "make-translation-config"
        "is-asn-compatible-model?"
        "estimate-token-savings"]
      :invocationContexts [
        (:context :trigger "Pre-dispatch step preprocessing" :caller "step-middleware" :slaMs 0.2 :fallback ":incompatible-model-fallback")
        (:context :trigger "Calibration stand evaluation" :caller "model-calibration" :slaMs 0.2 :fallback ":incompatible-model-fallback")]
      :dependencies []
      :invariants [C1 C2 D34 D51]
      :status :active)

    (:component
      :id "comp-resident-daemon-engine"
      :name "Sovereign Resident Daemon Engine"
      :category :residentLayer
      :purpose "In-memory sovereign daemon handling high-throughput IPC/socket batch RPC commands with sub-millisecond dispatch"
      :files ["asl/bin/asl-engine"]
      :targetSymbols [
        "SovereignEngine.dispatch_op"
        "SovereignEngine.run_serve"]
      :invocationContexts [
        (:context :trigger "Unix domain socket RPC" :caller "asl CLI" :slaMs 0.3 :fallback "execute_batch_inline")]
      :dependencies ["comp-rpc-grammar-contract"]
      :invariants [C1 C2 D34]
      :status :superseded
      :supersededBy "comp-attention-prosthesis-ledger"
      :note "mem/src/daemon*.asl removed 2026-09-11; the C engine asl/tools/asl.c serves RPC; resident mode --serve pending Task43808 decision")

    (:component
      :id "comp-cli-rpc-router"
      :name "CLI Batch and RPC Router"
      :category :residentLayer
      :purpose "Top-level command line entrypoint routing batch and rpc invocations to resident socket daemon with automatic inline fallback"
      :files ["asl/asl"]
      :targetSymbols [
        "execute_batch_inline"
        "socket_send_recv"
        "get_socket_path"]
      :invocationContexts [
        (:context :trigger "Terminal invocation asl rpc" :caller "developer / agent CLI" :slaMs 0.5 :fallback "inline awk engine")]
      :dependencies ["comp-resident-daemon-engine"]
      :invariants [C1 C2 D34]
      :status :active)

    (:component
      :id "comp-onion-mw-translator"
      :name "Resident Translator Onion Middleware"
      :category :middleware
      :purpose "Pre-call pipeline middleware normalizing turn input at priority 50 ahead of namespace prompt cache"
      :files ["harness/src/onion/middleware.asl"]
      :targetSymbols [
        "make-resident-translator-middleware"
        "create-harness-pipeline"]
      :invocationContexts [
        (:context :trigger "Pre-call harness turn lifecycle" :caller "OnionPipeline" :slaMs 0.1 :fallback "passthrough")]
      :dependencies ["comp-prompt-translator-core"]
      :invariants [C1 C2 D34 D51]
      :status :active)

    (:component
      :id "comp-step-mw-interceptor"
      :name "Step Hook Adapter Turn Interceptor"
      :category :middleware
      :purpose "Binds agent conversational turn input to resident prompt translator before step execution"
      :files ["harness/src/step_middleware.asl"]
      :targetSymbols [
        "process-turn-input-with-resident-translator"
        "StepHookAdapter"
        "wire-step-plugins"]
      :invocationContexts [
        (:context :trigger "Step input dispatch" :caller "AgentStepPipeline" :slaMs 0.2 :fallback "raw input")]
      :dependencies ["comp-prompt-translator-core"]
      :invariants [C1 C2 D34 D51]
      :status :active)

    (:component
      :id "comp-model-calibrator"
      :name "Model Capability Calibrator"
      :category :calibration
      :purpose "Benchmarks candidate LLM/SLM models on ASN syntax comprehension, token compaction, reasoning coherence, and safety fallback"
      :files ["harness/src/model_calibration.asl"]
      :targetSymbols [
        "ModelEvaluationResult"
        "CalibrationMatrix"
        "evaluate-single-model"
        "run-calibration-benchmark"
        "find-recommended-model"]
      :invocationContexts [
        (:context :trigger "On-demand model profiling" :caller "test runner / operator" :slaMs 15.0 :fallback "static heuristics")]
      :dependencies ["comp-prompt-translator-core"]
      :invariants [C1 C2 D51]
      :status :active)

    (:component
      :id "comp-prompt-stand-runner"
      :name "Prompt Calibration Stand Runner"
      :category :calibration
      :purpose "Orchestrates multi-model benchmark matrices and renders structured Markdown calibration reports"
      :files ["harness/src/prompt-calibration.asl"]
      :targetSymbols [
        "run-prompt-calibration-stand"
        "format-calibration-markdown"]
      :invocationContexts [
        (:context :trigger "Stand calibration report generation" :caller "operator CLI" :slaMs 50.0 :fallback "raw matrix")]
      :dependencies ["comp-model-calibrator"]
      :invariants [C1 C2 D51]
      :status :active)

    (:component
      :id "comp-calibration-configs"
      :name "Calibration Presets and Stand Configurations"
      :category :calibration
      :purpose "Declarative configuration presets defining model suites, token limits, and task profiles for In-Browser IDE and Copilot"
      :files [
        "harness/calibration/in_browser_ide_config.asn"
        "harness/calibration/in_page_copilot_config.asn"]
      :targetSymbols [
        ":calibration-config"
        ":copilot-stand-config"]
      :invocationContexts [
        (:context :trigger "Stand initialization" :caller "stand runner" :slaMs 0.1 :fallback "default config")]
      :dependencies []
      :invariants [C1 C2 D51]
      :status :active)

    (:component
