      :files ["vdom/src/asn_svg.asl"]
      :targetSymbols [
        "asn-to-svg"
        "SvgDocument"
        "SvgElement"
        "SvgRect"
        "SvgCircle"]
      :invocationContexts [
        (:context :trigger "Visual asset rendering" :caller "VDOM / UI engine" :slaMs 0.5 :fallback "empty svg")]
      :dependencies []
      :invariants [C1 C2 D34 D51]
      :status :active)

    (:component
      :id "comp-visual-diagram-engine"
      :name "ASN Visual Diagram Engine"
      :category :presentation
      :purpose "Renders structured diagram AST nodes into Mermaid diagrams and standalone dark-themed interactive HTML pages"
      :files ["vdom/src/diagram.asl"]
      :targetSymbols [
