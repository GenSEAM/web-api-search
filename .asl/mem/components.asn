    (:component
      :id "comp-harness-grammar-contract"
      :name "Harness Grammar Contract Registry"
      :category :grammarContract
      :purpose "Declarative symbol registry asserting token counts and rationales for all exported harness constructs"
      :files ["harness/grammar.asn"]
      :targetSymbols [
