      :invariants [C1 C2 D51]
      :status :active)

    (:component
      :id "comp-in-ide-view"
      :name "In-Browser AI IDE View"
      :category :webClient
      :purpose "In-browser developer workspace with vibe coding layout, hidden code editor by default, and Addie AI assistant"
      :files ["asl/web/src/views/InIdeView.asl"]
      :targetSymbols [
        "render-in-ide-view"
