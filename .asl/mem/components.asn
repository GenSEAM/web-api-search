      :dependencies ["comp-in-browser-addie"]
      :invariants [C1 C2 D51]
      :status :active)

    (:component
      :id "comp-playground-view"
      :name "Interactive Web Playground View"
      :category :webClient
      :purpose "Interactive sandbox for procedural SVG, web, and game generation with dynamic model switcher and telemetry"
      :files ["asl/web/src/views/PlaygroundView.asl"]
      :targetSymbols [
