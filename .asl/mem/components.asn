    (:component
      :id "comp-universal-asn-codec"
      :name "Universal ASN Codec Transpiler"
      :category :presentation
      :purpose "Bidirectional transpilation between ASN S-expressions and JSON, YAML, or HTML with 72% token compaction"
      :files ["asl/packages/asl-codec"]
      :targetSymbols [
        "json-to-asn"
        "asn-to-json"
        "yaml-to-asn"]
      :invocationContexts [
        (:context :trigger "Wire protocol data conversion" :caller "RPC / Gateway" :slaMs 0.5 :fallback "raw string")]
      :dependencies []
      :invariants [C1 C2 D34 D51]
      :status :active)

    (:component
      :id "comp-in-browser-addie"
      :name "Addie In-Browser Autonomous Agent"
      :category :webClient
      :purpose "WebGPU client-side agent orchestrator using positional 1-2 token grammar with anti-hallucination firewall"
      :files ["asl/web/asl-src/components/InBrowserAddie.asl"]
      :targetSymbols [
        "BrowserAgentModel"
        "PositionalToolkind"
        "AgentExecutionReport"
