  :crossReferences [
    (:link :from "comp-resident-daemon-engine" :to "comp-prompt-translator-core" :kind :parityBinding)
    (:link :from "comp-onion-mw-translator" :to "comp-prompt-translator-core" :kind :middlewareWrapper)
    (:link :from "comp-step-mw-interceptor" :to "comp-prompt-translator-core" :kind :turnAdapter)
    (:link :from "comp-model-calibrator" :to "comp-prompt-translator-core" :kind :benchmarkTarget)
    (:link :from "comp-in-browser-addie" :to "comp-prompt-translator-core" :kind :clientTurnDriver)])
    (:component
      :id "comp-rules-ssot-renderer"
      :name "Rules Single Source of Truth and Surface Renderer"
      :category :governance
      :purpose "asl/grammar/rules.asn is the only hand-edited rule set; scripts/install.sh --render-rules projects it into AGENTS.md, the launcher payload, toolbelt SKILL.md and skill.asn in both trees, the installer template and directive, and installed copies; --check-rules gates identity"
      :files ["asl/grammar/rules.asn" "scripts/install.sh" "AGENTS.md" "asl/asl" ".agents/skills/asl-toolbelt/SKILL.md" ".agents/skills/asl-toolbelt/skill.asn"]
      :targetSymbols [
