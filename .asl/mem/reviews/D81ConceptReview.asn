    :proposal "Extend the existing evaluator parity tasks with a compact normative semantic contract and shared conformance vectors, gated by the currently failing backend-contract check and subsequently by differential values, errors and effect traces rather than counts."
    :gate (:kind :staticPlanContract :cwd "/Users/purplelephant/projects/asex" :command "python3 -c 'from pathlib import Path; import re,sys; paths=sorted(p for p in Path(\".asl/mem/tasks\").glob(\"Phase*.asn\") if re.match(r\"Phase(?:43[6-9]|44[01])\",p.name)); assert len(paths)==6; hits=[(str(p),i,l) for p in paths for i,l in enumerate(p.read_text().splitlines(),1) if re.search(sys.argv[1],l,re.I)]; print(hits); sys.exit(0 if hits else 1)' 'overflow|\\bNaN\\b|Unicode|map.{0,20}order|numeric.{0,20}conform'" :baselineExit 1 :executedPredicates 1 :matches 0)
