(:review
  :id "D81PersistentMemoryResearch20260912"
  :kind :priorArtResearch
  :measuredAt 1789280000000
  :measuredBy "claude-opus-5"
  :question "Does a persistent external memory for agents already exist here, and if so why is it not used."
  :answer "It exists, it is tested, and nothing can call it."

  :implementedAndPassing [
    (:module "mem/src/notes.asl" :assertions 25 :exit 0
      :exports ["NoteRecord" "make-note" "note-is-active?" "note-has-tag?" "note-scope-matches?" "note-matches-query?" "format-note-asn" "project-note-md" "note-promote-to-task" "note-promote-to-adr"]
      :covers "Scoped, tagged, queryable notes that can be promoted into a task or a decision.")
    (:module "mem/src/task_lease.asl" :assertions 100 :exit 0
      :covers "Session leases over tasks: claim, ownership, expiry.")
    (:module "mem/src/task_recovery.asl" :assertions 86 :exit 0
      :exports ["RecoverySnapshot" "recover-task-session" "resume-action-dag" "extract-handoff-state" "verify-checkpoint-integrity"]
      :covers "Crash recovery: snapshot a session, resume its action DAG from the step it reached, verify the checkpoint.")
    (:module "mem/src/amnesia.asl" :assertions 26 :exit 0 :covers "Deliberate forgetting with memory chunks.")
    (:module "mem/src/tasks_store.asl"
      :exports ["TaskRecord" "PostAction" "PostActionQueue" "post-action-enqueue" "post-action-drain" "AnticipatedRisk" "TaskTolerance" "task-has-escalation-trigger?"]
      :covers "Task records with action DAG, step index, session id and handoff context, plus a deferred to-do queue.")
    (:module "mem/src/pointer_orchestrator.asl"
      :exports ["PointerSpec" "deref-pointer" "collapse-pointer" "orchestrate-context-pointers" "total-active-tokens" "is-context-minimal?"]
      :covers "Offloading content out of context behind a pointer and dereferencing it on demand, with an active token count.")
    (:module "mem/src/pointer.asl" :exports ["BlobPointer" "PerceptualFact" "should-offload?" "extract-scalar-fact"]
      :covers "The decision of when a value should leave context, and the extraction of the scalar fact worth keeping.")
    (:module "mem/src/paged.asl" :exports ["MemoryTier" "MemorySegment" "PagedMemoryManager" "should-page?" "touch-segment" "evict-oldest" "load-segment"]
      :covers "Tiered memory with paging and eviction.")
    (:module "mem/src/context_scoring.asl" :exports ["calculate-context-score" "penalize-unreferenced-matches" "evict-below-threshold"]
      :covers "Scoring what is in context and evicting what is not being referenced.")
    (:module "mem/src/spool_search.asl" :exports ["spool-index-lines" "spool-query-bm25" "spool-search-index"]
      :covers "BM25 retrieval over the spool, so a note can be found rather than remembered.")]

  :whyItIsNotUsed [
    (:cause "NoCommandSurface" :severity :critical
      :detail "asl task, asl note and asl doctor are all absent, measured by direct invocation. There is no way to reach any of the modules above from an agent session."
      :note "The project instruction file mandates a six stage lifecycle through asl task spawn, claim, recover and settle. None of those four exist.")
    (:cause "NoInstructionEverMentionsNotes" :severity :critical
      :detail "The string note appears zero times in asl/grammar/rules.asn and zero times in AGENTS.md. No agent is told that a notes ledger exists, what it is for, or when to write into it."
      :note "The anchor rule concedes the gap in its own text: until the ledger ops exist keep the plan in the task file and re-read it.")
    (:cause "Unreachable" :severity :high
      :detail "These modules are among the 270 non test modules that no import reaches and no registry names, measured 2026-09-12.")
    (:cause "FacadeBroken" :severity :high
      :detail "mem/tests/tasks_test.asl exits 1 with zero assertions executed and mem/tests/checkpoint_test.asl fails with ERR_UNBOUND_SYMBOL, so the unified facade over the working sub-modules is itself unverified.")
    (:cause "BufferNeverWritten" :severity :moderate
      :detail ".asl/mem/tasks/InFlight.asn carries :activeTasks [] and has since it was created.")]

  :genuinelyMissing [
    (:gap "FileWorklistWithPerEntryStatus"
      :detail "No structure holds a list of files an agent intends to read or edit with a per entry done or not done mark. Searching the whole memory package for a worklist, a file queue, a to-visit list or an inspected mark found only graph traversal visited sets in egraph.asl and amnesia.asl."
      :consequence "The scout workflow the owner describes, enumerate a package then walk the enumeration, has no structure to hold the enumeration, so it is held in context, which is the problem being solved.")
    (:gap "ScopeLifecycle"
      :detail "Notes carry a scope field and nothing defines the scopes step, task and epic, nor what retires a note when its scope closes.")
    (:gap "NoMeasuredEffect"
      :detail "The expected benefits, fewer hallucinations and better attention, have no measurement anywhere. Task46304 is the instrument that could measure them and it does not exist yet.")]

  :measuredContext [
    (:m "BindingDistance" :detail "Median 53 lines from an alias declaration to its use, ninetieth percentile 232, maximum 1172, with 11.7 percent of 11132 uses beyond 200 lines. A retrieved slice frequently arrives without what defines it.")
    (:m "SymbolSurface" :detail "17112 distinct head symbols across 1512691 tokens, about one distinct symbol per 88 tokens.")]

  :verdict :buildTheSurfaceNotTheEngine
  :summary "The engine for persistent agent memory is written and 237 assertions of it execute cleanly. What is absent is a command surface, an instruction telling an agent it exists, a file worklist, and any measurement of whether it helps.")
