     (:id "d66"
      :sym "runtime/substrate-debloat"
      :title "Runtime Substrate De-Bloat, Netcat Eradication, and Ghost Architecture Pruning"
      :intent "Eliminate netcat nc -U calls from CLI dispatcher, prune simulated Watch Dog APM metrics, purge legacy Node.js fallbacks, and enforce direct deterministic in-process engine execution"
      :outcome "Eliminates 2-second netcat stalls and sandbox permission denials, streamlines process supervision, and restores zero-foreign purity"
      :whyNot ("Fragile netcat socket piping breaks across OS distributions, simulated watchdog creates phantom telemetry, and dead Node code paths violate Zero-Foreign policy")
      :adr ".asl/mem/decisions/D66RuntimeSubstrateDebloatNetcatEradicationAndGhostArchitecturePruning.asn"
      :tasks ["T421NetcatEradication" "T421WatchdogGhostPruning" "T421LegacyNodeAndPowershellPurge" "T421Settle"]
