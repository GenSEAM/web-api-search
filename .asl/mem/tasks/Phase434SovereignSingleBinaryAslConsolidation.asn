    (:task
      :id "Task43403"
      :parentId ""
      :phase "Phase434SovereignSingleBinaryAslConsolidation"
      :title "Compiler, S-Expression Evaluator & Nanosecond Test Telemetry Integration"
      :kind :implementation
      :lane "compiler"
