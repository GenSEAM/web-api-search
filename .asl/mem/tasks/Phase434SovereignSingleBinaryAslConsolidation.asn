      :priority :critical
      :ownerRole "implementer"
      :createdAt 1774000000000
      :updatedAt 1774000000000
      :startedAt 1774000000000
      :completedAt 1774000500000
      :motivation "asl check and asl test must execute with sub-millisecond cold start with zero external dependencies on Python, Node, Rust, or third-party package managers; linking strictly to standard operating system libraries (system libc and macOS system frameworks), completely unifying engine, eval, compiler, evolver, and memory into a single sovereign executable (asl), while cross-platform Linux/Windows/browser execution is sovereignly decoupled via WebAssembly (asl-core.wasm under ADR-0078)."
      :purpose "Incorporate single-pass AST delimiter balance checking, pure S-expression evaluator, and monotonic hardware telemetry directly into unified binary"
      :context "Replaces legacy asl-eval test execution with native C99/ASL evaluation loop"
      :outcomes [
        "Single-pass delimiter checking in under 2ms per file"
        "Nanosecond execution timing and RSS memory tracking"
        "314 test suites executed natively without foreign runtimes"
      ]
      :owns [
        "asl/tools/asl-engine.c"
        "asl/packages/asl-compiler/src/evaluator.asl"
      ]
      :targetSymbols ["NativeSExprEval" "MonotonicTestTelemetry" "FastDelimiterCheck"]
      :relatedSymbols ["D77" "D78" "D79" "C4"]
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D79"]
      :variations ["External runtime evaluation vs embedded S-expression evaluator (chosen: embedded evaluator)"]
      :failureModes ["Incomplete evaluation semantics on complex lexical closures"]
      :adr "D79"
      :decision "D79"
      :why "Native evaluation guarantees cross-platform determinism and eliminates external VM overhead"
      :spec "Integrate S-expression evaluation and test runner into unified binary."
      :acceptanceCriteria ["asl check executes under 5ms" "asl test passes native suites" "Zero external dependencies on Python, Node, Rust, or third-party package managers; linking strictly to standard operating system libraries (system libc and macOS system frameworks), completely unifying engine, eval, compiler, evolver, and memory into a single sovereign executable (asl), while cross-platform Linux/Windows/browser execution is sovereignly decoupled via WebAssembly (asl-core.wasm under ADR-0078)."]
      :stepIndex 0
      :actionDag ["Implement S-expression AST walker" "Wire monotonic timer probes" "Verify with strict-falsify tests"]
      :gate "asl check asl/packages/asl-compiler/src/evaluator.asl && asl test --strict-falsify asl/packages/asl-codegen/tests/emit_wat_test.asl")

