      :actionDag ["Verifier establishes unreachable-site and masked-exit baseline failures." "Specify structured counts and required-site obligations." "Parse trusted runner results and preserve producer status." "Remove substring-based claims." "Independent acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task43605.asl"]
      :verificationCases ["Plant an unreachable required assertion: gate fails for missing site even if repeated loop assertions inflate execution count." "A failed test process with a success-looking banner remains failure; empty suites cannot satisfy nonempty obligations." "Branch-specific suites define explicit coverage obligations; there is no arbitrary aggregate 95-percent allowance."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task43605" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :planApproved
      :stepIndex 0
      :receipts [])

