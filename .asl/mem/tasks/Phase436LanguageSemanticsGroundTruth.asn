    (:task
      :id "Task43603"
      :parentId ""
      :phase "phase-436"
      :title "Make RPC capability and result contracts honest"
      :kind :protocol
      :lane "rpc"
      :state :planned
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789084800000
      :updatedAt 1789133687623
      :motivation "Machine-readable capabilities and explicit failures reduce false confirmation; speed and model benefits remain hypotheses. Verified 2026-09-11: (:exec "echo hi") returns :status ok with no payload; :ERR_UNIMPLEMENTED is never emitted anywhere in asl.c; the rejection code for declared-but-absent ops is :ERR_UNIMPLEMENTED."
      :purpose "Generate implemented capabilities from one RPC registry; unknown operations and unsupported capabilities produce typed errors, truthful per-item results and aggregate failure; no empty success confirms an invented operation."
      :context (:contractRef D81PlanContext)
      :outcomes ["Make RPC capability and result contracts honest"]
      :owns ["asl/tools/asl.c" "asl/grammar/rpc.asn" "asl/grammar/protocol-conformance.asn"]
      :targetSymbols ["execute_single_step"]
      :relatedSymbols ["handle_payload"]
      :invariants ["C2" "D34" "D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task43602"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task43603"
      :actionDag ["Verifier builds registry-driven valid/invalid cases." "Define capability/result schema." "Implement rejection and aggregate status." "Generate registry from reachable implementations." "Independent acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task43603.asl"]
      :verificationCases ["Enumerate the registry and invoke each declared implemented operation with a valid minimal case and an invalid input; validate required payload and error schema." "Unknown op and unavailable op have distinct typed errors; aggregate status reflects failed items; mixed successful and failed batch results preserve identities."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task43603" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :planApproved
      :stepIndex 0
      :receipts [])

