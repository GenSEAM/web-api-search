      :verificationOwns ["tests/acceptance/d81/Task43601.asl"]
      :verificationCases ["Positive cross-module import resolves an exported symbol and checks its value; missing module, missing export and alias collision fail with the specified diagnostic." "An unknown call before a side effect fails and the effect is absent; the oracle checks process status, error identity and source location, not assertion counts." "Independent verifier first executes the positive control and the unknown-symbol case on the captured baseline; parse or fixture errors do not count as the intended failure." "The trusted outer supervisor observes process status, expected probe diagnostics/effects, a passing control and a forced-failing oracle sentinel; unreached assertions or an unknown oracle symbol cannot be accepted as semantic evidence."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task43601" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :planApproved
      :stepIndex 0
