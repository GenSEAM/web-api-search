      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn []
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task43601"
      :actionDag ["Ratify the canonical import/error target contract before production implementation." "Independent verifier freezes hidden oracle vectors, proves outer-supervisor controls and records intended baseline failures." "Author implements public fixtures, binding and loud errors." "Record exposed corpus failures without weakening assertions." "Independent supervised acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
