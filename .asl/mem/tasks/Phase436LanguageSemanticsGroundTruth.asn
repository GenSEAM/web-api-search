      :id "Task43605"
      :parentId ""
      :phase "phase-436"
      :title "Verify assertion reachability and preserve runner failures"
      :kind :gate
      :lane "verification"
      :state :planned
      :priority :high
      :ownerRole "implementer"
      :createdAt 1789084800000
      :updatedAt 1789133687623
