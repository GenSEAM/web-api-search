      :failureModes ["Long code or tabs create page overflow" "Prose line length becomes unreadable" "Fixed navbar covers anchor focus"]
      :additionalRequirements ["Use relative units" "Keep semantic main/section landmarks" "Preserve deep links"]
      :adr "ADR-0082"
      :decision "d82"
      :dependsOn ["Task44801"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44802"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
