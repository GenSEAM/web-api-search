(:taskCollection
  :id "Phase448InstrumentedEditorialWebDesign"
  :createdAt 1789143000000
  :status "planned"
  :priorityOrder 11
  :summary "Instrumented Editorial Web Design: select a coherent ASL visual frame, retain readable width for prose, widen only data-dense surfaces, and derive responsive accessible components from measured design tokens."
  :phase "Phase448InstrumentedEditorialWebDesign"
  :planStatus :approved
  :baseline "2026-09-11: asl/web uses Tailwind 3 with a max-w-6xl shell, Inter/Fira Code, purple/indigo gradients, cosmic/blueprint decoration, rounded-full navigation and repeated rounded cards. No explicit distinction exists between prose measure and data canvas width."
  :designFrame "Instrumented Editorial: calm technical documentation spine plus observatory/workbench surfaces for code, telemetry and live tools."
  :widthPolicy "Primary shell stays max-w-6xl (72rem); only tables, playgrounds and visualizers may opt into a measured wide-surface up to 80rem; prose has a max measure of 68ch and shrinks with the viewport."
  :contracts [
    (:contract :id D82SettledChoices :meaning "The D82 frame, width, palette, geometry and audience choices in ADR-0082 are authoritative for this phase.")
    (:contract :id D82DesignAcceptance :meaning "Independent acceptance observes rendered behavior at 320, 768, 1024 and 1440 CSS pixels, WCAG 2.2 AA text contrast (4.5:1 normal text, 3:1 large text), non-text contrast for required control/state information, plus the stricter local UI-boundary policy, focus/motion states, and exact artifact digests; screenshots or DOM metrics must be reproducible.")
    (:contract :id D82WidthPolicy :meaning "The prose shell remains 72rem with a max 68ch measure that shrinks on narrow viewports; only explicitly marked data surfaces may break out to 80rem; no global width expansion is accepted without evidence.")
    (:contract :id D82SovereigntyEvidence :meaning "Self-hosting, WASM, native and offline capability labels must carry a source/provenance reference and a state of planned, measured or verified; historical metrics cannot render as current completion evidence.")
  ]
  :contractSources [
    (:contract :id D81PlanContext :source ".asl/mem/reviews/D81PlanSettlement.asn")
    (:contract :id D81TaskFailureModes :source ".asl/mem/reviews/D81PlanSettlement.asn")
    (:contract :id D81BehavioralAcceptance :source ".asl/mem/reviews/D81PlanSettlement.asn")
    (:contract :id D81Baseline :source ".asl/mem/reviews/D81PlanSettlement.asn")
    (:contract :id D81Ownership :source ".asl/mem/reviews/D81PlanSettlement.asn")
    (:contract :id D81Receipts :source ".asl/mem/reviews/D81PlanSettlement.asn")
  ]
  :evidence [
    "asl/web/src/index.css:7-18,100-116"
    "asl/web/src/components/Hero.asl:8"
    "asl/web/src/components/Navbar.asl:10"
    "asl/web/src/views/BlogView.asl:8-30"
    "asl/web/src/views/DocsView.asl:15-31"
    "tests/acceptance/d81/SuperviseGate.sh:9-49 validates the registered task and requires its verifier fixture before generic audits"
    "https://raw.githubusercontent.com/vercel-labs/web-interface-guidelines/main/command.md:26-32"
    "https://raw.githubusercontent.com/vercel-labs/web-interface-guidelines/main/command.md:44-60"
    "https://www.w3.org/TR/WCAG22/#contrast-minimum"
    "https://www.w3.org/TR/WCAG22/#non-text-contrast"
    "asl/web/src/components/Ecosystem.asl:123-174"
    "asl/web/src/views/RoadmapView.asl:21-90"
    ".asl/mem/decisions/Adr0081LanguageGroundTruthAndSovereignPortabilityProgram.asn:13"
  ]
  :phaseGate "for task in Task44801 Task44802 Task44803 Task44804 Task44805 Task44806; do sh tests/acceptance/d81/SuperviseGate.sh \"$task\" || exit $?; done"
  :gateReadiness :requiresIndependentBaseline
  :settlement ".asl/mem/reviews/D82DesignPlanReview.asn"
  :completionAudit ".asl/mem/reviews/D82CompletionAudit.asn"
  :verificationReadiness "Before trusting any Task448 gate, the independent verifier must bind SuperviseGate.sh's task argument to a verifier-owned oracle, prove a passing control and a forced-failing sentinel, and establish the intended baseline failure."
  :tasks [
    (:task
      :id "Task44801"
      :parentId ""
      :phase "phase-448"
      :title "Freeze the Instrumented Editorial frame and token contract"
      :kind :designSystem
      :lane "foundations"
      :state :done
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789171200000
      :updatedAt 1789417600000
      :motivation "The current palette and decorative helpers are purple-gradient led, while prose, data and controls share no explicit visual contract."
      :purpose "Define the frame, color roles, typography roles, spacing scale, radius tiers, elevation policy, content measures and wide-surface opt-in in styles.asn and the generated CSS/Tailwind contract."
      :context (:contractRef D81PlanContext)
      :outcomes ["One token registry with light/dark roles" "Documented width policy" "Forbidden-gradient and duplicate-accent checks" "Tokens consumable by ASL projections"]
      :owns ["asl/web/styles.asn" "asl/web/src/index.css" "asl/web/tailwind.config.js"]
      :targetSymbols ["styles" "renderStyles"]
      :relatedSymbols ["context" "ssot" "output"]
      :invariants ["C3" "D34" "D51" "D82"]
      :variations ["Keep brand violet as a single signal versus replace it with cyan or green" "72rem shell versus global 80rem shell"]
      :failureModes ["Token projection drifts from CSS" "A second accent reappears" "Wide canvas leaks into prose"]
      :additionalRequirements ["No new dependency" "Preserve light and dark themes" "Every numeric claim stays evidence-bound"]
      :adr "ADR-0082"
      :decision "d82"
      :dependsOn ["Task44606"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44801"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D82SettledChoices D82WidthPolicy D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
