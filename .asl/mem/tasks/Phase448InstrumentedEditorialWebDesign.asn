    (:task
      :id "Task44806"
      :parentId ""
      :phase "phase-448"
      :title "Run visual evidence, viewport and design-cost review"
      :kind :review
      :lane "verification"
      :state :planned
      :priority :critical
      :ownerRole "implementer"
      :motivation "A visual redesign can look coherent in one viewport while regressing mobile overflow, text measure, focus access or CSS payload. The repository currently has no shared acceptance contract for those outcomes."
      :purpose "Capture deterministic DOM or screenshot evidence for 320/768/1024/1440 widths, compare viewport-aware content measure and overflow, audit WCAG 2.2 AA contrast and focus, and report CSS/HTML token cost against the approved baseline. Record unresolved visual gaps rather than declaring taste a pass."
      :measurementContract "Contrast uses WCAG 2.2 AA text thresholds (4.5:1 normal text, 3:1 large text), WCAG non-text contrast for required control/state information, and a stricter local 3:1 UI-boundary policy; CSS/HTML cost uses one pinned tokenizer name/version and one checked-in representative corpus, with raw token counts and artifact digests recorded."
      :context (:contractRef D81PlanContext)
      :outcomes ["Viewport evidence at four widths" "Overflow and line-length report" "Contrast/focus report" "CSS and rendered-markup cost delta" "Open gaps ledger"]
      :owns ["asl/web/tests" "asl/web/dist"]
      :targetSymbols ["render-app-shell"]
      :relatedSymbols ["gates" "grading" "output"]
      :invariants ["D34" "D51" "D82"]
      :variations ["Playwright screenshot evidence versus browser DOM metric harness" "CSS byte delta versus rendered token delta"]
      :failureModes ["Screenshot passes while keyboard path fails" "A compressed stylesheet drops semantics" "Visual claim lacks a reproducible artifact"]
      :additionalRequirements ["Independent reviewer owns acceptance and the outer supervisor/runner configuration" "Before any Task448 gate is trusted, dispatch the task argument to its verifier-owned oracle and prove positive and forced-failing sentinel controls" "No runtime baseline claim before fixtures exist" "Report exit and executed assertions"]
      :adr "ADR-0082"
      :decision "d82"
      :dependsOn ["Task44805"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44806"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D82SettledChoices D82DesignAcceptance D82SovereigntyEvidence D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44806.asl" "tests/acceptance/d81/SuperviseGate.sh" ".asl/mem/reviews/D82DesignPlanReview.asn"]
      :verificationCases ["Before phase acceptance, the outer verifier proves SuperviseGate.sh dispatches the requested task, rejects unknown or missing fixtures, observes a passing control and a forced-failing sentinel, and emits a task-scoped receipt; generic audits alone cannot pass." "Each target viewport has a saved measurement or screenshot, no document overflow and a max 68ch text measure that shrinks on narrow screens; keyboard/focus and reduced-motion checks pass; the report includes exact artifact digests and WCAG 2.2 contrast results." "Capability labels expose source/provenance and planned, measured or verified state; unsupported self-hosting, WASM, native or offline completion is rejected." "The CSS/HTML cost delta names a pinned tokenizer/version and checked-in corpus, reports raw counts and digests, and cannot pass with a byte-only surrogate." "A missing browser fixture is reported as readiness failure, never as a successful visual result."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44806" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :planApproved
      :actionDag ["Verifier freezes viewport and cost fixtures." "Capture evidence after component changes." "Compare metrics and digests." "Record gaps and independent acceptance."]
      :stepIndex 0
      :receipts [])
  ])
