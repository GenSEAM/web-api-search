      :verificationOwns ["tests/acceptance/d81/Task44801.asl"]
      :verificationCases ["A token registry with two accents or a global width above 72rem fails; one signal, explicit wide-surface opt-in and matching generated CSS pass." "Light and dark roles preserve contrast and no gradient helper is emitted."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44801" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task44801" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44801" :assertCount 33 :at 1789417600000)]
      :reviewStatus :approved
      :actionDag ["Verifier freezes token and width fixtures." "Implement styles.asn and projections." "Run static accent, width and projection checks." "Independent acceptance."]
      :stepIndex 5
      :receipts [(:receipt :step 5 :status :ok :hash "HEAD")])
    (:task
