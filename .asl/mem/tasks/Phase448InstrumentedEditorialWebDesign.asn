    (:task
      :id "Task44804"
      :parentId ""
      :phase "phase-448"
      :title "Make navigation, controls and motion responsive and accessible"
      :kind :accessibility
      :lane "interaction"
      :state :done
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789171200000
