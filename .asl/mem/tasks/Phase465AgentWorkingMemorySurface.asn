      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task46505.asl"]
      :verificationCases ["Both suites report a non zero executed assertion count." "A suite executing zero assertions fails even when its exit code is zero." "A checkpoint written by one process restores in another."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task46505" :status :notEstablished :contract D81Baseline)
