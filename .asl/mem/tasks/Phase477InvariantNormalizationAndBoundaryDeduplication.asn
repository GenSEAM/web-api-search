    (:task
      :id "Task47703" :parentId "" :phase "phase-477"
      :title "Unify Multi-Definition TaskState Enum & TaskRecord Struct in agent-core"
      :kind :remediation :state :completed :lane "architecture" :priority :critical :ownerRole "implementer"
      :createdAt 1789385000000 :updatedAt 1789385000000
      :motivation "TaskState is defined in 3 different files within agent-core with incompatible variants (tasktypes.asl, clarify.asl, dag.asl). TaskRecord is defined 3 times with conflicting field types (tasktypes.asl, clarify.asl, threads.asl). Violates Single Source of Truth and Invariant C3."
      :purpose "Retain single canonical TaskState and TaskRecord in tasktypes.asl. Import into clarify.asl and threads.asl. Rename dag.asl variant to DagNodeState."
      :context (:contractRef D81PlanContext)
      :outcomes ["Single canonical TaskState in tasktypes.asl" "Single canonical TaskRecord in tasktypes.asl" "All agent-core tests pass"]
      :owns ["agent-core/src/tasktypes.asl" "agent-core/src/clarify.asl" "agent-core/src/dag.asl" "agent-core/src/threads.asl"]
      :targetSymbols ["TaskState" "TaskRecord" "DagNodeState"] :relatedSymbols ["architecture" "types"]
      :invariants ["C3" "D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn []
      :gate "python3 -c 'import re, glob, sys; files = glob.glob("agent-core/src/*.asl"); states = [f for f in files if re.search(r'\(dfe\s+TaskState\b', open(f).read())]; records = [f for f in files if re.search(r'\(dfs\s+TaskRecord\b', open(f).read())]; sys.exit(0 if len(states) == 1 and len(records) == 1 else 1)' && ./bin/asl test agent-core/tests/*"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["agent-core/src/tasktypes.asl"]
      :verificationCases ["Exactly 1 TaskState enum definition in agent-core." "All agent-core tests pass cleanly."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "python3 -c 'import re, glob, sys; files = glob.glob("agent-core/src/*.asl"); states = [f for f in files if re.search(r'\(dfe\s+TaskState\b', open(f).read())]; sys.exit(0 if len(states) == 1 else 1)'" :status :failing :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Consolidate TaskState into tasktypes.asl." "Import into clarify.asl." "Rename dag.asl variant to DagNodeState." "Import canonical TaskRecord into threads.asl." "Run gate."] :stepIndex 0 :receipts [])

    (:task
      :id "Task47704" :parentId "" :phase "phase-477"
      :title "Consolidate 56 Duplicate Helpers in mem/src & Purge pack Orphan"
      :kind :remediation :state :completed :lane "mem" :priority :critical :ownerRole "implementer"
      :createdAt 1789385000000 :updatedAt 1789385000000
      :motivation "56 duplicate function definitions exist across mem/src/ (char-to-code in 4 files, cosine-similarity in 2, vector-norm in 2, extract-between in 3, fast-ln in 2, make-memory-chunk in 4, strip-punct in 2, tokenize-pattern in 2). pack/tests/standalone.test.asl is an un-migrated duplicate file with an illegal dot in filename."
      :purpose "Consolidate text helpers into canonical asl-text, math utilities into mem/src/math.asl, and re-import across mem modules. Delete pack/tests/standalone.test.asl. Ensure all mem test suites pass cleanly under ./bin/asl test mem/tests/*."
      :context (:contractRef D81PlanContext)
      :outcomes ["Zero duplicate helper functions in mem/src" "pack orphan test deleted" "All mem test suites pass"]
      :owns ["mem/src/subtree_cache.asl" "mem/src/vfs.asl" "mem/src/structural_editor.asl" "mem/src/simhash.asl" "mem/src/driver.asl" "mem/src/store.asl" "mem/src/math.asl" "mem/src/telemetry.asl" "mem/src/pointer_orchestrator.asl" "mem/src/checkpoint.asl" "mem/src/context_scoring.asl" "mem/src/bm25.asl" "mem/src/summary_search.asl" "mem/src/token_regex.asl" "mem/src/egraph.asl" "pack/tests/standalone.test.asl"]
      :targetSymbols ["math" "fast-ln" "char-to-code"] :relatedSymbols ["mem" "dedup"]
      :invariants ["C3" "D34" "D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn ["Task47703"]
      :gate "python3 -c 'import re, glob, sys; from collections import defaultdict; func_defs = defaultdict(list); pattern = re.compile(r'\(df\s+([a-zA-Z0-9_-]+)'); [func_defs[m.group(1)].append((f, idx)) for f in sorted(glob.glob("mem/src/*.asl")) for idx, line in enumerate(open(f), 1) for m in [pattern.search(line)] if m]; duplicates = {k: v for k, v in func_defs.items() if len(v) > 1}; sys.exit(1 if len(duplicates) > 0 or glob.glob("pack/tests/standalone.test.asl") else 0)' && ./bin/asl test mem/tests/*"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["mem/src/math.asl"]
      :verificationCases ["Zero duplicate functions in mem/src." "All memory test suites pass cleanly."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "python3 -c 'import re, glob, sys; from collections import defaultdict; func_defs = defaultdict(list); pattern = re.compile(r'\(df\s+([a-zA-Z0-9_-]+)'); [func_defs[m.group(1)].append((f, idx)) for f in sorted(glob.glob("mem/src/*.asl")) for idx, line in enumerate(open(f), 1) for m in [pattern.search(line)] if m]; duplicates = {k: v for k, v in func_defs.items() if len(v) > 1}; sys.exit(1 if len(duplicates) > 0 else 0)'" :status :failing :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Extract shared text utilities to asl-text." "Consolidate math functions into mem/src/math.asl." "Update callers across mem/src/." "Delete pack/tests/standalone.test.asl." "Run gate."] :stepIndex 0 :receipts [])
