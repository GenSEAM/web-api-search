(:taskCollection
  :id "Phase477InvariantNormalizationAndBoundaryDeduplication"
  :createdAt 1789385000000
  :status "completed"
  :priorityOrder 3
  :summary "Invariant Normalization & Boundary Deduplication: eradicate raw unicode emojis across asl/web and TUI (Invariant C2); eliminate relative directory traversal (../../) across package boundaries; unify TaskState and TaskRecord enums in agent-core; and consolidate 56 duplicate helper functions in mem/src/ (Invariant C3)."
  :phase "Phase477InvariantNormalizationAndBoundaryDeduplication"
  :baseline "Measured 2026-09-12 by monorepo audit. 44 files contain raw unicode emojis and pictographs (palette, rocket, U+23F8 double vertical bar, diamond, checkmarks) in violation of C2; 4 modules in intel, mem, and agent-bus use relative escapes (../../) across package boundaries in violation of C3; TaskState and TaskRecord are defined 3 times with incompatible variants in agent-core; and 56 duplicate function definitions exist across mem/src/ modules."
  :tasks [
    (:task
      :id "Task47701" :parentId "" :phase "phase-477"
      :title "Normalize Raw Unicode Emojis & Pictographs to SVG and ASCII Indicators"
      :kind :remediation :state :completed :lane "hygiene" :priority :critical :ownerRole "implementer"
      :createdAt 1789385000000 :updatedAt 1789385000000
      :motivation "Raw unicode emojis and UI pictographs in asl/web and agent TUI violate Invariant C2 (zero raw unicode emojis). Boxart glyphs (U+23F8, U+25C6, U+2713, U+2717) are embedded in runtime code and asserted in unit tests."
      :purpose "Replace emojis in web components with pure SVG vector icons. Replace pictographic boxart in agent/src/asn_boxart.asl and tui.asl with ASCII indicators ([||], [OK], [FAIL], [>], [v], [x]) and update assertions in tui-test.asl and vfs_sync_test.asl."
      :context (:contractRef D81PlanContext)
      :outcomes ["0 raw emojis in source code" "tui-test.asl passes" "vfs_sync_test.asl passes"]
      :owns ["asl/web/src/components/InBrowserCompanion.asl" "asl/web/src/components/ModuleGraphVisualizer.asl" "asl/web/src/components/Footer.asl" "asl/web/src/views/InIdeView.asl" "asl/web/src/views/PlaygroundView.asl" "agent/src/asn_boxart.asl" "agent/src/tui.asl" "agent/tests/tui-test.asl" "mem/tests/vfs_sync_test.asl" "voice/src/voice_pipeline.asl" "voice/src/aloud.asl"]
      :targetSymbols ["boxart" "tui" "sparkline"] :relatedSymbols ["hygiene" "invariants"]
      :invariants ["C2" "D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn []
      :gate "python3 -c 'import re, glob, sys; emoji_pat = re.compile(r"[\U0001F300-\U0001FAFF]"); picto_pat = re.compile(r"[▶▼⠋❯◆✔✓✗⏸]"); files = glob.glob("asl/web/**/*.asl", recursive=True) + ["agent/src/asn_boxart.asl", "agent/src/tui.asl", "agent/tests/tui-test.asl", "mem/tests/vfs_sync_test.asl"]; found = sum(len(emoji_pat.findall(open(f).read())) + len(picto_pat.findall(open(f).read())) for f in files); sys.exit(1 if found > 0 else 0)' && ./bin/asl test agent/tests/tui-test.asl && ./bin/asl test mem/tests/vfs_sync_test.asl"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["agent/tests/tui-test.asl"]
      :verificationCases ["Python regex scan returns 0 emojis or pictographs." "Both TUI and VFS sync tests pass."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "./bin/asl test agent/tests/tui-test.asl" :status :failing :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Replace emojis in asl/web components with SVG." "Replace pictographs in boxart and tui." "Update test assertions." "Run gate."] :stepIndex 0 :receipts [])

