      :motivation "Textual and naive line-based merges fail on structural refactors and nested forms, causing false conflicts"
      :purpose "Implement recursive S-expression 3-way merge in mem/src/ast_merge.asl capable of resolving functions, typestates, lists, and dicts"
      :context "Extends ADR-0076 and builds on mem/src/vfs_merge.asl"
      :outcomes [
        "Generalized recursive AST 3-way merge implementation in mem/src/ast_merge.asl"
        "Structured AST collision record emission"
        "100% test pass on mem/tests/ast_merge_test.asl"
      ]
      :owns ["mem/src/ast_merge.asl" "mem/tests/ast_merge_test.asl" "mem/grammar.asn"]
      :targetSymbols ["ast-3way-merge" "resolve-form-merge" "AstMergeResult" "ASTCollisionRecord"]
      :relatedSymbols ["D51" "D52" "D76" "C1" "C4"]
      :dependsOn []
      :gate "asl test --strict-falsify mem/tests/ast_merge_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D56" "D76"]
      :variations ["Line-based Myers diff vs recursive S-expression tree merge (chosen: recursive S-expression tree merge)"]
      :failureModes ["Unbalanced S-expression delimiters (mitigated: verified with pure ASL parser)"]
      :adr "ADR-0076"
      :decision "D76"
      :why "Homoiconic AST merging eliminates false textual conflicts and enables lock-free parallel execution"
      :spec "Implement generalized AST 3-way merge with structural collision detection."
      :acceptanceCriteria ["ast_merge_test passes" "Disjoint forms merge cleanly" "Conflicting forms produce ASTCollisionRecord"]
      :stepIndex 1
      :actionDag ["Design AST merge data structures" "Implement recursive merge" "Verify with strict-falsify test"])
