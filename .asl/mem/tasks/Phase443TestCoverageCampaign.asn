      :targetSymbols ["is_safe_path" "resolve_path" "visibility-scope"]
      :relatedSymbols ["gates" "concepts" "grading"]
      :invariants ["C1" "D81"]
      :requiredCaseKinds ["negativeControl" "adversarial" "boundary" "metamorphic" "errorPropagation"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task43809"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44301"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44301.asl"]
      :verificationCases ["Every rejection case names the exact reason; every acceptance case is a path that must remain reachable." "Two paths that canonicalise to the same location produce the same verdict."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44301" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Read docs/TEST_CASE_CATALOG.md and asl coverage for this area." "Write one case per required kind, one behaviour per function." "Invert each assertion once and record the non-zero exit in the trace." "Re-run asl coverage and confirm the kind set." "Independent acceptance."]
      :stepIndex 0
