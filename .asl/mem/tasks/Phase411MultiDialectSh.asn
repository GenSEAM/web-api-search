    (:task
      :id "T4113"
      :parentId ""
      :phase "Phase411MultiDialectSh"
      :title "Extend Supervised Process Plane with Dialect Execution"
      :kind :feature
      :lane "engine"
      :state :completed
      :priority :high
      :ownerRole "implementer"
      :createdAt 1773400000000
      :updatedAt 1773400000000
      :startedAt 0
