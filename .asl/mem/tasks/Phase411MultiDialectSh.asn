      :motivation "Host /bin/sh runs in restricted POSIX mode on macOS, breaking scripts requiring bash features"
      :purpose "Add :dialect support to :procSpawn and :exec in asl-engine routing commands to the correct shell"
      :context "Guarantees that supervised commands execute with the expected shell interpreter and environment"
      :outcomes [
        "Extended SovereignEngine.eval_op in asl/bin/asl-engine with :dialect parameter"
        "SupervisedProcess shell routing to /bin/bash, /bin/zsh, or /bin/sh"
      ]
      :owns ["asl/bin/asl-engine"]
      :targetSymbols ["SupervisedProcess.start" "SovereignEngine.proc_spawn" "SovereignEngine.proc_exec"]
      :relatedSymbols ["D35" "D51" "D55" "C1" "C3"]
      :dependsOn ["T4111"]
      :gate "asl rpc '(:batch (:procSpawn :id \"smoke-dialect\" :cmd \"echo $BASH_VERSION\" :dialect \"bash\" :waitMs 500) (:procSkeleton :id \"smoke-dialect\") (:procPrune :id \"smoke-dialect\"))'"
      :invariants ["C1" "C2" "C3" "C5" "D35" "D51" "D52" "D55"]
      :variations ["Spawning subshell inside command string vs direct binary execution"]
      :failureModes ["Missing bash binary on minimal container images (mitigated: automatic fallback to POSIX sh)"]
      :adr "D55"
      :decision "D55"
      :why "Guarantee reliable execution of shell tools across Linux and macOS substrates"
      :spec "Add dialect argument to spawn and exec operations in engine."
      :acceptanceCriteria ["Batch RPC returns ok with exit-code 0" "prune succeeds" "exit-code 0"]
      :stepIndex 3
      :actionDag ["Parse dialect argument in eval_op" "Configure subprocess shell invocation" "Add fallback mechanism" "Verify RPC gate"])
