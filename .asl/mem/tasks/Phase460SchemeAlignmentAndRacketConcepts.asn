      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task46002" :status :baselineVerified :contract D81Baseline :exitCode 1 :failure "language-semantics.asn must define racketBindingShape semantic")
      :historicalReceipts ["rc-task46002-verified-20260912"]
