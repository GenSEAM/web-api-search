      :receipts [(:receipt :step 3 :status :ok :hash "HEAD")])
    (:task
      :id "Task44504"
      :parentId ""
      :phase "phase-445"
      :title "Concept-to-checker coverage report"
      :kind :gate
      :lane "static"
      :state :done
      :priority :high
      :ownerRole "implementer"
      :createdAt 1789142321056
      :updatedAt 1789434400000
      :motivation "The system accumulated paradigm claims faster than confirmations: nineteen rules, five invariants, fifty-six decisions and thirty-six capabilities, against roughly a third with any mechanical check. Without a coverage figure over the constraints themselves, the ratio silently worsens with every new concept."
      :purpose "asl doctor emits a confirmation-coverage row per constraint class: rules with :check, invariants with a checker, decisions with a falsifiable gate, capabilities with a measured status. The report names every unconfirmed constraint. Gate 7 fails when a newly added rule, invariant or capability arrives without a :check field, which makes the admission rule in the concepts rule mechanical rather than aspirational."
      :context (:contractRef D81PlanContext)
      :outcomes ["Confirmation-coverage report per constraint class" "Unconfirmed constraints listed by name" "New constraint without :check fails gate 7"]
      :owns ["asl/tools/asl.c"]
      :targetSymbols ["run_doctor" "run_gate_7"]
      :relatedSymbols ["concepts" "capabilities" "ssot"]
      :invariants ["D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task44501" "Task44503"]
