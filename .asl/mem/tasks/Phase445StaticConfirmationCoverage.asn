    (:task
      :id "Task44502"
      :parentId ""
      :phase "phase-445"
      :title "Static checkers for the eleven unconfirmed rules"
      :kind :gate
      :lane "static"
      :state :done
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789142321056
      :updatedAt 1789433600000
      :motivation "Eleven rules carry no confirmation at all, and each has a statically decidable core: an alias used but not declared, an author owning a grader path, a number in a rule with no cited source, two in-flight tasks sharing an owned path, a read call site without a bound, a rendered surface diverging from its source, a declared capability contradicting its measured lock."
      :purpose "Implement one checker per rule with a decidable core: semantics checks every used alias is declared and every called symbol resolves; grading checks ownerRole differs from verificationRole and author paths are disjoint from grader paths; concepts checks every numeric claim in a rule cites a source file that exists; oneStep and parallel check :owns disjointness across in-flight tasks; hiddenTests checks implementer :owns excludes grader test paths; bounded checks documented read call sites carry :limit; output checks emitted receipts retain path and line; ssot and capabilities reuse the existing checks. budget and edge are runtime-only and are declared :none with a reason."
      :context (:contractRef D81PlanContext)
      :outcomes ["One checker per decidable rule" "budget and edge declared runtime-only with a reason" "All checkers reachable from asl doctor and gate 7"]
      :owns ["asl/tools/asl.c" "asl/packages/asl-gates/src"]
      :targetSymbols ["run_gate_7" "run_doctor"]
      :relatedSymbols ["grading" "concepts" "hiddenTests" "bounded" "oneStep"]
      :invariants ["D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task44501"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44502"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44502.asl"]
      :verificationCases ["Each of the nine implemented checkers catches its own planted violation and passes a clean tree." "A rule declared runtime-only states why it cannot be checked statically, rather than being silently skipped."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44502" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task44502" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44502" :assertCount 45 :at 1789433600000)]
      :reviewStatus :approved
      :actionDag ["Verifier plants one violation per rule." "Implement each decidable checker." "Declare the two runtime-only rules with a reason." "Wire into doctor and gate 7." "Independent acceptance."]
      :stepIndex 2
      :receipts [(:receipt :step 2 :status :ok :hash "HEAD")])
    (:task
      :id "Task44503"
      :parentId ""
      :phase "phase-445"
      :title "C3 duplicate capability checker and the camelCase convergence checker"
      :kind :gate
      :lane "static"
      :state :completed
      :priority :high
      :ownerRole "implementer"
      :createdAt 1789142321056
      :updatedAt 1789434000000
      :motivation "C3 is named in AGENTS.md as a forbidden-duplication invariant and has no checker: 111 symbol names are defined in more than one package, six of them implementations of token estimation. D51 has no checker either: structs reached 890 of 890 CamelCase while test functions sit at 80 of 1673 and ASN property keys at 48.5 percent, and Phase415 was marked complete against a gate that cannot run."
      :purpose "Two checkers. The C3 checker reports any symbol defined in more than one package outside a declared allowlist (main, run-tests), and any capability with more than one implementation where a canonical home is declared. The D51 checker enforces CamelCase for struct names, composite identifiers over two words and test function names, and camelCase for ASN property keys, reporting convergence per package and failing when a package regresses below its recorded baseline."
      :context (:contractRef D81PlanContext)
      :outcomes ["C3 duplicate report with canonical-home awareness" "D51 convergence per package with a regression floor" "Both wired into gate 6 or 7" "Phase415 state corrected from the measurement"]
      :owns ["asl/tools/asl.c" "asl/packages/asl-gates/src" ".asl/mem/tasks/Phase415LargeScaleTypestateRefactorAndCamelCaseConvergence.asn"]
      :targetSymbols ["run_gate_6" "run_gate_7"]
      :relatedSymbols ["names" "concepts" "ssot"]
      :invariants ["D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task44502" "Task43806"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44503"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44503.asl"]
      :verificationCases ["A second implementation of a capability with a declared canonical home is reported with both paths; an allowlisted name such as run-tests is not." "Adding a kebab-case test function to a converged package fails; a package below its floor cannot regress further without failing."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44503" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task44503" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44503" :assertCount 39 :at 1789434000000)]
