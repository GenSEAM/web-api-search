      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44504.asl"]
      :verificationCases ["A newly added rule without :check fails gate 7 and is named; the coverage figure moves when a checker is added or removed." "The report distinguishes unchecked from declared runtime-only."]
