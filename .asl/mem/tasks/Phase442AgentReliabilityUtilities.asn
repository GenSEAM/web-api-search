    (:task
      :id "Task44202"
      :parentId ""
      :phase "phase-442"
      :title "Structured supervised execution: (:run cmd)"
      :kind :protocol
      :lane "reliability"
      :state :done
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789139714894
      :updatedAt 1789139714894
      :motivation "Measured 2026-09-11: exit codes read as cmd | head reported the status of head, inverting two audit findings that had to be publicly corrected; :exec is declared in rpc.asn and returns :status ok having executed nothing; the forensic audit measured over 85 percent of agent actions falling back to host subshells. Agents have no way to run a command and receive its real status."
      :purpose "(:run :cmd … [:cwd …] [:timeoutMs …]) executes a command under a watchdog inside the workspace boundary and returns (:exit N :stdout … :stderr … :durationMs N :truncated bool) as ASN with no shell quoting hazard; output is bounded by :limit with :more; a timeout returns :ERR_TIMEOUT, never a fabricated exit code. :exec is replaced by it or rejected."
      :context (:contractRef D81PlanContext)
      :outcomes ["(:run …) with real exit, stdout, stderr, duration" "Watchdog timeout with explicit error" "Bounded output with continuation" "rpc.asn declares only the implemented form"]
      :owns ["asl/tools/asl.c" "asl/grammar/rpc.asn"]
      :targetSymbols ["execute_single_step" "run_serve"]
      :relatedSymbols ["tools" "bounded" "gates"]
      :invariants ["D34" "D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task43603" "Task43809"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44202"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44202.asl"]
      :verificationCases ["A command exiting 3 reports :exit 3; a command writing to stderr returns it separately; a hanging command returns :ERR_TIMEOUT and is killed; output beyond the bound sets :truncated true and offers :more." "No pipeline is required to read a status, so the head-pipe inversion is not reproducible through this op."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44202" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task44202" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44202" :assertCount 17 :at 1789401200000)]
      :reviewStatus :approved
      :actionDag ["Verifier fixes commands with known exit codes, stderr output, large output and a hang." "Implement supervised execution with watchdog." "Bound and continue output." "Retire :exec." "Independent acceptance."]
      :stepIndex 5
      :receipts [(:receipt :step 5 :status :ok :hash "HEAD")])
    (:task
      :id "Task44203"
      :parentId ""
      :phase "phase-442"
      :title "Concurrent writer safety: file leases and staleness detection"
      :kind :protocol
      :lane "reliability"
      :state :done
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789139714894
      :updatedAt 1789139714894
      :motivation "Measured 2026-09-11: an independent settlement run rewrote all six phase files and overwrote textual amendments made minutes earlier in another session; the daemon removal committed to the mem worktree was reverted by a checkout from another writer, restoring 1220 lines and 22 grammar symbols; a stray delimiter left uncommitted in harness blocked Gate 2 for forty minutes. The parallel rule states one writer per partition and nothing enforces or detects it."
      :purpose "(:claim :paths […] :sessionId …) records a lease with a digest per path in the session ledger; every mutating op verifies the on-disk digest still matches the digest read during the claim and rejects with :ERR_STALE_FILE when another writer changed it; (:leases) lists active claims and their holders; expiry is explicit and a lapsed lease fails closed."
      :context (:contractRef D81PlanContext)
      :outcomes ["(:claim) and (:leases) over the session ledger" "Digest staleness check on every mutating op" ":ERR_STALE_FILE instead of silent overwrite" "Expired lease fails closed"]
      :owns ["asl/tools/asl.c" "asl/grammar/rpc.asn" ".asl/mem/tasks/InFlight.asn"]
      :targetSymbols ["execute_single_step" "is_safe_path"]
      :relatedSymbols ["parallel" "oneStep" "ssot"]
      :invariants ["D34" "D46" "D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task44101" "Task43805"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44203"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44203.asl"]
      :verificationCases ["Two sessions claiming the same path: the second claim is refused; a write after an external modification is rejected with :ERR_STALE_FILE and the file is unchanged; an expired lease rejects rather than proceeds." "A single-session workflow is unaffected and requires no extra calls."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44203" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task44203" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44203" :assertCount 14 :at 1789401400000)]
      :reviewStatus :approved
      :actionDag ["Verifier fixes a two-session scenario with an overlapping path." "Implement claims with digests in the session ledger." "Check digest on mutate." "Expire and fail closed." "Independent acceptance."]
      :stepIndex 5
      :receipts [(:receipt :step 5 :status :ok :hash "HEAD")])
