      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44201.asl"]
      :verificationCases ["A shimmed diff that reports differing files as identical, a stubbed op returning ok with no payload, and a test runner that passes a false assertion are each reported as a false capability and fail the probe." "A healthy environment produces an all-true map and exit 0; the map is stable across two runs."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44201" :status :baselineVerified :contract D81Baseline)
