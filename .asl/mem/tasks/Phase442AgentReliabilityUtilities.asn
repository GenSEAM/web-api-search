    (:task
      :id "Task44205"
      :parentId ""
      :phase "phase-442"
      :title "Semantic recall over the ledgers: (:q) on the resident BM25 index"
      :kind :protocol
      :lane "reliability"
      :state :planned
      :priority :high
      :ownerRole "implementer"
      :createdAt 1789139714894
      :updatedAt 1789139714894
      :motivation "Measured 2026-09-11: mem/src/bm25.asl implements Okapi BM25 in 217 lines with a passing suite and is unreachable from the engine, while :q routes to the filename glob. Because prior decisions could not be searched, two decision ledgers diverged by 227 lines beside 59 individual ADR files, and 62 documentation references to eight nonexistent subcommands accumulated. An agent that cannot find what already exists duplicates it."
      :purpose "(:q :query … [:scope :decisions|:tasks|:code] [:limit N]) builds or loads a resident BM25 index over .asl/mem and the code corpus and returns ranked (:hit :file :line :score :snippet) results; the ASL implementation in mem is the reference and is either invoked or ported; a query that cannot be served returns :ERR_UNIMPLEMENTED rather than a filename glob."
      :context (:contractRef D81PlanContext)
      :outcomes ["(:q …) returns ranked hits with file, line and snippet" "BM25 from mem is the reference implementation" "Index build is incremental and bounded" ":find remains a filename glob and is documented as such"]
      :owns ["asl/tools/asl.c" "asl/grammar/rpc.asn" "mem/src/bm25.asl"]
      :targetSymbols ["make-bm25-index" "sort-bm25-scores" "find_walker_cb"]
      :relatedSymbols ["tools" "context" "bounded"]
      :invariants ["C3" "D34" "D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task43804"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44205"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44205.asl"]
      :verificationCases ["A query naming a prior ADR returns that ADR above unrelated files; a query with no match returns an empty ranked list rather than a canned file list; an unsupported scope is rejected explicitly." "Index build time and memory stay within the declared bound on the full corpus."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44205" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Verifier fixes queries with known expected top hits across decisions, tasks and code." "Port or invoke the BM25 index." "Rank and bound results." "Reject unsupported scopes." "Independent acceptance."]
