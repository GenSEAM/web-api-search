      :baselineProbe (:command "./bin/asl test asl/packages/asl-sql/tests/sql_test.asl" :status :failing :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Re-route imports in asl-sql to asl-text/string." "Remove unused import in browser-bridge-test and fix assertions." "Update mem/src/migration.asl." "Update editorial-matrix modules." "Update harness test suites." "Update asl/web components." "Verify gate."] :stepIndex 1 :receipts ["rc-phase47502-verified-20260912"])

    (:task
      :id "Task47503" :parentId "" :phase "phase-475"
      :title "Canonicalize Module Headers (:exports to :x, ns to module)"
      :kind :remediation :state :completed :lane "syntax" :priority :high :ownerRole "implementer"
      :createdAt 1789375000000 :updatedAt 1789375000000
      :motivation "Six source modules in agent-core, agent-bus, and mem use non-standard :exports [...] which is ignored by ASL module loaders, treating public functions as private. asl/web views use Clojure (ns ...) headers causing ERR_UNBOUND_SYMBOL: ns."
      :purpose "Replace :exports with canonical :x across all six modules. Replace (ns ...) headers with standard (module asl-web/views/... :d ... :x [...] :i [...]) headers."
      :context (:contractRef D81PlanContext)
      :outcomes [":exports replaced with :x across all modules" "Clojure ns headers replaced with module" "playgound_test and test_card pass"]
      :owns ["agent-core/src/dag_merge.asl" "agent-core/src/prompt_tree.asl" "agent-bus/src/mvcc_bus.asl" "mem/src/speculative_fork.asl" "mem/src/ast_merge.asl" "mem/src/stm.asl" "asl/web/src/views/playground_test.asl" "asl/web/src/views/test_card.asl"]
