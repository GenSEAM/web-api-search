      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn []
      :gate "./bin/asl test asl/packages/asl-sql/tests/sql_test.asl && ./bin/asl test asl/packages/asl-sql/tests/ddl_test.asl && ./bin/asl test agent-bus/tests/browser-bridge-test.asl && ./bin/asl test mem/tests/migration-test.asl && ./bin/asl test editorial-matrix/tests/syndication-cadence-test.asl && ./bin/asl test editorial-matrix/tests/article-projector-test.asl && ./bin/asl test harness/tests/bench-runners-test.asl && ./bin/asl test harness/tests/browser-harness-test.asl"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
