      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["asl/web/src/views/playground_test.asl"]
      :verificationCases ["No file contains non-standard exports keyword." "asl/web playground_test passes cleanly."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "./bin/asl test asl/web/src/views/playground_test.asl" :status :failing :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Replace :exports with :x in agent-core, agent-bus, and mem." "Rewrite ns headers in asl/web views to module." "Run verification gate."] :stepIndex 1 :receipts ["rc-phase47503-verified-20260912"])

