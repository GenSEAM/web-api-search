      :variations ["Client-side regex cleanup vs raw transcript ingestion into SLM (chosen: raw transcript ingestion)"]
      :failureModes ["Hallucination induced by phonetically noisy transcript (mitigated: SLM semantic normalization in Hanes)"]
      :adr "D73"
      :decision "D73"
