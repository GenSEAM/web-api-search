    (:task
      :id "T427AudioCaptureStateMachineAndAbortController"
      :parentId ""
      :phase "Phase427VoicePipelineHanesModelGalleryAndTaskPresets"
      :title "Implement Dual-Mode Audio Capture State Machine and Recording-Stop Agent Abort Controller"
      :kind :feature
      :lane "voice"
      :state :completed
      :priority :high
      :ownerRole "implementer"
      :createdAt 1773700000000
      :updatedAt 1773700000000
      :startedAt 1773700100000
      :completedAt 1773700200000
      :motivation "Voice interaction in browser contexts requires dual-mode capture (click-to-toggle or hold-to-talk) with immediate agent task cancellation when recording terminates."
      :purpose "Implement AudioCaptureStateMachine with 250ms threshold differentiation and wire recording termination directly to an active AbortController signal that interrupts running agent tasks."
      :context "Extends audio capture in Hanes web client with explicit state transitions and cancellation semantics"
      :outcomes [
        "Codified Click-to-Toggle vs Hold-to-Talk state machine transitions with pointer event timing"
        "Wired recording stop event directly to AbortController cancellation token across running agent turns"
        "Documented audio buffer flush and PCM streaming protocol"
      ]
      :owns ["harness/results/voice_pipeline_specification.asn"]
      :targetSymbols ["AudioCaptureStateMachine" "PointerTimingThreshold" "AgentAbortController"]
      :relatedSymbols ["D72" "D73" "C1" "C4"]
      :dependsOn ["T427ModelGalleryCalibrationAndShowcase"]
      :gate "test -f harness/results/voice_pipeline_specification.asn && asl check harness/results/voice_pipeline_specification.asn"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D71" "D72" "D73"]
      :variations ["Main thread audio capture vs AudioWorklet PCM streaming (chosen: AudioWorklet PCM 16kHz)"]
      :failureModes ["Missed abort event during streaming tool execution (mitigated: synchronous AbortController signal dispatch)"]
      :adr "D73"
      :decision "D73"
      :why "Provide zero-friction voice capture and instant interruptibility of autonomous browser actions"
      :spec "Specify audio state machine, timing bounds, abort dispatch, and verify syntax balance."
      :acceptanceCriteria ["State machine formal specification codified" "AbortController token dispatch defined" "Syntax verified with asl check"]
      :stepIndex 2
      :actionDag ["Model audio states" "Define abort token propagation" "Verify specification file"])
