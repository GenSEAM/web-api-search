(:taskCollection
  :id "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
  :createdAt 1773900000000
  :status "settled"
  :summary "Jarvis-Like Real-Time Voice I/O, Grammatical Turn Completion, Pool Unresolved Engine, and Multi-IDE Autonomous Agent Orchestration"
  :phase "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
  :tasks [
    (:task
      :id "T429GrammaticalEndTurnAnalyzer"
      :parentId ""
      :phase "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
      :title "Implement Grammatical Turn Completion Analyzer for Zero-Latency Speech Release"
      :kind :feature
      :lane "voice"
      :state :completed
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1773900000000
      :updatedAt 1773900000000
      :startedAt 1773900000000
      :completedAt 1773900100000
      :motivation "Fixed debounce timers cause perceived latency of 3000ms on complete utterances, while premature cuts break compound sentences mid-clause."
      :purpose "Implement pure AST lexical analysis of trailing tokens (coordinators, hesitations, hanging subjects, auxiliary verbs in Russian and English) releasing complete sentences instantly without an LLM roundtrip."
      :context "Extends asl-voice with endturn.asl and integrates into voice pipeline"
      :outcomes [
        "Implemented grammatical turn completion analyzer in voice/src/endturn.asl"
        "Eliminated 3000ms latency penalty for grammatically complete speech commands"
        "Guaranteed 3000ms silence wait for dangling coordinators and trailing prepositions"
        "Zero foreign dependencies and sub-microsecond evaluation"
      ]
      :owns ["voice/src/endturn.asl" "voice/tests/endturn_settle_aloud_test.asl"]
      :targetSymbols ["TurnVerdict" "TurnAnalysis" "analyze-turn-completion" "is-dangling-coordinator?"]
      :relatedSymbols ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :dependsOn []
      :gate "asl test --strict-falsify voice/tests/endturn_settle_aloud_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["LLM-based turn completion classifier vs pure lexical rule table (chosen: pure lexical rule table)"]
      :failureModes ["Misclassified trailing word stalling pipeline (mitigated: fails open with 3000ms ceiling)"]
      :adr "D74"
      :decision "D74"
      :why "Sub-microsecond local lexical analysis avoids paying LLM inference latency for simple turn completion decisions"
      :spec "Implement endturn.asl with bilingual grammatical markers and verify test suite."
      :acceptanceCriteria ["All grammatical categories tested" "Zero comments invariant enforced" "Tests pass cleanly"]
      :stepIndex 1
      :actionDag ["Design grammatical marker sets" "Implement endturn.asl" "Author unit tests" "Verify physical gate"])
    (:task
      :id "T429VoiceSettleBurstDebounce"
      :parentId ""
      :phase "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
      :title "Implement Voice Burst Buffering State Machine with Quiet Edge and Hard Ceiling"
      :kind :feature
      :lane "voice"
      :state :completed
      :priority :high
      :ownerRole "implementer"
      :createdAt 1773900000000
      :updatedAt 1773900000000
      :startedAt 1773900100000
      :completedAt 1773900200000
      :motivation "Fragmented speech recognition chunks generate multiple spurious tasks for a single compound thought."
      :purpose "Implement a burst debouncing state machine with dynamic quiet edge detection, 3000ms voice settle window, and immutable 30,000ms ceiling from first arrival."
      :context "Extends asl-voice with voice_settle.asl"
      :outcomes [
        "Implemented voice burst buffer in voice/src/voice_settle.asl"
        "Debounced multi-part spoken sentences into single coherent task payloads"
        "Enforced hard 30s ceiling preventing indefinite holding of continuous speech"
      ]
      :owns ["voice/src/voice_settle.asl" "voice/tests/endturn_settle_aloud_test.asl"]
      :targetSymbols ["BurstState" "SettleAction" "ingest-transcript-fragment" "step-settle-timer"]
      :relatedSymbols ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :dependsOn ["T429GrammaticalEndTurnAnalyzer"]
      :gate "asl test --strict-falsify voice/tests/endturn_settle_aloud_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["Volatile memory timer vs durable state machine (chosen: pure functional state machine)"]
      :failureModes ["Timer drift causing delayed dispatch (mitigated: monotonic timestamps and step-settle-timer)"]
      :adr "D74"
      :decision "D74"
      :why "Ensures multi-part speech fragments are assembled into unified task payloads before execution"
      :spec "Author voice_settle.asl and verify through comprehensive state transitions in test suite."
      :acceptanceCriteria ["Multi-chunk concatenation verified" "Timeout and ceiling actions verified"]
      :stepIndex 2
      :actionDag ["Define BurstState record" "Implement ingest and step functions" "Verify via test runner"])
    (:task
      :id "T429AloudSpeechOutputFormatter"
      :parentId ""
      :phase "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
      :title "Implement Ear-Friendly Speech Output Formatter with 8-Second Budget"
      :kind :feature
      :lane "voice"
      :state :completed
      :priority :high
      :ownerRole "implementer"
      :createdAt 1773900000000
      :updatedAt 1773900000000
      :startedAt 1773900200000
      :completedAt 1773900300000
      :motivation "TTS engines reading visual markdown, ANSI glyphs, and hex hashes letter-by-letter create catastrophic acoustic friction."
      :purpose "Implement aloud.asl to strip visual chrome, expand duration units, sanitize repository chips, and enforce an 8-second speech budget (112 characters)."
      :context "Extends asl-voice with aloud.asl"
      :outcomes [
        "Authored aloud.asl ear speech formatter"
        "Eliminated letter-by-letter spelling of hashes, brackets, and markdown tokens"
        "Added natural duration expansion and chip formatting"
        "Enforced strict 8-second cognitive attention budget"
      ]
      :owns ["voice/src/aloud.asl" "voice/tests/endturn_settle_aloud_test.asl"]
      :targetSymbols ["AloudConfig" "AloudSpeechResult" "format-for-ear" "strip-visual-chrome"]
      :relatedSymbols ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :dependsOn []
      :gate "asl test --strict-falsify voice/tests/endturn_settle_aloud_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["Complex regex parser vs fast multi-pass string replace (chosen: fast multi-pass string replace)"]
      :failureModes ["Excessive truncation losing meaning (mitigated: high-density chip summary upfront)"]
      :adr "D74"
      :decision "D74"
      :why "Synthesized voice must be concise, pleasant, and free of visual terminal syntax"
      :spec "Author aloud.asl and verify chrome stripping and duration expansions."
      :acceptanceCriteria ["All markdown markers stripped" "Durations expanded" "Budget clamped"]
      :stepIndex 3
      :actionDag ["Implement chrome stripping" "Implement duration expansions" "Test speech formatting"])
    (:task
      :id "T429TtsEngineMultiRouting"
      :parentId ""
      :phase "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
      :title "Design Multi-Engine TTS Layer Resolving Russian Synthesis Gap via Silero ONNX"
      :kind :feature
      :lane "voice"
      :state :completed
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1773900000000
      :updatedAt 1773900000000
      :startedAt 1773900300000
      :completedAt 1773900400000
      :motivation "Shrodi Kokoro v1.0 engine completely lacked Russian voice models, resulting in silence or broken phoneme spelling."
      :purpose "Implement tts_engine.asl defining unified multi-engine routing across Silero ONNX (native Russian & English, sub-20ms RTF), Kokoro ONNX, and Cloud streaming fallbacks."
      :context "Extends asl-voice with tts_engine.asl"
      :outcomes [
        "Authored tts_engine.asl multi-engine dispatcher"
        "Added first-class Silero ONNX support for Russian voice synthesis"
        "Implemented optimal engine selection based on language and available hardware"
      ]
      :owns ["voice/src/tts_engine.asl" "voice/tests/endturn_settle_aloud_test.asl"]
      :targetSymbols ["TtsEngineKind" "TtsEngineConfig" "select-optimal-engine" "create-synthesis-job"]
      :relatedSymbols ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :dependsOn []
      :gate "asl test --strict-falsify voice/tests/endturn_settle_aloud_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["Kokoro-only vs hybrid Silero/Kokoro/Cloud engine hierarchy (chosen: hybrid hierarchy)"]
      :failureModes ["Missing local ONNX model (mitigated: fallback to Cloud streaming or terminal silent)"]
      :adr "D74"
      :decision "D74"
      :why "Resolves the critical language barrier in voice synthesis without heavy runtime dependencies"
      :spec "Author tts_engine.asl and verify language compatibility in tests."
      :acceptanceCriteria ["Silero supports RU and EN" "Optimal engine selection verified"]
      :stepIndex 4
      :actionDag ["Define engine configurations" "Implement language check" "Verify synthesis job creation"])
    (:task
      :id "T429ComposePoolUnresolvedEngine"
      :parentId ""
      :phase "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
      :title "Implement The Third Reasoner: Composition Ledger and Pool Unresolved Queue"
      :kind :feature
      :lane "agent"
      :state :completed
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1773900000000
      :updatedAt 1773900000000
      :startedAt 1773900400000
      :completedAt 1773900500000
      :motivation "Single-turn classification loses goal context across multi-sentence dialogue and forces unnecessary stops on ambiguous questions."
      :purpose "Implement compose.asl maintaining running goal state, separating operator questions from lookup questions (delegated to background scouts), and managing working assumptions."
      :context "Extends asl-agent with compose.asl"
      :outcomes [
        "Implemented compose.asl running composition ledger"
        "Created UnresolvedNeed discriminator (operator vs lookup)"
        "Enabled autonomous background investigation of lookup questions by Scout agents"
        "Enforced bounded pool capacity (6 open questions, 4 assumed facts)"
      ]
      :owns ["agent/src/compose.asl" "agent/tests/compose_prompt_pool_test.asl"]
      :targetSymbols ["UnresolvedQuestion" "AssumedFact" "CompositionRecord" "add-unresolved-question"]
      :relatedSymbols ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :dependsOn []
      :gate "asl test --strict-falsify agent/tests/compose_prompt_pool_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["Immediate stop on ambiguity vs assumed claims with background lookup (chosen: assumed claims)"]
      :failureModes ["Pool explosion (mitigated: strict caps of 6 questions and 4 assumptions)"]
      :adr "D74"
      :decision "D74"
      :why "Allows assistant to proceed immediately on working assumptions while background scouts resolve unknowns"
      :spec "Author compose.asl and verify question lifecycle in test suite."
      :acceptanceCriteria ["Open questions capped" "Assumptions superseded correctly" "Context renders cleanly"]
      :stepIndex 5
      :actionDag ["Define CompositionRecord schema" "Implement addition/closure operations" "Test via ASL test runner"])
    (:task
      :id "T429PromptContextPool"
      :parentId ""
      :phase "Phase429JarvisRealtimeVoiceOrchestrationAndMultiIdeMesh"
      :title "Implement Prompt Context Pool with TTL Eviction and Per-Chat Isolation"
      :kind :feature
      :lane "agent"
      :state :completed
      :priority :high
      :ownerRole "implementer"
      :createdAt 1773900000000
      :updatedAt 1773900000000
      :startedAt 1773900500000
      :completedAt 1773900600000
      :motivation "Conversational follow-ups, anaphora ('fix it', 'run that again') require immediate access to recent raw prompts without full transcript bloat."
      :purpose "Implement prompt_pool.asl retaining K=3 recent prompts for T=3 minutes per chat session with automatic TTL eviction."
      :context "Extends asl-agent with prompt_pool.asl"
      :outcomes [
        "Authored prompt_pool.asl context retention pool"
        "Enforced strict chat-level isolation preventing cross-session prompt leaks"
        "Implemented automatic sliding TTL eviction and capacity bounding"
      ]
      :owns ["agent/src/prompt_pool.asl" "agent/tests/compose_prompt_pool_test.asl"]
      :targetSymbols ["PromptEntry" "PromptPool" "record-prompt" "get-active-prompts"]
      :relatedSymbols ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :dependsOn []
      :gate "asl test --strict-falsify agent/tests/compose_prompt_pool_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["Global prompt buffer vs per-chat keyed pool (chosen: per-chat keyed pool)"]
      :failureModes ["Token budget bloat (mitigated: capacity capped at K=3 prompts)"]
      :adr "D74"
      :decision "D74"
      :why "Provides essential context for follow-up detection without exploding context window"
      :spec "Author prompt_pool.asl and test capacity limits and TTL eviction."
      :acceptanceCriteria ["Capacity clamped at 3" "TTL eviction verified" "ASN context rendered cleanly"]
      :stepIndex 6
      :actionDag ["Define PromptPool record" "Implement eviction logic" "Verify test suite"])
