      :priority :critical
      :ownerRole "implementer"
      :createdAt 1773950000000
      :updatedAt 1773950000000
      :startedAt 1773950000000
      :completedAt 1773950500000
      :motivation "Browser security model forbids raw POSIX domain sockets; in-browser agents must interact with asl-core.wasm via direct memory buffers"
      :purpose "Implement browser JavaScript bridge in browser-plugin/src/runtime.asl and web/asl-browser.js dispatching (:batch ...) commands directly"
      :context "Builds in-memory linear memory bridge with TextEncoder/TextDecoder and Worker thread isolation"
      :outcomes [
        "Zero-socket RPC bridge with <3ms dispatch latency"
        "Full compatibility with browser Web Workers and main-thread"
        "Memory consumption strictly bounded (<16 MB RSS)"
      ]
      :owns [
        "browser-plugin/src/runtime.asl"
        "browser-plugin/tests/runtime_test.asl"
      ]
      :targetSymbols ["BrowserRuntimeBridge" "WasmRpcBridge" "DispatchBatchRpc"]
      :relatedSymbols ["D72" "D78" "C1" "D51"]
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D78"]
      :variations ["WebSocket proxy to localhost daemon vs in-memory WASM direct dispatch (chosen: in-memory direct dispatch)"]
      :failureModes ["Browser main thread freezing on intensive AST parsing (mitigated: Web Worker isolation)"]
      :adr "ADR-0078"
      :decision "D78"
      :why "Direct in-memory RPC enables sovereign agent execution inside browser tabs with zero server dependency"
      :spec "Implement browser runtime bridge and verify with strict-falsify tests."
      :acceptanceCriteria ["runtime_test passes" "Zero socket calls required" "Dispatch latency < 3ms"]
      :stepIndex 0
      :actionDag ["Implement browser runtime bridge" "Test direct memory RPC" "Verify dual-polarity test coverage"]
      :gate "asl test --strict-falsify browser-plugin/tests/runtime_test.asl")

