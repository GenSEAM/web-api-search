      :kind :implementation
      :lane "engine"
      :state :completed
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1773950000000
      :updatedAt 1773950000000
      :startedAt 1773950000000
      :completedAt 1773950500000
      :motivation "asl-eval binary links to Apple macOS-proprietary JavaScriptCore.framework (102 KB Mach-O), breaking Linux and Windows compatibility"
      :purpose "Consolidate S-expression evaluation into native asl-engine and portable ANSI C99 / WAMR evaluator, preparing asl-eval liquidation"
      :context "Re-engineers evaluation pipeline in asl/tools and asl-engine to eliminate macOS framework coupling"
      :outcomes [
        "Portable evaluation architecture designed for asl-engine"
        "Zero dependency on Apple macOS JavaScriptCore.framework"
        "Clean evaluation on Linux, Windows, and macOS"
      ]
      :owns [
        "asl/tools/asl-engine.c"
        "asl/bin/asl-eval"
      ]
      :targetSymbols ["EvalSExpr" "AslEngineEval" "WasmRuntimeEval"]
      :relatedSymbols ["D77" "D78" "C1" "C3"]
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D78"]
      :variations ["Retaining separate asl-eval executable vs consolidating into unified asl-engine (chosen: consolidation)"]
      :failureModes ["Loss of S-expression evaluation speed during micro-runtime transition"]
      :adr "ADR-0078"
      :decision "D78"
      :why "Eliminating proprietary frameworks is required for true cross-platform sovereignty"
      :spec "Consolidate S-expression evaluation into asl-engine and remove JavaScriptCore dependency."
      :acceptanceCriteria ["asl-engine handles evaluation" "JavaScriptCore removed from build" "asl check passes"]
      :stepIndex 0
      :actionDag ["Analyze asl-eval symbols" "Design consolidated evaluation loop" "Verify cross-platform build"]
      :gate "test -f asl/tools/asl-engine.c && asl check mem/grammar.asn")

