    (:task
      :id "T420NonBlockingSocketClient"
      :parentId ""
      :phase "Phase420MultiProjectDaemonLaunchAndMeshOrchestration"
      :title "Refactor Shell Socket Client to Non-Blocking Mode (<100ms Timeout)"
      :kind :bugfix
      :lane "cli"
      :state :completed
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1773490000000
      :updatedAt 1773490000000
      :startedAt 0
      :completedAt 1773495000000
      :motivation "Blocking netcat socket checks (nc -U -w 2) stall CLI executions for 2 seconds on dead or quarantined sockets"
      :purpose "Replace blocking netcat checks in asl/asl with non-blocking socket connect or 0.1s timeout, eliminating freezes"
      :context "Resolves the 2-second CLI stall uncovered in session forensics"
      :outcomes [
        "Zero 2-second netcat delays on socket operations"
        "Instant sub-10ms fallback to inline engine when socket is unavailable"
      ]
      :owns ["asl/asl"]
      :targetSymbols ["NonBlockingSocketConnect" "SocketTimeoutOptimization"]
      :relatedSymbols ["D52" "D65" "C1" "C4"]
      :dependsOn ["T420DistributedMeshTopology"]
      :gate "asl test --strict-falsify agent-bus/tests/mesh_orchestration_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D56" "D57" "D58" "D59" "D60" "D61" "D62" "D63" "D64" "D65"]
      :variations ["Fixed 2s netcat wait vs non-blocking immediate polling (chosen: non-blocking immediate polling)"]
      :failureModes ["Premature timeout on busy socket (mitigated: 100ms timeout with retry)"]
      :adr "ADR-0065"
      :decision "D65"
      :why "Eliminate execution freezes and restore crisp interactive responsiveness"
      :spec "Refactor asl/asl line 5026 to use non-blocking socket connect."
      :acceptanceCriteria ["CLI executes without 2-second pause" "Socket communication verified"]
      :stepIndex 5
      :actionDag ["Audit netcat call sites in asl/asl" "Implement non-blocking socket probe" "Verify CLI latency"])
