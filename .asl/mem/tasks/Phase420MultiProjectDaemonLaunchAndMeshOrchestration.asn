      :priority :high
      :ownerRole "implementer"
      :createdAt 1773490000000
      :updatedAt 1773490000000
      :startedAt 0
      :completedAt 1773495000000
      :motivation "Parallel subagents operating on shared or interdependent projects can cause git concurrency collisions"
      :purpose "Extend agent-bus MutexRegistry to acquire, extend, and release cross-project buffer leases with TTL expiration"
      :context "Utilizes agent-bus/src/mesh.asl BufferLease and MutexRegistry"
      :outcomes [
        "Enabled atomic cross-project buffer locking"
        "Zero multi-agent file overwrite collisions across linked repositories"
      ]
      :owns ["agent-bus/src/mesh.asl"]
      :targetSymbols ["BufferLease" "MutexRegistry" "acquire-buffer-lease" "release-buffer-lease"]
      :relatedSymbols ["D52" "D65" "C1" "C4"]
      :dependsOn ["T420CentralHubRouting"]
      :gate "asl test --strict-falsify agent-bus/tests/mesh_orchestration_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D56" "D57" "D58" "D59" "D60" "D61" "D62" "D63" "D64" "D65"]
      :variations ["Advisory file locking vs in-memory TTL buffer leases (chosen: in-memory TTL buffer leases)"]
      :failureModes ["Deadlocks from abandoned leases (mitigated: automatic TTL expiry and dead peer eviction)"]
      :adr "ADR-0065"
      :decision "D65"
      :why "Guarantee concurrency safety across parallel multi-agent swarms"
      :spec "Implement buffer lease acquisition and mutex verification in agent-bus."
      :acceptanceCriteria ["Buffer lease test assertions pass" "TTL expiration verified"]
      :stepIndex 3
      :actionDag ["Implement lease acquisition logic" "Add TTL expiration checks" "Verify mutex tests"])
