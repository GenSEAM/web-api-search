    (:task
      :id "T420DaemonLaunchSupervisor"
      :parentId ""
      :phase "Phase420MultiProjectDaemonLaunchAndMeshOrchestration"
      :title "Codify Persistent OS-Level Daemon Supervisor (launchd and systemd)"
      :kind :feature
      :lane "daemon"
      :state :completed
      :priority :critical
      :ownerRole "architect"
      :createdAt 1773490000000
      :updatedAt 1773490000000
      :startedAt 0
      :completedAt 1773495000000
      :motivation "On-demand shell backgrounding inside sandboxes leads to socket permission quarantine and deadlocks"
      :purpose "Codify user-level service descriptors for macOS launchd and Linux systemd ensuring the hub daemon runs with warm in-memory AST cache and clean socket permissions"
      :context "Binds authoritative ~/.asl/run/hub.sock accessible across all IDE instances and subshells"
      :outcomes [
        "Authored persistent service descriptors in launchd and systemd configurations"
        "Eliminated on-demand spawn quarantine and socket ownership collisions"
      ]
      :owns ["mem/src/daemon.asl"]
      :targetSymbols ["DaemonSupervisor" "ServiceDescriptor" "AuthoritativeSocket"]
      :relatedSymbols ["D50" "D52" "D65" "C1" "C4"]
      :dependsOn []
      :gate "asl test --strict-falsify agent-bus/tests/mesh_orchestration_test.asl"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D56" "D57" "D58" "D59" "D60" "D61" "D62" "D63" "D64" "D65"]
      :variations ["Fragile shell-spawning vs persistent OS user service (chosen: persistent OS user service)"]
      :failureModes ["User permissions blocking service registration (mitigated: zero-config fallback to user-local socket)"]
      :adr "ADR-0065"
      :decision "D65"
      :why "Provide instantaneous sub-millisecond RPC response without daemon startup lag"
      :spec "Specify persistent service configuration and lifecycle management in daemon architecture."
      :acceptanceCriteria ["Service configuration parses cleanly" "Socket binding verified"]
      :stepIndex 1
      :actionDag ["Design service descriptor" "Configure socket paths" "Verify supervisor lifecycle"])
