    (:task
      :id "T420CrossProjectMutexRegistry"
      :parentId ""
      :phase "Phase420MultiProjectDaemonLaunchAndMeshOrchestration"
      :title "Implement Cross-Project Mutex & Buffer Lease Registry in agent-bus"
      :kind :feature
