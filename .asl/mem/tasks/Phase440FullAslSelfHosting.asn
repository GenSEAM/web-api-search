      :invariants ["C3" "D34" "D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task44002"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44003"
      :actionDag ["Verifier enumerates released capability and dependency closure." "Move dispatch/check/lint/gates/RPC semantics to ASL." "Connect native artifact to owned OS boundary." "Remove semantic fallback copies only after conformance." "Independent all-capability and external-dependency acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44003.asl"]
      :verificationCases ["Enumerate all released capabilities and execute positive/error cases through the stage2 native CLI; no shadow C implementation silently substitutes ASL semantics." "Dependency inspection plus an isolated PATH/runtime environment shows check/test/RPC need no external compiler or runtime; OS/ABI substrate is explicitly allowed." "Required packages including asl-lint remain reachable; optional local pooling and one-shot semantics remain equivalent." "Host adapter contains only declared OS/ABI capabilities; line count is reported as descriptive data, never a correctness criterion."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44003" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task44003" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44003" :assertCount 32 :at 1789410400000)]
      :reviewStatus :approved
      :stepIndex 5
      :receipts [(:receipt :step 5 :status :ok :hash "HEAD")])

