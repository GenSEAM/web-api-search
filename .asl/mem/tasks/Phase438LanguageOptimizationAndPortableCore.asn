    (:task
      :id "Task43805"
      :parentId ""
      :phase "phase-438"
      :title "Implement transactional batches with isolated staging"
      :kind :protocol
      :lane "rpc"
      :state :done
      :priority :high
      :ownerRole "implementer"
      :createdAt 1789084800000
      :updatedAt 1789133687623
      :motivation "Staging must preserve real state and isolation; batch labels are not transaction evidence. Verified 2026-09-11: :edit writes through fopen(full_path, "w") at asl.c:1035; :discard cannot revert because no buffer exists; agents fall back to git checkout to undo."
      :purpose "Sequenced batches short-circuit on rejection; edit stages by session/path, diff reports staged versus disk, discard drops staged content and flush commits only authorized validated write sets; one-shot batches and optional resident pooling obey the same contract."
      :context (:contractRef D81PlanContext)
      :outcomes ["Implement transactional batches with isolated staging"]
      :owns ["asl/tools/asl.c" "asl/grammar/rpc.asn" "asl/grammar/protocol-conformance.asn"]
      :targetSymbols ["handle_payload" "execute_single_step"]
      :relatedSymbols ["vfs-cas-update" "vfs-diff" "BufferRecord"]
      :invariants ["D34" "D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "D81"
      :decision "d81"
      :dependsOn ["Task43804" "Task43604"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task43805"
      :actionDag ["Verifier establishes isolated transaction and failure cases." "Implement staged state and sequenced dispatch." "Implement preflight validation, flush journal and recovery semantics." "Validate discard/no-op and failure containment." "Independent acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task43805.asl"]
      :verificationCases ["Hashes prove disk unchanged after edit/diff/discard and changed exactly once after successful flush." "A failing middle operation prevents later effects; clean discard returns truthful zero changes." "A staged multi-file flush validates all preconditions before visible writes and has a documented recovery journal for interrupted publication; recovery cannot claim atomicity stronger than the filesystem provides." "Different sessions never observe each other's private staged buffers; unauthorized reads/writes fail at every exposed path."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task43805" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :planApproved
      :stepIndex 0
      :receipts [])

