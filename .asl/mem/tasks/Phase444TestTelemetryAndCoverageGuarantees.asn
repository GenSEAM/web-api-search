      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44401.asl"]
      :verificationCases ["A suite whose body is abandoned reports executed 0 with the blocking symbol named, never a declared count." "Assertion identities are stable across runs so a newly unreached assertion is detectable as a regression."]
      :gateReadiness :verified
