    (:task
      :id "Task44402"
      :parentId ""
      :phase "phase-444"
      :title "Three decidable coverage guarantees, gated; mutation score as the quality metric"
      :kind :verification
      :lane "coverage"
      :state :planned
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789141670724
      :updatedAt 1789141670724
      :motivation "Full path coverage is not decidable and must not be promised; what is decidable is whether every exported symbol has an executing test, whether every declared assertion executed, and whether each area carries its required case kinds. Today none of the three is checked and the only published figure was a substring count."
      :purpose "Gate 7 enforces three guarantees per package: every exported symbol named by at least one executing test; declared assertions equal executed assertions or each gap is listed with a reason; the required case kinds declared in Phase443 are present. Mutation score is reported separately as the quality metric and is never called coverage."
      :context (:contractRef D81PlanContext)
      :outcomes ["Symbol coverage guarantee per package" "Executed equals declared or an explicit unreached list" "Required case kinds enforced" "Mutation score reported apart from coverage"]
      :owns ["asl/tools/asl.c" "docs/TEST_CASE_CATALOG.md"]
      :targetSymbols ["run_gate_7"]
      :relatedSymbols ["gates" "concepts" "grading"]
      :invariants ["D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task44208" "Task44401" "Task43901"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44402"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44402.asl"]
      :verificationCases ["An uncovered exported symbol, an unreached assertion without a reason, and a missing required case kind each fail their own guarantee with a distinct message." "A package passing all three still reports its mutation score, and a low score does not silently pass as covered."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44402" :status :notEstablished :contract D81Baseline)
