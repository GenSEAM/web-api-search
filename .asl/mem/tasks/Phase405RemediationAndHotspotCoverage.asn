      :outcomes [
        "Operation q executes resident BM25/hybrid search without shelling out to nonexistent asl intel q"
        "Operation engine tier-0 queries real VFS AST symbols and tier-2 calls web-api-search without hardcoded mocks"
        "Operation patch uses parenthetical form balancing preventing code truncation"
      ]
      :owns ["asl/bin/asl-engine"]
      :targetSymbols ["execute_op" "bm25" "engine" "patch" "q"]
      :relatedSymbols ["D50" "D52" "C1" "C3"]
      :dependsOn ["Task40501"]
      :gate "asl check asl/grammar/rpc.asn"
      :invariants ["C1" "C2" "C3" "C4" "D50" "D52"]
      :variations ["In-process python evaluator vs direct VFS index lookup"]
      :failureModes ["Regex truncation in patch corrupting production source files"]
      :additionalRequirements ["Zero static mock stubs in engine dispatcher"]
      :adr "ADR-0050"
      :decision "D50"
      :actionDag [
        "redirect op q to self.bm25.score with snippet extraction"
        "replace static mock in tier-0-ast with real symbol index scan"
        "replace static mock in tier-2-web with structured provider call"
        "replace patch regex with parenthetical form balance counter"
      ]
      :acceptanceCriteria [
        "asl rpc (:q ...) returns status ok with real matching files"
        "tier-0-ast returns real AST definition coordinates"
        "patch correctly handles nested forms"
      ]
      :stepIndex 0)

