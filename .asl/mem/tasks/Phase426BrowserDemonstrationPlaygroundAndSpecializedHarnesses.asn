      :outcomes [
        "Benchmarked SmolLM2-135M at 128 tok/s and 12ms TTFT in WASM CPU"
        "Established strict 3B parameter ceiling and threshold bounds"
        "Documented single-thread vs multi-thread WebWorker context trade-offs"
      ]
      :owns ["harness/results/browser_models_gallery.asn"]
