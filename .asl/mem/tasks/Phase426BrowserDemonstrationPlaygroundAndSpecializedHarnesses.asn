      :failureModes ["Memory exhaustion above 3B ceiling (mitigated: runtime ceiling guard)"]
      :adr "D72"
      :decision "D72"
      :why "Provide empirical justification for browser model tier selections and threshold bounds"
      :spec "Calibrate models, record telemetry in browser_models_gallery.asn, and verify syntax."
      :acceptanceCriteria ["SmolLM2 evaluated" "Thresholds selected" "Gallery ASN verified"]
      :stepIndex 1
      :actionDag ["Run model calibration" "Benchmark throughput" "Verify gallery file"])
