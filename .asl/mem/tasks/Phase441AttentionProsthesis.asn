    (:task
      :id "Task44103"
      :parentId ""
      :phase "phase-441"
      :title "Bound total retrieval and preserve snapshot-consistent continuation"
      :kind :protocol
      :lane "attention"
      :state :planned
      :priority :high
      :ownerRole "implementer"
      :createdAt 1789171200000
      :updatedAt 1789133687623
      :motivation "Per-operation limits alone do not bound a batch; relevance and recoverable complete state matter more than arbitrary file boundaries. Verified 2026-09-11: positional token buffer str[1024] (asl.c:352) and file[1024]/old_txt[2048]/new_txt[2048]/full_path[2048] cap every argument; (:write f <5000 bytes>) reported :status ok :bytes 1023 and wrote a 1023-byte file, a silent truncation. Dynamic StrBuf sizing for arguments and content is part of this task, and truncation must be an error, never a success."
      :purpose "Cap aggregate batch output as well as child reads under declared tunable budgets; allow a complete relevant small file, return typed continuation with session/snapshot/version binding, and reject stale cursors rather than mixing edited states."
      :context (:contractRef D81PlanContext)
      :outcomes ["Bound total retrieval and preserve snapshot-consistent continuation"]
      :owns ["asl/tools/asl.c" "asl/grammar/rpc.asn" "asl/grammar/session-contract.asn" "asl/grammar/protocol-conformance.asn"]
      :targetSymbols ["read_file_slice" "extract_section" "extract_outline"]
      :relatedSymbols ["sb_append"]
      :invariants ["D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task44102" "Task43808"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44103"
      :actionDag ["Verifier builds aggregate/cursor/read-permission cases." "Implement global and per-op budget accounting." "Bind cursor to snapshot and session." "Validate no leaks and exact continuation." "Independent acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44103.asl"]
      :verificationCases ["Many small child reads cannot exceed aggregate budget; requested limits and default cap are measured with declared token estimator/tokenizer." "Read/sec/out/ls/grep/callers/impact paginate with no omissions/duplicates on a stable snapshot; stale or cross-session cursor is rejected." "Hidden acceptance paths remain unavailable through read/search/outline/error messages, including encoded paths and symlink boundaries." "A complete small relevant file within budget is accepted."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44103" :status :notEstablished :contract D81Baseline)
      :historicalReceipts []
      :reviewStatus :planApproved
      :stepIndex 0
      :receipts [])

