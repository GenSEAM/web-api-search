      :receipts [(:receipt :step 5 :status :ok :hash "HEAD")])

    (:task
      :id "Task44102"
      :parentId ""
      :phase "phase-441"
      :title "Deliver applicable rules without changing the stable prefix"
      :kind :protocol
      :lane "attention"
      :state :planned
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789171200000
      :updatedAt 1789133687623
      :motivation "Scoped rule delivery is a hypothesis about reducing irrelevant context; relevance and authority must survive filtering."
      :purpose "Where returns references or bounded renderings of applicable canonical rules by step kind and tier; append dynamic step data outside the stable base prefix and preserve mandatory permissions/semantic constraints even when a projection is minimal."
      :context (:contractRef D81PlanContext)
      :outcomes ["Deliver applicable rules without changing the stable prefix"]
