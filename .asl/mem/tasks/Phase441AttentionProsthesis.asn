      :actionDag ["Verifier fixes per-step applicability expectations." "Read canonical rules and generate slices." "Append dynamic data without changing base prefix." "Provide bounded authoritative references." "Independent projection acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44102.asl"]
      :verificationCases ["Each step kind receives exactly its applicable rule identities from canonical rules.asn, not a rendered channel as a second source." "Moving between steps changes dynamic context while stable base bytes remain unchanged." "Full applicable rules remain recoverable; metadata budgets do not truncate constraints or force undercounted token claims." "A canonical rule missing when is conservatively treated as all; projection never silently drops an untagged rule."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44102" :status :notEstablished :contract D81Baseline)
