(:taskCollection
  :id "Phase441AttentionProsthesis"
  :createdAt 1789171200000
  :status "planned"
  :priorityOrder 6
  :summary "Attention Prosthesis: external working memory and step-scoped rule delivery so small and long-context models plan, re-anchor, verify and hand off without relying on in-context memory. Implements Tier-3 (D46) as RPC ops usable by any agent with a shell."
  :phase "Phase441AttentionProsthesis"
  :baseline "Historical diagnostics are unverified audit inputs; independent per-task semantic baselines are explicitly pending, not fabricated from missing commands."
  :principles [
    (:principle :id anchor :statement "The plan lives outside the context; the model re-reads it, it does not remember it")
    (:principle :id stepScope :statement "A model receives only the rules that bind the step it is on")
    (:principle :id receipt :statement "Progress is a receipt with an exit code, never a claim")
    (:principle :id bounded :statement "Nothing enters the context unbounded")
    (:principle :id separation :statement "Writers may use public development tests; independently held-out acceptance and runner configuration are protected")
    (:principle :id portable :statement "The protocol has explicit supported-client and host-capability contracts; shell/ASN alone does not establish all-host portability")
  ]
  :phaseGate "for task in Task44101 Task44102 Task44103 Task44104 Task44105 Task44106 Task44107 Task44108 Task44109 Task44110; do sh tests/acceptance/d81/SuperviseGate.sh \"$task\" || exit $?; done"
  :gateReadiness :requiresIndependentBaseline
  :settlement ".asl/mem/reviews/D81PlanSettlement.asn"
  :executionPolicy "Phases execute 436 -> 437 -> 438 -> 439 -> 440 -> 441; each task depends on the preceding conflicting writer; use per-file session leases and one current step per session. Read-only work may run concurrently."
  :verificationPolicy "Acceptance fixtures and runner configuration are verifier-owned and unavailable to implementation authors; public development tests remain readable. Separate acceptance author and final implementation reviewer from implementation writer."
  :tasks [
    (:task
      :id "Task44101"
      :parentId ""
      :phase "phase-441"
      :title "Bind session progression to trusted runner receipts"
      :kind :protocol
      :lane "attention"
      :state :done
      :priority :critical
      :ownerRole "implementer"
      :createdAt 1789171200000
      :updatedAt 1789412200000
      :motivation "A stored author claim is not evidence; ledger progression needs a local trusted execution boundary and version binding."
      :purpose "Persist session-specific plans and leases in the Tier3 ledger; only a trusted local verifier runner may issue progress receipts binding session, step, gate identity, source/artifact digests and actual exit/outcomes; model-supplied exit zero or a nonempty string never advances the ledger."
      :context (:contractRef D81PlanContext)
      :outcomes ["Bind session progression to trusted runner receipts"]
      :owns ["asl/tools/asl.c" "asl/grammar/rpc.asn" ".asl/mem/tasks/InFlight.asn" "asl/grammar/verification-contract.asn" "asl/grammar/session-contract.asn"]
      :targetSymbols ["execute_single_step" "handle_payload"]
      :relatedSymbols ["actionDag" "stepIndex" "handoffContext"]
      :invariants ["C2" "D46" "D51" "D81"]
      :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes)
      :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081"
      :decision "d81"
      :dependsOn ["Task43904" "Task44005"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44101"
      :actionDag ["Verifier establishes forged/stale/replayed receipt cases." "Define session and runner-issued receipt schema." "Implement durable plan/where/checklist and lease handling." "Implement authenticated local runner completion and source invalidation." "Independent transition/crash acceptance."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44101.asl"]
      :verificationCases ["Successful verifier invocation advances exactly the matching current step; false exit, forged receipt, wrong gate/step/session, stale source and replay are rejected without state change." "Receipt issuer has a separate trust boundary from author and cannot be impersonated by supplying a hash; no network signing infrastructure is required." "Concurrent sessions and expired leases cannot clobber plans; crash recovery resumes only durable verified state." "Where returns bounded metadata with references to full gate/constraints/evidence; the 150-token engineering target excludes separately paged authoritative content."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44101" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task44101" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task44101" :assertCount 23 :at 1789412200000)]
      :reviewStatus :approved
