      :gate "test -f asl/packages/asl-compiler/src/wasm.asl && bin/asl test tests/acceptance/d81/Task50601.asl"
      :actionDag ["Author wasm.asl with LEB128 encoders." "Author wasm_leb128_test.asl." "Run gate."]
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task50601.asl"]
      :verificationCases ["Unsigned and signed LEB128 boundary tests." "Dual-polarity refutations of bad encodings."]
      :gateReadiness :verified
      :baselineProbe (:command "bin/asl test tests/acceptance/d81/Task50601.asl" :status :passed :contract D81Baseline)
      :reviewStatus :planApproved
