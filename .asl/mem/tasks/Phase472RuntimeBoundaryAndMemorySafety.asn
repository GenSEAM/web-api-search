      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["tests/acceptance/d81/Task47206.asl"]
      :verificationCases ["Every finding in the audit carries a verified disposition and none carries none." "A finding recorded as repaired fails the check if the defect returns." "A command named by configuration or by a shipped script exists."]
      :gateReadiness :verified
