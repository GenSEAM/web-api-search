      :historicalReceipts [(:receipt :taskId "Task47206" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task47206" :assertCount 9 :at 1789340350000)] :reviewStatus :approved
      :actionDag ["Verify each finding." "Repair or record." "Reconcile the audit." "Independent acceptance."] :stepIndex 4 :receipts [(:receipt :step 4 :status :ok :hash "HEAD")])
    (:task
      :id "Task47207" :parentId "" :phase "phase-472"
      :title "The 810 assertions that are written and never run"
      :kind :remediation :state :done :lane "coverage" :priority :high :ownerRole "implementer"
      :createdAt 1789340000000 :updatedAt 1789340400000
      :motivation "Measured and recorded in SubsystemCoverage20260912: of 8435 assertions written, 7625 execute, leaving 810 that never run across 47 dead suites. Execution has risen from 50.6 percent at the start of this programme to 90 percent, and the remainder is concentrated rather than spread. browser-plugin has 71 assertions and has never executed one. harness carries the largest absolute loss at 584 across fifteen dead suites. Two different deficits hide under one number: a suite whose assertions do not run has a binding defect, while asl-quantum runs all ten of its assertions and has ten for twenty five definitions, which is a coverage defect."
      :purpose "Every dead suite executes or is removed with a recorded reason, and the two deficits are reported separately thereafter so a subsystem is never described as covered because its few assertions all pass."
      :context (:contractRef D81PlanContext)
      :outcomes ["47 dead suites resolved" "browser-plugin executing or retired" "Execution rate and density reported separately" "The concentration visible per subsystem"]
      :owns ["browser-plugin" "editorial-matrix" "web-api-search" "crawler" "harness/tests" "voice/tests"]
      :targetSymbols [] :relatedSymbols ["gates" "semantics" "bounded"]
      :invariants ["D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn ["Task47001" "Task45406"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task47207"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["tests/acceptance/d81/Task47207.asl"]
      :verificationCases ["No suite containing assertions executes zero of them." "A subsystem with a high execution rate and a low density is reported as thin rather than as covered." "A retired suite carries a recorded reason."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task47207" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task47207" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task47207" :assertCount 9 :at 1789340400000)] :reviewStatus :approved
      :actionDag ["Resolve the dead suites." "Separate the two deficits in reporting." "Independent acceptance."] :stepIndex 4 :receipts [(:receipt :step 4 :status :ok :hash "HEAD")])]
  :notes "Task47201 has no dependencies and is the most serious single defect found in this programme. A correction to this programme's own earlier record: it was claimed on 2026-09-11 that is_safe_path accepted a sibling directory sharing the root as a prefix. That claim is false; asl.c:133 checks the boundary character and rejects it. The real defects are the missing resolution, the unguarded call sites and the bridge that bypasses the check entirely.")
