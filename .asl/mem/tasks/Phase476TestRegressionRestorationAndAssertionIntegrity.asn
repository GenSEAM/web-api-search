      :id "Task47601" :parentId "" :phase "phase-476"
      :title "SVG Transpiler Attribute Replacement Ordering & Bench Compaction"
      :kind :remediation :state :completed :lane "codec" :priority :critical :ownerRole "implementer"
      :createdAt 1789380000000 :updatedAt 1789380000000
      :motivation "In svg-transpile.asl, sequential replacement replaces d= before id= (corrupting id=\"bg\" to i:d \"bg\") and x= before cx=/rx=. This attribute corruption reduces token compaction to 27.42%, failing the >=30% gate in svg-transpile-test and the >=25% gate in svg-bench-test."
      :purpose "Reorder string replacements (id= before d=, cx=/rx= before x=, cy=/ry= before y=) to ensure clean transpilation and token compaction >= 30.0%."
      :context (:contractRef D81PlanContext)
      :outcomes ["Compaction savings >= 30.0%" "svg-transpile-test passes" "svg-bench-test passes"]
      :owns ["asl/packages/asl-codec/src/svg-transpile.asl"]
      :targetSymbols ["svg-transpile"] :relatedSymbols ["codec" "compaction"]
      :invariants ["C3" "D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "ADR-0081" :decision "d81" :dependsOn []
      :gate "./bin/asl test asl/packages/asl-codec/tests/svg-transpile-test.asl && ./bin/asl test harness/tests/svg-bench-test.asl"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["asl/packages/asl-codec/tests/svg-transpile-test.asl"]
      :verificationCases ["Measured token savings >= 30.0%." "Both codec and harness SVG test suites pass."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "./bin/asl test asl/packages/asl-codec/tests/svg-transpile-test.asl" :status :failing :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Reorder attribute replacements in svg-transpile.asl." "Verify token compaction measurement." "Run gate."] :stepIndex 0 :receipts ["rc-aslfirst-grounding-20260912"])

