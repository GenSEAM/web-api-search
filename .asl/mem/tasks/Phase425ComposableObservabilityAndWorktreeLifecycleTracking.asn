      :variations ["Lossless infinite logging vs adaptive retention downsampling (chosen: adaptive retention downsampling)"]
      :failureModes ["Log bloat exhausting disk space (mitigated: 256KB compaction ceiling)"]
      :adr "ADR-0071"
      :decision "D71"
      :why "Keep telemetry high-SNR and actionable for tool tuning without token waste"
      :spec "Create .asl/metrics/tools.asn with tool profiles and limitation records."
      :acceptanceCriteria ["File exists" "Syntax check passes" "Tool profiles cataloged"]
      :stepIndex 3
