      :id "T425WebSearchPerProjectMetrics"
      :parentId ""
      :phase "Phase425ComposableObservabilityAndWorktreeLifecycleTracking"
      :title "Implement Per-Project WebSearch Usage Metrics with Git-Ignored Storage"
      :kind :feature
      :lane "harness"
      :state :completed
      :priority :critical
      :ownerRole "architect"
      :createdAt 1773500000000
      :updatedAt 1773500000000
      :startedAt 0
      :completedAt 1773500100000
      :motivation "Web search consumption across multiple projects and engines lacks granular visibility, risking unexpected rate limits and unoptimized engine routing"
      :purpose "Establish per-project WebSearch metric schema, recording queries, engine provider status, response times, and quota exhaustion in git-ignored .asl/metrics/webSearch.asn"
      :context "Extends web-api-search telemetry with isolated metric recording"
      :outcomes [
        "Established .asl/metrics/webSearch.asn in git-ignored location"
        "Captured provider-specific metrics across 6 search backends"
        "Configured 1:10 routine sampling ratio and 1:1 error retention"
      ]
      :owns [".asl/metrics/webSearch.asn"]
      :targetSymbols ["WebSearchMetrics" "PerProjectMetrics" "ProviderTelemetry"]
      :relatedSymbols ["D52" "D70" "D71" "C1" "C4"]
      :dependsOn []
      :gate "test -f .asl/metrics/webSearch.asn && asl check .asl/metrics/webSearch.asn"
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D56" "D57" "D58" "D59" "D60" "D61" "D62" "D63" "D64" "D65" "D66" "D67" "D68" "D69" "D70" "D71"]
      :variations ["Central database vs decentralized git-ignored file stores (chosen: git-ignored file stores)"]
      :failureModes ["Git history pollution with transient metric files (mitigated: added to .aslignore and .asl.config.asn)"]
      :adr "ADR-0071"
      :decision "D71"
      :why "Provide actionable search telemetry without repository churn"
      :spec "Create .asl/metrics/webSearch.asn with complete provider metrics schema."
      :acceptanceCriteria ["File exists" "Syntax check passes" "Provider metrics recorded"]
      :stepIndex 1
      :actionDag ["Define web search metrics schema" "Persist initial telemetry state" "Verify syntax with asl check"])
