    (:task
      :id "Task47005" :parentId "" :phase "phase-470"
      :title "A gate cannot narrow its own scope without saying so"
      :kind :verification :state :done :lane "scope" :priority :critical :ownerRole "verifier"
      :createdAt 1789310000000 :updatedAt 1789407800000
      :motivation "Three distinct gates in this programme have passed while the condition they described was false, and the newest one did it by a mechanism none of the earlier fixes anticipated: it kept working correctly and was given less to look at. Fixing instances one at a time has not held, because the family is larger than any instance."
      :purpose "Every gate reports the extent of what it examined alongside its verdict, and the extent is compared against the extent of the thing it claims to cover. A gate whose coverage falls without a declared reason fails, so narrowing becomes as visible as failing."
      :context (:contractRef D81PlanContext)
      :outcomes ["Coverage reported beside every verdict" "A silent narrowing fails" "The family closed rather than the instance"]
      :owns ["asl/tools/asl.c" "tests/acceptance/d81"]
      :targetSymbols ["run_gate_5_suites" "run_gate_6_grammar" "run_gate_7_skills"] :relatedSymbols ["gates" "output" "concepts"]
      :invariants ["D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn ["Task47001" "Task45506"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task47005"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["tests/acceptance/d81/Task47005.asl"]
      :verificationCases ["Reducing a gate's scope without declaring it fails the run." "Coverage is recomputed each run rather than recorded." "A declared reduction passes and appears in the output."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task47005" :status :baselineVerified :contract D81Baseline)
      :historicalReceipts [(:receipt :taskId "Task47005" :passed true :gate "sh tests/acceptance/d81/SuperviseGate.sh Task47005" :assertCount 13 :at 1789407800000)]
      :reviewStatus :approved
      :actionDag ["Report coverage per gate." "Compare against the claimed extent." "Fail silent narrowing." "Independent acceptance."] :stepIndex 5 :receipts [(:receipt :step 5 :status :ok :hash "HEAD")])
    (:task
      :id "Task47006" :parentId "" :phase "phase-470"
      :title "launch moves into the binary and the script is retired in the same change"
      :kind :engine :state :completed :lane "consolidation" :priority :critical :ownerRole "implementer"
      :createdAt 1789360000000 :updatedAt 1789360000000
      :motivation "The owner has settled it: everything used must live in the binary, and launch is the harness wrapper that substitutes the system prompt. It has now been lost twice to the same cause. Phase 434 consolidated into a single binary and dropped launch; a later commit restored it by putting the script back; a subsequent build wrote the compiled engine over that script again and the subcommand vanished from the command an agent actually runs, because the installed path resolves through it. Restoring the script a third time would only schedule a fourth loss. The script carries 937 lines that are not decoration: workspace root discovery, twenty flags, five client targets, per client channel file injection, AGENTS.md isolation, and two strict invariants for Claude Code which strip dangerous permissions and convert a system prompt overwrite into an append."
      :purpose "launch is a subcommand of the binary, with every flag, every client target and both Claude invariants ported and covered by cases, and the wrapper script is deleted in the same change so no path can resolve to a launcher that the build can overwrite. The build writes only to its own output path and a build that would write over a tracked source fails."
      :context (:contractRef D81PlanContext)
      :outcomes ["launch and launch-session in the binary" "Twenty flags and five client targets ported" "Both Claude invariants preserved and tested" "The wrapper deleted, not kept beside it" "A build writing over tracked source fails"]
      :owns ["asl/tools/asl.c" "asl/asl" "scripts/build_and_install.sh"]
      :targetSymbols ["run_launch" "find_workspace_root"] :relatedSymbols ["foreign" "capabilities" "ssot"]
      :invariants ["C3" "D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn ["Task47003"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task47006"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["tests/acceptance/d81/Task47006.asl"]
      :verificationCases ["Every flag the script accepted is accepted by the binary with the same effect, enumerated one by one rather than sampled." "A launch for Claude Code with a system prompt overwrite converts it to an append and says so." "A launch for Claude Code with dangerous permissions strips them and says so." "A build that would write over a tracked source file fails rather than writing." "After the change no path on disk resolves launch to a shell script."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task47006" :status :notEstablished :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Enumerate the script surface flag by flag." "Port into the binary with the invariants." "Delete the wrapper in the same change." "Fail builds that write over tracked source." "Independent acceptance."] :stepIndex 6 :receipts ["rc-task47006-verified-20260912"])
    (:task
      :id "Task47007" :parentId "" :phase "phase-470"
      :title "The rule payload is read from its source, not rendered into a launcher"
      :kind :engine :state :completed :lane "consolidation" :priority :critical :ownerRole "implementer"
      :createdAt 1789360000000 :updatedAt 1789360000000
      :motivation "The launcher embeds the rule block inline as a directive payload, and the single source renderer writes into it, which makes the launcher one of the rendered surfaces that can drift. Once launch lives in a compiled binary that arrangement gets worse rather than better: a payload compiled in requires a rebuild for every rule change, and drift between the rules and the shipped payload becomes invisible between builds instead of merely detectable."
      :purpose "The payload is read at run time from the rule source, so there is nothing to render into the launcher and nothing to drift. A rule change takes effect without a rebuild, the rendered surface count falls by one, and the drift check for that surface becomes unnecessary rather than passing."
      :context (:contractRef D81PlanContext)
      :outcomes ["Payload read from the rule source at run time" "One rendered surface removed" "A rule change effective without a rebuild" "Drift made impossible rather than detected"]
      :owns ["asl/tools/asl.c" "scripts/install.sh" "asl/grammar/rules.asn"]
      :targetSymbols ["run_launch" "render_between" "inject_directive"] :relatedSymbols ["ssot" "budget" "context"]
      :invariants ["D81"] :variations (:contractRef D81SettledChoices)
      :failureModes (:contractRef D81TaskFailureModes) :additionalRequirements (:contractRef D81Ownership)
      :adr "D81" :decision "d81" :dependsOn ["Task47006" "Task46602"]
      :gate "sh tests/acceptance/d81/SuperviseGate.sh Task47007"
      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier" :verificationOwns ["tests/acceptance/d81/Task47007.asl"]
      :verificationCases ["Editing the rule source changes the injected payload with no rebuild." "A missing or unreadable rule source fails the launch rather than injecting nothing." "The renderer no longer targets the launcher and the drift check for that surface is removed rather than left passing." "The payload injected matches the requested tier exactly."]
      :gateReadiness :requiresIndependentBaseline
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task47007" :status :notEstablished :contract D81Baseline)
      :historicalReceipts [] :reviewStatus :requiresIndependentPlanReview
      :actionDag ["Read the payload at run time." "Drop the launcher from the render targets." "Remove its drift check." "Independent acceptance."] :stepIndex 7 :receipts ["rc-task47007-verified-20260912"])]
  :notes "Task47001 is the single change that restores meaning to every acceptance gate below it, and it has no dependencies. Task47005 exists because this is the third distinct mechanism by which a gate in this repository has reported success while the condition was false.")
