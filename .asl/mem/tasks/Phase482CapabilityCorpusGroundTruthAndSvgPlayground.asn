      :title "Separate Capability Schema from Legacy SkillPack"
      :kind :architecture
      :lane "harness"
      :state :done
      :priority :critical
      :ownerRole "implementer"
      :motivation "Paradigm principles and utility procedures require different schemas and selection semantics."
      :purpose "Harden Capability and CapabilityLink contracts while preserving SkillPack as a legacy compatibility surface."
      :context "Modify only capability module, SkillPack compatibility boundaries, manifest and their tests."
      :outcomes ["No capability import into SkillPack selection" "CamelCase capability fields" "Explicit universal/conditional and required/defaultLoad states"]
      :owns ["harness/src/capabilities.asl" "harness/src/skill_packs.asl" "harness/manifest.asn" "harness/tests/capabilities_test.asl" "harness/tests/skill_packs_test.asl"]
      :targetSymbols ["Capability" "CapabilityLink" "CapabilitySelection" "makeCapability" "selectCapabilities"]
      :relatedSymbols ["Task48201" "D51" "D52" "C3"]
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D56"]
      :variations ["Unified SkillPack schema" "Separate Capability schema with shared loader (chosen)"]
      :failureModes ["Design principles leak into utility selection" "Legacy callers break" "kebab-case public API expands"]
      :additionalRequirements ["Do not redesign the language" "Keep legacy design markers explicitly marked" "Use CamelCase for new composite identifiers"]
      :adr "ADR-0072"
      :decision "D72"
      :dependsOn ["Task48201"]
      :gate "asl check harness/src/capabilities.asl && asl check harness/src/skill_packs.asl && asl test harness/tests/capabilities_test.asl && asl test harness/tests/skill_packs_test.asl"
      :actionDag ["Review schema" "Patch capability fields" "Verify legacy boundary" "Run both suites"]
      :acceptanceCriteria ["Capability and SkillPack are distinct" "14 capability assertions pass or increase" "28 SkillPack assertions pass or increase"]
      :stepIndex 2 :receipts ["rc-task48202-verified-20260912"])
