      :title "Implement Conditional Loading and Explainable Selection"
      :kind :feature
      :lane "harness"
      :state :done
      :priority :high
      :ownerRole "implementer"
      :motivation "Capabilities must be optional, budget-aware and explainable instead of silently changing prompts."
      :purpose "Add applicability scoring, membership and link-strength handling, disabled mode, budget ceilings and selection receipts."
      :context "Reuse context budget infrastructure without importing SkillPack data."
      :outcomes ["Capability-off is empty" "Capability-on is query-sensitive" "Selection remains within budget" "Selection reason is inspectable"]
      :owns ["harness/src/capabilities.asl" "harness/tests/capabilities_test.asl"]
      :targetSymbols ["capabilityScore" "selectCapabilities" "CapabilitySelection"]
      :relatedSymbols ["Task48203" "D46" "D51" "D52"]
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["Always-on capability layer" "Explicit optional conditional layer (chosen)"]
      :failureModes ["Budget overrun" "Irrelevant capability leakage" "Selection without provenance"]
      :additionalRequirements ["Do not alter SkillPack ranking" "Do not add background jobs" "Retain deterministic ordering"]
      :adr "ADR-0072"
      :decision "D72"
      :dependsOn ["Task48203"]
