      :kind :research
      :lane "capability"
      :state :done
      :priority :critical
      :ownerRole "researcher"
      :motivation "Capability principles must be grounded in normative sources rather than aesthetic preference or invented thresholds."
      :purpose "Record W3C SVG, WCAG 2.2 and GOV.UK Design System facts for viewBox, text alternatives, contrast, layout, spacing and colour."
      :context "Research is complete before any corpus expansion or implementation gate is accepted."
      :outcomes ["Source-backed principle matrix" "Claim scope and uncertainty recorded" "Unsupported numeric claims rejected"]
      :owns ["harness/results/capability-ground-truth.asn"]
      :targetSymbols ["CapabilityGroundTruth" "SourceClaim" "PrincipleMatrix"]
      :relatedSymbols ["D4" "D7" "C1" "C4"]
      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52" "D56"]
      :variations ["W3C-only sources" "W3C plus GOV.UK guidance (chosen)"]
      :failureModes ["Normative and advisory guidance conflated" "Citation omitted" "Threshold copied without scope"]
      :additionalRequirements ["Use primary sources" "Preserve source URL and claim scope" "Do not treat design preference as WCAG requirement"]
      :adr "ADR-0072"
      :decision "D72"
      :dependsOn []
      :gate "test -f harness/results/capability-ground-truth.asn && asl check harness/results/capability-ground-truth.asn"
      :actionDag ["Extract W3C claims" "Extract GOV.UK claims" "Encode provenance" "Run ASN check"]
      :acceptanceCriteria ["viewBox claim present" "WCAG 1.4.3 and 1.4.11 claims present" "title/desc claim present" "layout/spacing/colour claims present"]
