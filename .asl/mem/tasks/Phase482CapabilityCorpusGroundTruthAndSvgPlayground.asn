      :actionDag ["Score query" "Filter scope" "Apply budget" "Render selection receipt"]
      :acceptanceCriteria ["Disabled selection count is zero" "Tight budget selects no more than wide budget" "Legacy SkillPack assertions unchanged"]
      :stepIndex 4 :receipts ["rc-task48204-verified-20260912"])
