      :acceptanceCriteria (:contractRef D81BehavioralAcceptance)
      :contractRefs [D81PlanContext D81SettledChoices D81TaskFailureModes D81BehavioralAcceptance D81Baseline D81Ownership D81Receipts]
      :verificationRole "independentVerifier"
      :verificationOwns ["tests/acceptance/d81/Task44601.asl"]
      :verificationCases ["A retained package without an entry point and a gate by the end of this phase fails; a removal-set package that gains an inbound reference is reported." "The component registry and the task list agree on the disposition of every one of the thirteen."]
      :gateReadiness :verified
      :baselineProbe (:command "sh tests/acceptance/d81/SuperviseGate.sh Task44601" :status :baselineVerified :contract D81Baseline)
