      :invariants ["C1" "C2" "C3" "C4" "C5" "D34" "D51" "D52"]
      :variations ["Simulated sandbox exit codes (rejected: masks physical system breakages)"]
      :failureModes ["Subshell hanging during test runs (mitigated: process timeout wrapper)"]
      :adr "ADR-0053"
      :decision "d53"
      :why "Restore absolute physical falsifiability to the inner agent execution loop"
      :spec "Modify harness/src/agent.asl to invoke the physical test-command via process execution, passing genuine exit status into macro-reflect-audit."
      :acceptanceCriteria ["exit-code 0" "strict-falsify test passing"]
      :stepIndex 1
      :actionDag ["Inspect agent.asl:131" "Replace literal true with process execution call" "Replace hardcoded list in worker.asl:404" "Run gates"]
      :handoffContext ""
      :receipts [])

