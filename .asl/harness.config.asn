(:harnessConfig
  :version "1.0.0"
  :profileName "harness-workstation"
  :localePolicy (:primary "en" :secondary "ru" :mixedMode true)
  :acousticDevices [
    (:device :kind :input :name "Default Microphone" :sampleRate 16000 :channels 1)
    (:device :kind :output :name "Default Speaker" :sampleRate 24000)
  ]
  :speakerBiometrics [
    (:speaker :id "primary-operator" :profilePath "~/.asl/harness/speaker_voiceprint.onnx" :strictThreshold 0.82)
  ]
  :localLexicon [
    (:alias :spoken "асекс" :mapsTo "genseam")
    (:alias :spoken "хайнесс" :mapsTo "harness")
    (:alias :spoken "ханес" :mapsTo "harness")
    (:alias :spoken "шроуди" :mapsTo "shrody")
    (:alias :spoken "датахаб" :mapsTo "datahub")
    (:alias :spoken "пцп" :mapsTo "pcp")
  ]
  :processingEndpoints [
    (:tier0 :engine :inMemory :threads 4)
    (:tier1 :engine :sileroOnnx :threads 2 :accelerator :appleNeuralEngine)
    (:tier2 :engine :mlxLocal :model "Qwen2.5-Coder-3B-Instruct-4bit" :port 8081)
    (:tier3 :engine :gatewayProxy :endpoint "http://127.0.0.1:8443/v1/messages")
  ]
  :computerControl [
    (:cdpEndpoint "ws://127.0.0.1:9222/devtools/browser")
    (:accessibilityEnabled true)
    (:screenCaptureDir "~/.asl/run/captures")
  ]
  :meshHub (:socketPath "~/.asl/run/hub.sock" :maxWorkers 8))
