    (:map :ids ["marginal-cost-per-task" "gross-margin-floor" "ltv-to-cac-ratio"] :source "harness/paradigms/business_modeling.asn:72" :action :specialize :to [ProductValue] :change "Keep explicit formulas as scoped accounting examples; retire universal 0.05 USD, 75% margin and 3.5 ratio targets.")]
