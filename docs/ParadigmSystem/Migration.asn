    (:map :ids ["customer-segments" "revenue-streams" "cost-structure" "sustainable-moats"] :source "harness/paradigms/business_modeling.asn:19" :action :specialize :to [ProductValue] :change "Move listed markets, escrow, bridges, daemons, skills, compute, CI, ecosystem effects, training telemetry and proprietary claims to project strategy examples.")
