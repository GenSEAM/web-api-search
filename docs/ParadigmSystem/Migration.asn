(:conceptMigration
  :status :proposal
  :appliedToRuntime false
  :catalog "docs/ParadigmSystem/Catalog.asn"
  :scope "All 31 principles, 11 base axioms, current three modules, twelve action names and ten practices in the cited local sources. Source line references identify the inspected revision, not immutable provenance."
  :dispositions [:keep :merge :specialize :runtimePolicy :retire]
  :meaning "Retire means remove the statement from universal conceptual orientation, preserving its source history; it does not delete the source or negate a scoped project policy."
  :principles [
    (:map :id GroundTruthOverReport :source ".asl/mem/principles.asn:11" :action :merge :to [Evidence] :change "Traceable observations support claims; exit codes are one evidence type, not the only one.")
    (:map :id AGateThatCannotFailIsNotAGate :source ".asl/mem/principles.asn:17" :action :specialize :to [AdversarialAudit] :change "Distinguish reachability, fault detection, scope and oracle quality.")
    (:map :id OutputStatesOnlyWhatWasComputed :source ".asl/mem/principles.asn:23" :action :merge :to [Evidence] :change "Distinguish observations, inference, predictions and adopted values in reports.")
    (:map :id CertificationIsDerivedNeverWritten :source ".asl/mem/principles.asn:29" :action :merge :to [Evidence Feedback] :change "Derived verdicts retain constituent evidence; certification is an operational mechanism.")
    (:map :id TheWriterDoesNotGrade :source ".asl/mem/principles.asn:35" :action :runtimePolicy :to [AdversarialAudit] :change "Adopted project separation of duties; source diversity and reproducibility matter beyond role labels.")
    (:map :id FailLoudlyAndInThePlaceResponsible :source ".asl/mem/principles.asn:39" :action :specialize :to [TypestateRefactor Feedback] :change "Expose failure where diagnostic evidence identifies it; causal locality is investigated, not assumed.")
    (:map :id ReversibilityBeforeOptimality :source ".asl/mem/principles.asn:45" :action :merge :to [Inquiry Engagement] :change "Reversibility has option value; its cost and the task's authority remain explicit.")
    (:map :id FeedbackBeforeControl :source ".asl/mem/principles.asn:49" :action :keep :to [Feedback] :change "Observation informs control; unknown quantities remain unknown rather than forbidding all action.")
    (:map :id VarietyMustMatchTheEnvironment :source ".asl/mem/principles.asn:53" :action :merge :to [Inquiry Feedback] :change "Recognize uncovered situations and adapt using discriminating evidence and bounded effects.")
    (:map :id TheLedgerIsTheMemory :source ".asl/mem/principles.asn:57" :action :merge :to [Attention] :change "Recoverable external state complements working context; exact ledger commands are affordances.")
    (:map :id CompressStructureNeverSpelling :source ".asl/mem/principles.asn:61" :action :specialize :to [RepresentationDesign] :change "Keep measured examples; replace never with consumer-specific comparison preserving meaning.")
    (:map :id MeasuredCostDecidesTheName :source ".asl/mem/principles.asn:68" :action :specialize :to [RepresentationDesign] :change "Name selection considers consumer success, ambiguity and total cost, not token minimum alone.")
    (:map :id OptimisingForTheModelStillSelectsOrdinaryWords :source ".asl/mem/principles.asn:73" :action :specialize :to [RepresentationDesign] :change "Familiar forms are a candidate heuristic; tokenization evidence does not measure understanding.")
    (:map :id NearMissSyntaxIsWorseThanEither :source ".asl/mem/principles.asn:78" :action :specialize :to [RepresentationDesign] :change "Record confusion as a hypothesis requiring model comparison; current basis is token and corpus data.")
    (:map :id PortabilityIsTokenEconomy :source ".asl/mem/principles.asn:84" :action :specialize :to [RepresentationDesign Boundaries] :change "Include binding, transfer and decoding costs; self-description is not always smallest.")
    (:map :id CoreKnowsNoExtension :source ".asl/mem/principles.asn:90" :action :specialize :to [Boundaries TypestateRefactor] :change "Declare an adopted dependency direction, not an empirical universal law.")
    (:map :id TwoStrikesBeforeAbstraction :source ".asl/mem/principles.asn:96" :action :specialize :to [Boundaries TypestateRefactor] :change "Repeated equal contracts motivate extraction; the count two is a project heuristic with exceptions.")
    (:map :id BoundaryUniversalismWithLocalAutonomy :source ".asl/mem/principles.asn:100" :action :keep :to [Boundaries] :change "Canonical contracts cross boundaries; distinct encodings and domain contracts retain local semantics.")
    (:map :id DependencyFlowsOneWay :source ".asl/mem/principles.asn:104" :action :merge :to [Boundaries TypestateRefactor] :change "Keep declared dependency direction with scope and checks; not every system has one core-extension topology.")
    (:map :id DuplicationIsUsuallyDownstream :source ".asl/mem/principles.asn:109" :action :merge :to [Inquiry TypestateRefactor] :change "Investigate causes of duplication; local examples do not establish usually across systems.")
    (:map :id StructuralTaxIsNotOverhead :source ".asl/mem/principles.asn:114" :action :specialize :to [RepresentationDesign] :change "Retain measured corpus and tokenizer scope; delimiters preserve structure but optimality is comparative.")
    (:map :id MeasureTheThingNotItsProxy :source ".asl/mem/principles.asn:122" :action :keep :to [Purpose Evidence Inquiry] :change "Evaluate intended outcomes and calibrate affordable proxies against them.")
    (:map :id DeclaredIsNotWorking :source ".asl/mem/principles.asn:126" :action :merge :to [Evidence] :change "Observed capabilities include operation, environment, limits and freshness; declarations are distinct.")
    (:map :id DocumentationThatMisdirectsIsWorseThanNone :source ".asl/mem/principles.asn:132" :action :merge :to [Evidence Attention] :change "Stale guidance can cause costs; no universal ordering of all documentation failures is asserted.")
    (:map :id PurposeNotPersona :source ".asl/mem/principles.asn:137" :action :merge :to [Purpose Engagement SwarmCoordination] :change "Responsibility is functional; a role's allowed operations are separate policy.")
    (:map :id VisibilityIsScoped :source ".asl/mem/principles.asn:141" :action :runtimePolicy :to [Boundaries Attention] :change "Repository topology is a local visibility contract, not a universal mental model.")
    (:map :id ReadBySymbolAndSlice :source ".asl/mem/principles.asn:145" :action :merge :to [Attention] :change "Retrieve pertinent evidence with bindings and recovery; a complete relevant small object may be appropriate.")
    (:map :id OneWriterPerOwnedPartition :source ".asl/mem/principles.asn:149" :action :specialize :to [SwarmCoordination] :change "Conflicting effects require partitioning, ordering or another explicit concurrency contract.")
    (:map :id AStepIsATransaction :source ".asl/mem/principles.asn:154" :action :runtimePolicy :to [TypestateRefactor SwarmCoordination] :change "Keep the repository transaction protocol; exploratory reasoning need not masquerade as a write transaction.")
    (:map :id NumbersCarryScopeOrTheyAreNotClaims :source ".asl/mem/principles.asn:158" :action :merge :to [Evidence] :change "Distinguish measurements, estimates, goals and illustrative values with provenance and scope.")
    (:map :id NormativeAndEmpiricalAreNotMixed :source ".asl/mem/principles.asn:163" :action :keep :to [Evidence] :change "Normative force and evidential support remain orthogonal axes.")]
  :axioms [
    (:map :id "energy-conservation" :source "harness/paradigm.asn:5" :action :merge :to [Attention] :change "Remove universal SNR 0.75 and fifty-line limit from conceptual orientation.")
    (:map :id "physical-truth" :source "harness/paradigm.asn:6" :action :merge :to [Evidence AdversarialAudit] :change "Executed assertions support software checks, not every knowledge claim.")
    (:map :id "boundary-universalism" :source "harness/paradigm.asn:7" :action :merge :to [Boundaries] :change "Shared contract does not imply one transformation for every wire encoding.")
    (:map :id "judicious-autonomy" :source "harness/paradigm.asn:8" :action :merge :to [Inquiry Engagement] :change "Effort follows consequences, uncertainty and resources; mode budgets are local policy.")
    (:map :id "zero-sigils" :source "harness/paradigm.asn:9" :action :runtimePolicy :to [RepresentationDesign] :change "Keep syntax constraints in their actual grammar scope.")
    (:map :id "pure-asn-memory" :source "harness/paradigm.asn:10" :action :runtimePolicy :to [Attention RepresentationDesign] :change "ASN storage is an adopted boundary; preserved meaning and recovery define the conceptual requirement.")
    (:map :id "responsibility-unit" :source "harness/paradigm.asn:11" :action :merge :to [Purpose Engagement] :change "Outcome commitment remains bounded by explicit authority and constraints.")
    (:map :id "epistemic-steps" :source "harness/paradigm.asn:12" :action :merge :to [Evidence Attention Feedback] :change "Separate epistemic lenses from executable flow transitions and measured capabilities.")
    (:map :id "adaptive-homeostasis" :source "harness/paradigm.asn:13" :action :merge :to [Feedback Engagement] :change "Use bounded adaptive feedback; three replans is a local tunable limit, not a law.")
    (:map :id "audit-institutionalization" :source "harness/paradigm.asn:14" :action :retire :to [Feedback] :change "An audit finding becomes scoped evidence or a proposal; it does not automatically become an axiom.")
    (:map :id "strict-binary-whitelist" :source "harness/paradigm.asn:15" :action :runtimePolicy :to [Boundaries] :change "Host-tool authorization is an environment contract, not a universal thought principle.")]
  :moduleConcepts [
    (:map :ids ["human-agency-priority" "semantic-resonance-fidelity"] :source "harness/paradigms/human_resonance.asn:6" :action :merge :to [HumanCoordination] :change "Retain agency and audience calibration; remove numerical SNR assertion.")
