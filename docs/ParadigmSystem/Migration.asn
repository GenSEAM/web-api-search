    (:map :ids ["system-1-intuitive" "system-2-deliberative"] :source "harness/paradigms/reflexive_control.asn:25" :action :specialize :to [HumanCoordination DesignSystem] :change "Defaults, feedback, recognition, comparison and checkpoints are interaction choices; near-zero load is not established.")
    (:map :ids ["loss-aversion" "status-quo-bias" "choice-overload" "anchoring-bias"] :source "harness/paradigms/reflexive_control.asn:34" :action :specialize :to [HumanCoordination Inquiry] :change "Use as possible explanations, not diagnoses; rollback, migration, bounded choice and objective baselines are defeasible strategies.")
    (:map :ids ["under-trust" "calibrated-trust" "over-trust"] :source "harness/paradigms/reflexive_control.asn:40" :action :specialize :to [HumanCoordination] :change "Reliance should match evidence; micromanagement or delegation alone cannot diagnose user trust or justify imposed friction.")
    (:map :ids ["economic-sustainability" "value-capture-alignment"] :source "harness/paradigms/business_modeling.asn:6" :action :specialize :to [ProductValue] :change "Economic sustainability and monetization are scoped project goals; research or public benefit may use different value criteria.")
    (:map :ids ["local-slm-margin-shield"] :source "harness/paradigms/business_modeling.asn:8" :action :specialize :to [ProductValue Inquiry] :change "Routing compares measured task success and total costs; local inference has nonzero resource and opportunity costs.")
    (:map :ids ["composable-app-modularity"] :source "harness/paradigms/business_modeling.asn:9" :action :merge :to [Boundaries] :change "Composability uses declared contracts; sandbox requirements are deployment policy.")
