      :observed "[ASL_ASSERTION_FAILURE]: Review exhaustion cannot turn an unresolved defect into success"
      :productionSource "harness/src/agent.asl:54"
      :cleanup "Only the reviewer-created transient probe was removed; the actual harness was unchanged.")
    (:run :case :invalidBaselineAttempt :exit 1
