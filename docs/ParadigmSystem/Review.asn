      :observed "[ASL_ASSERTION_FAILURE]: Exhaustion with unresolved work never passes"
      :meaning "The unchanged tests detect this actual policy defect; no broader mutation score is claimed.")
    (:run :case :actualHarnessSemanticBaseline :exit 1 :reachedFailingSites 1
