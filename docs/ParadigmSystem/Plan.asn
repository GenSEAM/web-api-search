    (:step :id Inventory :state :complete :owner paradigmInventory :owns ["docs/ParadigmSystem/Catalog.asn" "docs/ParadigmSystem/Essential.asn" "docs/ParadigmSystem/Migration.asn"] :gate "Independent reviewer checks source-to-concept coverage, resolvable concept dependencies, orthogonal axes and retained essential distinctions.")
    (:step :id Flow :state :complete :owner paradigmFlows :owns ["docs/ParadigmSystem/Flow.asl" "docs/ParadigmSystem/FlowTest.asl" "docs/ParadigmSystem/FlowEvidence.asn"] :gate "Execute semantic baseline probe on existing review behavior; execute reference-policy tests including exhausted unresolved review, stale evidence, insufficient budget and successful completion; independently invert assertions and mutate policy.")
    (:step :id Synthesis :state :complete :owner root :owns ["docs/ParadigmSystem/Design.asn" "docs/ParadigmSystem/Research.asn" "docs/ParadigmSystem/Plan.asn" "docs/ParadigmSystem/ContextEngine.asn" "docs/ParadigmSystem/AgentProtocol.asn"] :gate "Independent gap review checks every user directive, context mechanism inventory and combinations, streaming snapshot consistency, bounded prefetch, event delivery and task transitions, script capabilities, discussion termination, 1000-token accounting and design-only scope.")
    (:step :id Review :state :complete :owner independentReviewer :owns ["docs/ParadigmSystem/Review.asn"] :gate "Read actual files; run checks and reference-policy tests; record exact commands, exits, assertions, invalid probes and unresolved limitations. No approval solely from author reports.")])
