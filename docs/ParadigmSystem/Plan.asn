  :steps [
    (:step :id MarkerForms :state :complete :owner root :owns ["docs/ParadigmSystem/MarkerForms.asn"] :gate "Independent normative grammar parsing and offline token measurement of marker projections; distinguish syntax, schema semantics and unmeasured model understanding; explicitly supersede the earlier unvalidated bare-symbol example." :reviewOwner evidenceAudit :reviewPath "docs/ParadigmSystem/MarkerFormsReview.asn" :grammarMethod :manualDerivation :executedFullParser false)
