(:contextDesign :id ContextEngine :version "0.1.0" :status :conceptual :implementation :future
  :purpose "Prepare the evidence and concepts needed for the next decision while ingestion, storage and retrieval continue independently of model inference."
  :scope "One bounded active model context over a larger addressable store. Storage, retrieval, time and compute remain finite; unlimited effective history is a paging abstraction, not an unlimited attention window."
  :reuse "Reuse the existing memory store, lexical/structural indexes and tool adapters where their contracts hold. The following are responsibilities within an engine, not a requirement for separate services."
  :responsibilities [
    (:component :id BlockStore :owns ["Immutable block revisions" "Source and derivation links" "Workspace visibility" "Retention and recovery"] :excludes ["Deciding truth from text" "Model invocation"])
    (:component :id ContextSelector :owns ["Question-to-query planning" "Required evidence coverage" "Dependency closure" "Candidate relevance and freshness"] :excludes ["Tool authorization" "Changing source contents"])
    (:component :id FetchScheduler :owns ["Async local and web retrieval" "Bounded prefetch" "Cancellation and deadlines" "Ingestion events"] :excludes ["Blocking ready work on speculative requests" "Inventing successful fetch results"])
    (:component :id PromptAssembler :owns ["Whole-envelope token accounting" "Snapshot-consistent materialization" "Stable selected prefix" "Explicit omission manifest"] :excludes ["Silently dropping required content" "Mutating an in-flight prompt"])
    (:component :id ContextAdapter :owns ["Model-facing context status" "Request and result schemas" "Tool-result normalization" "Provider boundary integration"] :excludes ["Granting permissions through retrieved text" "Equating summaries with source evidence"])]
  :existingMechanisms [
    (:mechanism :id BlockAssembly :source "harness/src/context_assembler.asl:30" :status :sourceAlgorithm :finding "Block records and greedy accumulation; chars/4 estimate and silent overflow eviction." :disposition :revise :target PromptAssembler)
    (:mechanism :id PriorityScoring :source "harness/src/context_priority.asl:19" :status :sourceAlgorithm :finding "Arithmetic over supplied relevance scores; not measured contextual usefulness." :disposition :consolidate :target ContextSelector)
    (:mechanism :id JitPrefetch :source "harness/src/context_assembler.asl:264" :status :markerOnly :finding "Creates prefetch text; gateway manufactures query-derived AST/memory/web/git snippets at harness/src/engine_gateway.asl:41." :disposition :replaceAdapter :target FetchScheduler)
    (:mechanism :id GraphHorizon :source "intel/src/preload.asl:167" :status :partialAlgorithm :finding "Traverses a supplied graph; root AST is a label and convenience entry supplies an empty graph." :disposition :retainAlgorithm :target ContextSelector)
    (:mechanism :id HybridRanking :source "mem/src/rrf.asl:80" :status :sourceAlgorithm :finding "Rank fusion over supplied candidates; another implementation at mem/src/driver.asl:99. BM25 text indexing exists at mem/src/spool_search.asl:61; summary matching at mem/src/summary_search.asl:68." :disposition :consolidate :target ContextSelector)
    (:mechanism :id Pointers :source "mem/src/pointer_orchestrator.asl:36" :status :inputTransform :finding "Dereference accepts content as an argument; no demonstrated storage fetch. knowledge_mount.asl:54 truncates by characters." :disposition :connectAdapter :target BlockStore)
    (:mechanism :id HistoryCompaction :source "harness/src/compactor.asl:44" :status :unsafeTransform :finding "exec-cmd text becomes verified gate regardless of actual failure; truncation has no recovery pointer." :disposition :replaceSemantics :target ContextAdapter)
    (:mechanism :id Hydration :source "mem/src/hydration.asl:33" :status :labelTransform :finding "Prefix-based fact extraction and constant confidence 0.95; not verified knowledge extraction." :disposition :separateObservationFromClaim :target BlockStore)
    (:mechanism :id PrefixReuse :source "harness/src/prompt_cache.asl:59" :status :sourceAlgorithm :finding "Stable serialized prefix, not provider cache-hit proof. agent-core/src/prompt_tree.asl:82 retains only parent and leaf." :disposition :retainAndRepair :target PromptAssembler)
    (:mechanism :id PoolsAndVisibility :source "agent-core/src/promptpool.asl:52" :status :sourcePolicy :finding "TTL/count pruning; mem/src/visibility_scope.asl:49 filters supplied scope lists. Neither proves host access enforcement or token fit." :disposition :retainPolicy :target BlockStore)
    (:mechanism :id VersionedMemory :source "mem/src/vfs.asl:139" :status :sourceAlgorithm :finding "Immutable registry and merge computation at mem/src/stm.asl:184; subtree hash reuse at mem/src/subtree_cache.asl:127. No demonstrated atomic host commit." :disposition :connectAuthority :target BlockStore)
    (:mechanism :id ToolDispatch :source "agent-core/src/dispatch.asl:67" :status :syntheticResult :finding "Recall similarity and fetch/search output are fabricated strings; no demonstrated live stream integration." :disposition :replaceAdapter :target ContextAdapter)]
  :inventoryScope "Static inspection of these mechanisms, not a proof that every repository path or deployed binary behaves identically; no production integration tests were run."
  :blockContract (
    :required [:id :revision :kind :scope :origin :contentRef :digest :state]
    :kind [:source :observation :modelOutput :summary :task :concept :receipt :toolResult]
    :state [:streaming :sealed :partial :superseded :unavailable]
    :optional [:timestamp :tokenCounts :trustClass :entityKeys :taskRefs :expiry :summaryRef]
    :identity "Content digest identifies immutable bytes; logical block ID plus revision tracks updates. Identical bytes can have different provenance or access scope."
    :edges [:derivedFrom :summarizes :supports :contradicts :supersedes :dependsOn]
    :edgeMeaning "An edge records a declared or verified relationship and its issuer; a model-created supports edge is not automatically validated entailment."
    :tokenCounts "Each cached count is keyed by content digest, tokenizer and serialization profile."
    :visibility "Workspace and session scope are enforced before indexing or retrieval results become visible."
    :retention "Pinned current evidence and active-task dependencies survive compaction. Quotas, garbage collection and unavailable references are explicit.")
  :selectionContract (
    :inputs [:taskFrame :currentQuestion :criteria :openIssues :contextRevision :capabilities :budget]
    :requiredCoverage [:intent :authority :currentFailure :criticalConstraints :decisionEvidence :actionSchema]
    :querySources ["Explicit user request" "Unresolved claim" "Failed criterion" "Missing dependency" "Expected next action inputs"]
    :retrievalOrder "Exact reference or symbol lookup when known; lexical and structural search for local evidence; semantic retrieval as an additional candidate generator when measured available; public web for external or time-sensitive evidence."
    :candidateSignals [:questionRelevance :criterionCoverage :sourceReliability :scopeMatch :freshness :novelty :contradictionValue :materializationCost]
    :ranking "Signals guide a bounded selection heuristic. No unmeasured scalar score is called optimal, and relevance alone cannot evict a mandatory precondition."
    :counterEvidence "Include material disconfirming observations; corroboration-only selection reinforces a hypothesis instead of testing it."
    :dependencyClosure "A reference that needs a schema, definition or unresolved qualification carries that dependency or an explicit retrieval route."
    :missing "When a decision lacks material evidence, return NeedContext with a query or a declared unsupported capability; do not fill the space with irrelevant text.")
  :streamingContract (
    :path [:request :retrieve :ingest :index :select :materialize :invoke :recordOutput :update]
    :concurrency "Store ingestion, indexing and bounded prefetch can run while the model works on a stable materialized snapshot."
    :snapshot "Each model invocation records taskVersion, contextRevision and exact block revisions. Later arrivals enter the pending queue for the next supported tool or turn boundary."
    :providerBoundary "For providers that only accept input at invocation boundaries, new context cannot be injected into an already running completion. Critical invalidation requests cancellation where supported or rejects stale downstream actions."
    :commitCheck "An action depending on changed task, evidence or workspace state is revalidated against its preconditions before effects are committed."
    :backpressure "Bound queued bytes, pending requests and concurrent fetches. Prefer demanded and task-critical work over speculative prefetch."
    :progress "A slow optional source does not block a ready independent action. Work whose correctness depends on a missing source waits or reports incomplete evidence."
    :cancellation "Cancelled or superseded requests stop materialization; late results may be stored under their origin but cannot silently become current context."
    :failure "Partial streams, retrieval errors and unavailable blocks have explicit states, retry eligibility and source references.")
  :prefetchContract (
    :intent "Continuously prepare substantial decision-relevant context, including ahead-of-need retrieval when uncertainty remains."
    :triggers [:taskAccepted :nextDependencyKnown :claimUnresolved :criterionFailed :sourceStale]
    :speculation "Candidate next questions may launch bounded speculative local or web queries; their results are hypotheses about relevance until admitted by the selector."
    :budget "A configurable share of remaining retrieval time, requests and bytes; no universal percentage. Mandatory work and output capacity remain reserved."
    :web "Use the same tool capability and data-scope boundary as ordinary search. Public queries retain source URLs, fetch time and provenance; unrelated private context is not copied into a query."
    :dedup "Coalesce equivalent queries with compatible scope, freshness and authorization; cache misses or failed queries are explicit."
    :stop "Cancel speculative work when intent changes, deadlines expire or its inputs become irrelevant."
    :measurement [:prefetchHitRate :unusedFetchCost :decisionLatency :sourceFreshness :verifiedCompletion]
    :limit "Prefetch can hide some latency but cannot guarantee useful results or zero waiting.")
  :outputMemoryContract (
    :capture "Append model output to a dedicated streaming block; seal its content digest at completion and retain a partial status on interruption."
    :summary "Store the summary as a separate derived block with source revision and coverage/omission metadata."
    :retrieval "Index the original output and the summary. Use the summary for discovery and reopen original spans for exact claims, constraints or disputed details."
    :knowledgeStatus "Model output begins as a proposal or report. Only an appropriate external observation or verification can support a stronger claim."
    :summaryRefresh "A changed source invalidates its derived summary until regenerated or explicitly retained as historical."
    :lossControl "Critical constraints, unresolved errors and qualifications have explicit coverage obligations; generic compression ratio is insufficient."
    :choice "Summaries, reference-only blocks and search-indexed originals coexist. Choose materialization by current question rather than a universal summary-everything policy.")
  :combinations [
    (:combination :id ExactThenRelevant :parts [:referenceLookup :structuralSearch :semanticCandidates :criterionCoverage] :use "Known artifacts plus an uncertain related question." :limit "Semantic similarity does not establish relevance or truth.")
    (:combination :id StablePrefixFreshDelta :parts [:essentialProfile :stableSchema :taskFrame :currentEvidenceDelta] :use "Repeated work with stable contracts." :limit "Changed permissions, task scope or schema invalidate the affected prefix.")
    (:combination :id SummaryWithRecovery :parts [:rawOutputBlock :derivedSummary :searchIndex :spanRetrieval] :use "Long interaction histories." :limit "A summary alone cannot certify omitted constraints.")
    (:combination :id ProgressiveToolResults :parts [:boundedExcerpt :sourceReference :continuation :snapshot] :use "Large source files, web pages and tool outputs." :limit "Continuation must preserve revision and report expiry.")
    (:combination :id SpeculativeFetch :parts [:nextQuestionPrediction :asyncRetrieval :boundedQueue :admissionCheck] :use "Likely next dependencies or slow external sources." :limit "Speculation yields optional candidates, never automatic authority.")
    (:combination :id HandoffWithExternalState :parts [:taskFrame :criticalState :openIssues :blockRefs :newContext] :use "Long tasks and small model windows." :limit "The recipient must have access to the referenced blocks and understand the protocol.")]
  :consolidations [
    (:item :action :merge :mechanisms ["Context scoring" "Priority ranking" "Budget selection"] :into ContextSelector :reason "One admission policy avoids competing independent rankings.")
    (:item :action :retainSeparate :mechanisms ["Source store" "Summary store" "Working prompt"] :reason "Original evidence, lossy interpretation and current projection have different contracts.")
    (:item :action :merge :mechanisms ["Pointer lookup" "Artifact read" "Memory retrieval"] :into "One versioned block-reference interface with specialized indexes behind it.")
    (:item :action :retire :mechanisms ["Characters divided by four as certified token accounting" "Silent essential eviction" "Fixed SNR claims" "Simulated benchmark latency labelled measurement"] :reason "These substitute a proxy or invented result for the required observable.")
    (:item :action :avoidDefault :mechanisms ["All-history reinjection" "Summarize every result" "Always launch an LLM to route a known operation"] :reason "Apply only when a specific task and measurement justify their cost.")]
  :modelInterface (
    :orientation "A context manager keeps sources outside this window, assembles relevant blocks and records omissions. Request a block, source span or missing concept by reference; absence here does not mean absence from storage."
    :operations [:contextStatus :requestContext :readBlock :searchBlocks :expandSummary :pinEvidence]
    :statusFields [:taskVersion :contextRevision :loadedRefs :availableRoutes :omittedRefs :pendingRequests :budgetState]
    :admission "Only implemented and authorized operations appear in the model's interface. Unsupported semantic search returns Unsupported, not an empty successful result."
    :schemaSharing "The full runtime envelope stays outside the smallest model prompts. A deterministic view exposes task, relevant body and needed references, preserving source identity and scope.")
  :plannedTests [
    (:test :id RequiredContextNeverEvicted :expect "A too-small budget returns BudgetInsufficient with missing requirements.")
    (:test :id SnapshotIsolation :expect "Concurrent ingestion cannot mix source revisions inside one materialized snapshot.")
    (:test :id StaleActionRejected :expect "A relevant source/task change invalidates a pending action precondition.")
    (:test :id OutputRecovery :expect "A summary can locate exact original output spans, including partial interrupted streams.")
    (:test :id ContradictionSurvivesCompression :expect "An unresolved contradictory observation remains in current coverage or explicit pending work.")
    (:test :id ScopeIsolation :expect "Search and coalesced prefetch do not expose another workspace's blocks.")
    (:test :id PrefetchBackpressure :expect "Slow or unused speculative requests cannot exhaust demanded-work capacity.")
    (:test :id UnsupportedSearchTruth :expect "An absent retrieval capability is distinguishable from a valid empty result.")
    (:test :id WindowAccounting :expect "Exact serialized input plus declared output reserve fits a pinned tokenizer budget, or fails explicitly.")
    (:test :id CombinationAblation :expect "Compare each combination against simpler baselines on completion, omissions, total cost and latency; equal outcomes are allowed.")]
  :testStatus :plannedNotRun)
