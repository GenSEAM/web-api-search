(:agentDesign :id AgentProtocol :version "0.1.0" :status :conceptual :implementation :future
  :purpose "Event-driven cooperation whose routing, state changes and repeatable execution run as programs; models author or evaluate substantive artifacts when needed."
  :topology "Begin with one authoritative coordinator and durable role queues per workspace. A distributed mesh is an optional deployment, not a prerequisite for an agent grid."
  :staticLevel "ASN declares message schemas, task states, transition tables and script manifests. ASL implements pure transition decisions and validated scripts. A host adapter persists state, delivers events and performs authorized effects."
  :modelBoundary "The model is called for interpretation, planning, code generation, substantive review or a new unresolved decision. Delivery, parsing, routing, deduplication, timers, known tests and validated script execution do not require a model call."
  :existingMechanisms [
    (:mechanism :id BusEvents :source "agent-bus/src/bus.asl:17" :status :dataModel :finding "Sender/target/payload exist; dispatch at line85 returns delivered=true without delivery." :reuse "Typed event body; replace delivery claims with actual adapter receipts.")
    (:mechanism :id TransportFrame :source "agent-bus/src/transport.asl:24" :status :schemaAndValidation :finding "ID, type, sequence and payload; field validation does not establish ACK or dedup." :reuse "One canonical envelope and conformance corpus.")
    (:mechanism :id CausalMessages :source "agent-bus/src/mvcc_bus.asl:18" :status :sourceAlgorithm :finding "Parents/clock/epoch; publishing appends to a supplied list without uniqueness or parent validation." :reuse "Causal references; defer distributed clocks unless required.")
    (:mechanism :id CoreEvents :source "agent-core/src/core.asl:136" :status :dataModel :finding "Subscriber list and event log; publication appends a string without invoking handlers." :reuse "Explicit subscriptions and deterministic handler dispatch.")
    (:mechanism :id TaskQueue :source "agent-core/src/taskstore.asl:29" :status :sourceAlgorithm :finding "Map updates despite disk-backed description; scheduler consumes supplied state." :reuse "Task transition logic behind an actual durable coordinator.")
    (:mechanism :id Leases :source "mem/src/task_lease.asl:16" :status :sourcePolicy :finding "Expiry and heartbeat records; agent-bus/src/mesh.asl:173 has another buffer lease model." :reuse "Common lease authority and fencing contract; separate resource types.")
    (:mechanism :id DagCas :source "agent-core/src/dag.asl:107" :status :sourceAlgorithm :finding "Compares supplied versions; not an atomic persistence operation." :reuse "Version precondition checked by the authoritative store.")
    (:mechanism :id TaskReceipts :source "mem/src/tasks_store.asl:32" :status :schemaAndNumericChecks :finding "Exit/assertion/digest fields do not authenticate origin; task completion can accept a caller receipt string." :reuse "Receipt data with trusted issuer and task/artifact binding.")
    (:mechanism :id RoleCycle :source "agent-core/src/fsm.asl:41" :status :sourcePolicy :finding "review-fail returns to coding without a bounded-progress contract." :reuse "Role transitions with persistent task budgets and finding identity.")
    (:mechanism :id ScriptRunner :source "harness/src/script-sandbox.asl:58" :status :syntheticResult :finding "Substring validation and string length yield synthetic success; no interpreter or enforced timeout here." :reuse "Manifest fields only; real runner admission and execution are required.")]
  :inventoryScope "Static source inspection, not runtime integration verification. Existing source algorithms remain useful independently of their missing host effects."
  :routing (
    :commands "Direct to one capability-qualified handler; tasks are claimed once by the authoritative scheduler."
    :events "Subscriptions route typed events to deterministic handlers; broadcasts do not force every model to read every message."
    :parallelism "Disjoint owned partitions and genuinely independent review questions may proceed concurrently; conflicting writes serialize."
    :deadLetters "Malformed, unsupported or undeliverable messages retain a bounded diagnostic record and explicit failure; retries consume the task budget."
    :reviewIndependence "Distinct authorship and protected criteria are enforced mechanically. Different role names or model instances alone do not guarantee independent evidence.")
  :roles [
    (:role :id Planner :input [:taskFrame :constraints :availableCapabilities] :output [:planArtifact :criteria :dependencies] :ownership "Plan proposal; acceptance remains external to the author.")
    (:role :id Executor :input [:acceptedPlan :ownedSources :contextSnapshot] :output [:artifactRevision :scriptProposal :changeExplanation] :ownership "Declared write partition and author-owned development checks.")
    (:role :id Reviewer :input [:criteria :artifactDigest :runnerReceipt :relevantEvidence] :output [:reviewVerdict :findings] :ownership "Independent assessment and reviewer-owned acceptance; review cannot silently change criteria.")
    (:role :id Fixer :input [:openFindings :criterionRefs :artifactRevision] :output [:replacementRevision :findingResponses] :ownership "Narrow corrective changes; acceptance returns to an independent reviewer.")
    (:role :id Coordinator :kind :deterministicRuntime :input [:events :taskState :policy] :output [:commands :stateChanges] :ownership "Only authority for task transitions, budgets and leases.")
    (:role :id Runner :kind :deterministicRuntime :input [:validatedScript :inputs :capabilities] :output [:executionReceipt] :ownership "Actual execution and observed exit/output/resource status.")]
  :rolePolicy "Roles are responsibilities, not fixed model identities. Use only the roles needed by the task; simple known operations may run directly. The same author can fix its work, but cannot issue its own independent acceptance."
  :envelope (
    :required [:version :messageId :kind :taskId :attempt :source :correlationId :body]
    :optional [:target :causedBy :expectedRevision :artifactRef :artifactDigest :deadline :leaseToken]
    :identity "The runtime issues message IDs and authenticates source identity; claimed fields from model output do not establish authority."
    :command "A request addressed to a handler; it can be rejected or remain pending."
    :event "An immutable statement that a source observed an occurrence. Delivery of an event does not establish acceptance of the task outcome."
    :body "Typed payload for the declared kind, serialized by the canonical ASN codec. Unknown versions/kinds return an explicit protocol error."
    :modelView "The adapter supplies runtime metadata. Small models see only their assignment, relevant artifact references, expected response schema and necessary constraints."
    :largePayload "Source files, outputs and discussion transcripts are block references with revision/digest; short task-critical details may be inline.")
  :payloads [
    (:payload :kind TaskReady :fields [:taskRef :criteriaRef :contextRef])
    (:payload :kind PlanProposed :fields [:planRef :criteriaRef :dependencies])
    (:payload :kind PlanAccepted :fields [:planDigest :criteriaDigest :acceptanceRef])
    (:payload :kind PlanRejected :fields [:planDigest :findingsRef])
    (:payload :kind ScriptProposed :fields [:scriptRef :sourceDigest :manifestRef])
    (:payload :kind ScriptRejected :fields [:scriptDigest :findingsRef])
    (:payload :kind RunRequested :fields [:scriptDigest :inputsRef :capabilityGrantRef])
    (:payload :kind RunFinished :fields [:receiptRef :outcome :artifactDigest])
    (:payload :kind ReviewRequested :fields [:artifactRef :criteriaRef :receiptRef])
    (:payload :kind ReviewPassed :fields [:artifactDigest :criteriaDigest :reviewRef])
    (:payload :kind FixRequested :fields [:findingsRef :artifactDigest :criteriaRef])
    (:payload :kind FixSubmitted :fields [:replacementDigest :findingResponsesRef])
    (:payload :kind ClarificationRequested :fields [:question :blockingReason :relatedRefs])
    (:payload :kind ClarificationResolved :fields [:decisionRef :taskVersion])
    (:payload :kind EffectReconciled :fields [:receiptRef :effectDisposition])
    (:payload :kind BudgetExhausted :fields [:resource :consumed :limit])
    (:payload :kind TaskBlocked :fields [:reason :openFindingsRef :triedRefs :resumptionCondition])
    (:payload :kind TaskCancelled :fields [:reason :taskVersion])
    (:payload :kind TaskCompleted :fields [:artifactDigest :criteriaDigest :acceptanceRef])]
  :authority (
    :runtimeIssued [:RunFinished :TaskCompleted :TaskBlocked :TaskCancelled :BudgetExhausted :ScriptRejected :EffectReconciled]
    :reviewerIssued [:ReviewPassed :FixRequested :PlanAccepted :PlanRejected]
    :principalResolved [:ClarificationResolved]
    :authorProposals [:PlanProposed :ScriptProposed :FixSubmitted]
    :meaning "A model may propose body content; the corresponding adapter validates source, schema and permitted action before publishing it."
    :acceptance "A reviewer-issued verdict still requires an admitted receipt and exact criteria/artifact binding. No arbitrary sender can complete a task by publishing a familiar event name.")
  :stateMachine (
    :initial :ready
    :states [:ready :planning :planReview :executing :reviewing :fixing :waiting :effectUnknown :complete :blocked :cancelled]
    :transitions [
      (:transition :from :ready :on TaskReady :to :planning :command "Assign a planner or select an already accepted procedure.")
      (:transition :from :planning :on PlanProposed :to :planReview :command "Request independent acceptance for the plan and criteria.")
      (:transition :from :planReview :on PlanAccepted :to :executing :command "Claim ownership and dispatch the accepted work.")
      (:transition :from :executing :on ScriptProposed :to :executing :command "Validate the immutable script and dispatch RunRequested without a model.")
      (:transition :from :executing :on ScriptRejected :to :fixing :command "Return admission findings without claiming execution occurred.")
      (:transition :from :executing :on RunFinished :to :reviewing :when :executionOutcomeKnown :command "Bind output to task/artifact and request review.")
      (:transition :from :executing :on RunFinished :to :effectUnknown :when :externalEffectUncertain :command "Reconcile the effect before considering a retry.")
      (:transition :from :reviewing :on FixRequested :to :fixing :command "Dispatch only open findings and their evidence.")
      (:transition :from :fixing :on FixSubmitted :to :executing :command "Validate new revision and rerun applicable checks.")
      (:transition :from :reviewing :on ReviewPassed :to :complete :when :admittedAcceptanceCoversCriteria :command "Persist TaskCompleted with artifact and criteria digests.")]
    :globalTransitions [
      (:transition :from [:ready :planning :planReview :executing :reviewing :fixing :waiting :effectUnknown] :on TaskCancelled :to :cancelled :command "Cancel queued work and fence stale workers; preserve any uncertain effect for reconciliation.")
      (:transition :from [:ready :planning :planReview :executing :reviewing :fixing :waiting :effectUnknown] :on BudgetExhausted :to :blocked :command "Persist remaining work and resumption condition.")
      (:transition :from [:planning :planReview :executing :reviewing :fixing] :on ClarificationRequested :to :waiting :command "Store continuation state and ask the responsible principal once.")
      (:transition :from :waiting :on ClarificationResolved :to :storedContinuation :command "Apply revised task version and invalidate affected downstream work.")
      (:transition :from :effectUnknown :on EffectReconciled :to :storedContinuation :command "Continue from observed effect; do not duplicate it.")
      (:transition :from :planReview :on PlanRejected :to :planning :command "Return scoped findings while consuming the same finite task budget.")]
    :acceptanceGuards [:authenticatedSource :expectedRevision :currentTaskVersion :currentArtifactDigest :validLease :remainingBudget :criteriaCoverage]
    :terminals "Complete, blocked and cancelled are distinct. Waiting/effectUnknown retain a deadline and cannot silently become successful. Terminal tasks require an explicit new attempt to resume."
    :unknown "Unlisted or inapplicable transitions return a typed error; they do not silently mutate state."
    :aslSignature "Transition(TaskState, Event, Policy) -> Result TransitionDecision TransitionError"
    :signatureStatus "Conceptual signature, not an implemented function in this package.")
  :deliveryContract (
    :durability "Commit task revision and outgoing commands in one authoritative transaction or equivalent durable outbox protocol."
    :inbox "Record admitted message IDs with the resulting state revision. A redelivered event returns its prior result or explicit duplicate acknowledgement."
    :delivery "At-least-once redelivery is acceptable; processing and effects require separate idempotency contracts."
    :ack "Acknowledgement means durable acceptance of the message. RunFinished means execution ended. ReviewPassed means the reviewed outcome was accepted."
    :ordering "Per-task expected revisions and causal references reject stale work; no global total order is required."
    :claim "Lease ownership uses atomic compare-and-swap at the authoritative store, with a monotonic fencing token checked before committing effects."
    :expiry "A lease timeout makes reassignment possible but does not prove the previous process stopped."
    :externalEffects "Use idempotency keys where supported. A crash between effect and receipt enters effectUnknown and requires observation or compensation rather than blind retry."
    :limits "This contract does not promise exactly-once external effects. An in-memory state transformer alone does not implement atomic persistence.")
  :scriptContract (
    :language :asl
    :manifest [:sourceDigest :runtimeVersion :entrypoint :imports :inputSchema :outputSchema :capabilities :ownedPaths :timeBudget :memoryBudget]
    :authoring "An agent may create or revise a script artifact for repeated operations within its assignment. Source changes create a new digest and invalidate previous admission."
    :admission "Parse and check against the declared ASL profile; resolve imports; verify permissions, ownership and effect budget; bind the exact artifact revision before dispatch."
    :execution "The runner executes the admitted script directly. Each loop iteration or tool call does not require an LLM decision."
    :constraints "The script receives explicit inputs and capabilities; it cannot modify its own acceptance criteria, lease authority or verification provenance."
    :limits "Static checks cannot prove termination of arbitrary programs. Runtime deadlines, cancellation and resource bounds remain necessary."
    :results "The runner records actual output, errors, exit and resource status. Script text declaring success is not an execution receipt."
    :failure "Unknown symbol, unsupported effect or invalid input produces a typed failure; a timeout is distinct from a failed assertion and from an uncertain external effect."
    :reuse "Cache admission for an unchanged digest/runtime/profile/grant; invalidate it when any of those inputs changes.")
  :discussionControl (
    :unit "A finding has a stable ID, criterion, affected artifact revision, evidence, requested change and status."
    :responses [:resolved :unresolved :contested :needsEvidence]
    :progress "A review round closes a finding, supplies material new evidence, changes the artifact, or identifies a different necessary action."
    :noProgress "Repeated claims about the same finding and revision without new evidence trigger a different method or Blocked; renaming a finding does not reset the task budget."
    :budgets "Attempts, elapsed time, tokens and effect budgets belong to the task and survive handoffs, retries and role changes. Their values are task policies, not universal constants."
    :dispute "One designated adjudication route resolves a contested criterion or requests user clarification when intent is decisive. Additional reviewers are assigned only for distinct evidence or expertise."
    :basicModels "Give one bounded assignment, an explicit response schema, a small relevant context and a deterministic next transition. Validate outputs and escalate unsupported cases instead of broad free-form negotiation."
    :limit "Finite budgets guarantee a bounded protocol outcome, not successful completion or adequate competence of every small model.")
  :contextIntegration (
    :sharedRecords [:taskVersion :artifactDigest :contextRevision :blockRefs :receiptRef]
    :contextRequests "A role requests missing evidence from ContextEngine; ready independent work can continue while retrieval is pending."
    :handoff "Messages carry references and current findings, not entire histories. The receiver's context manager checks access, freshness and dependency coverage."
    :invalidations "A changed criterion or refuted premise invalidates dependent tasks and context projections through an explicit event."
    :singleAuthority "The context manager prepares evidence; it cannot complete tasks. The coordinator changes task state; it cannot fabricate evidence. The runner reports effects; it cannot accept its own work.")
  :plannedTests [
    (:test :id DuplicateDelivery :expect "Duplicate messageId cannot apply the same task transition twice.")
    (:test :id CrashAfterEffect :expect "A crash before receipt persistence yields effectUnknown, without blind effect repetition.")
    (:test :id StaleLease :expect "An expired or replaced fencing token cannot commit a late worker's mutation.")
    (:test :id StaleReview :expect "Acceptance of an old artifact/criteria digest cannot complete the new revision.")
    (:test :id ScriptDigestBinding :expect "Changed script bytes require new validation before execution.")
    (:test :id ForgedCompletion :expect "A model-authored RunFinished or TaskCompleted is rejected at the authority boundary.")
    (:test :id ReviewLoopBound :expect "Repeated unchanged findings eventually produce Blocked with preserved evidence.")
    (:test :id CancellationFence :expect "Cancelled work cannot commit after the task's authority revision changes.")
    (:test :id ModelFreeAutomation :expect "Executing an admitted script and routing its result consumes zero model calls.")
    (:test :id SmallModelProtocol :expect "Measure schema errors, task success, retries and cost under bounded role contexts; do not assume competence from message validity.")]
  :testStatus :plannedNotRun)
