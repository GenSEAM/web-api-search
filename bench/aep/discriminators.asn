;; AgentScript Autonomous Epistemic Pipeline (AEP)
;; 12-Discriminator Calibration Dataset (Terminal-Bench 4.0)
;; Conforms to Phase 259 Specification & Epistemic Calibration Standard

(:discriminator-suite
  :version "4.0"
  :name "terminal-bench-4.0-discriminators"
  :description "12 hard discriminator tasks separating naive execution from epistemic reflection"
  :tasks [
    (:task
      :task-id "pytorch-model-cli"
      :category "CLI / ML"
      :failure-mode "Argument parsing flag drift and silent default flag inversion"
      :resolution-stage "s2-reformulate, s3-intent-gate"
      :resolution-mechanism "Stage 2 reformulation extracts explicit CLI flag contract; Stage 3 Intent Gate validates parity against prompt."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "log-summary-date-ranges"
      :category "Data / Parsing"
      :failure-mode "Date interval boundary and timezone mismatch across daylight savings boundary"
      :resolution-stage "s3-intent-gate"
      :resolution-mechanism "Stage 3 Intent Gate enforces timezone-aware datetime normalization and boundary predicate verification."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "merge-diff-arc-agi-task"
      :category "Logic / Matrix"
      :failure-mode "Multi-step array mutation regression and intermediate state clobbering"
      :resolution-stage "s4-plan, s5-plan-gate"
      :resolution-mechanism "Stage 4 DAG topological planning isolates cell mutation buffers; Stage 5 pre-mortem audits invariant preservation."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "break-filter-js-from-html"
      :category "Security / XSS"
      :failure-mode "Naive regex bypass in nested script tags and attribute event vectors"
      :resolution-stage "s5-plan-gate"
      :resolution-mechanism "Stage 5 pre-mortem security audit rejects string substitution heuristics and mandates full AST parsing."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "reshard-c4-data"
      :category "Stream / BigData"
      :failure-mode "Out-of-memory crash on monolithic multi-gigabyte JSONL loading"
      :resolution-stage "s5-plan-gate"
      :resolution-mechanism "Stage 5 pre-mortem resource audit detects unbounded RAM allocation and enforces chunked streaming buffers."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "winning-avg-corewars"
      :category "Math / Sim"
      :failure-mode "Weighted average formula distortion replacing survival weighting with arithmetic mean"
      :resolution-stage "s2-reformulate, s3-intent-gate"
      :resolution-mechanism "Stage 2 mathematical reformulation binds the exact weighted formula; Stage 3 intent gate audits formula fidelity."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "password-recovery"
      :category "Crypto / Auth"
      :failure-mode "Unbounded brute-force search space explosion without salt analysis"
      :resolution-stage "s4-plan"
      :resolution-mechanism "Stage 4 plan decomposes salt structure, hash format, and character entropy to bound search space."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "regex-chess"
      :category "State / FSM"
      :failure-mode "Hallucinated extended notation and invalid SAN state transitions"
      :resolution-stage "s3-intent-gate"
      :resolution-mechanism "Stage 3 intent gate grounds notation grammar directly against formal FIDE specification rules."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "torch-tensor-parallelism"
      :category "Distributed"
      :failure-mode "Process barrier deadlock on divergent control flow across GPU ranks"
      :resolution-stage "s5-plan-gate, s7-verify"
      :resolution-mechanism "Stage 5 pre-mortem concurrency audit checks barrier alignment; Stage 7 test proof verifies multi-rank execution."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "distribution-search"
      :category "Stats / Search"
      :failure-mode "Mean taken instead of quantiles on skewed heavy-tailed latency distribution"
      :resolution-stage "s2-reformulate"
      :resolution-mechanism "Stage 2 contract strictness enforces exact P95/P99 percentile calculations over summary averages."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "caffe-cifar-10"
      :category "Build / Legacy"
      :failure-mode "Obsolete system header path failure and missing CUDA include directories"
      :resolution-stage "s1-ingest, s4-plan"
      :resolution-mechanism "Stage 1 environment reconnaissance discovers local toolchain paths; Stage 4 plan patches include flags."
      :baseline-pass false
      :reflex-pass true)

    (:task
      :task-id "adaptive-rejection-sampler"
      :category "Math / Sampling"
      :failure-mode "Stochastic convergence failure and proposal envelope underestimation"
      :resolution-stage "s7-verify"
      :resolution-mechanism "Stage 7 post-execution verification executes two-sample Kolmogorov-Smirnov test to verify p-value > 0.05."
      :baseline-pass false
      :reflex-pass true)
  ])
